<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Sistema de Compras y Almacén</ApplicationTitle>
    <AssemblyName>SistemaComprasAlmacen</AssemblyName>
    <RootNamespace>SistemaComprasAlmacen</RootNamespace>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="integracion_erpnext\**\*.cs" />
    <None Remove="integracion_erpnext\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <Target Name="LiberarBinariosEnUso" BeforeTargets="CopyFilesToOutputDirectory">
    <Exec Command="powershell -NoProfile -Command &quot;$out = '$(OutDir)'; Get-ChildItem -Path $out -Filter '*.old*' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; $ts = [DateTime]::UtcNow.Ticks; foreach ($f in @('SistemaComprasAlmacen.dll','SistemaComprasAlmacen.exe')) { if (Test-Path (Join-Path $out $f)) { Move-Item -Force (Join-Path $out $f) (Join-Path $out ($f + '.old_' + $ts)) -ErrorAction SilentlyContinue } }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
