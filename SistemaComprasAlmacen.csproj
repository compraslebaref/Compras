<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Sistema de Compras y Almacén</ApplicationTitle>
    <AssemblyName>SistemaComprasAlmacen</AssemblyName>
    <RootNamespace>SistemaComprasAlmacen</RootNamespace>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <Target Name="LiberarBinariosEnUso" BeforeTargets="CopyFilesToOutputDirectory">
    <Exec Command="powershell -NoProfile -Command &quot;$out = '$(OutDir)'; $obj = '$(IntermediateOutputPath)'; Get-ChildItem -Path $out -Filter '*.old*' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; $ts = [DateTime]::UtcNow.Ticks; if (Test-Path (Join-Path $out 'SistemaComprasAlmacen.dll')) { Move-Item -Force (Join-Path $out 'SistemaComprasAlmacen.dll') (Join-Path $out ('SistemaComprasAlmacen.dll.old_' + $ts)) -ErrorAction SilentlyContinue }; if ((Test-Path (Join-Path $obj 'apphost.exe')) -and -not (Test-Path (Join-Path $out 'SistemaComprasAlmacen.exe'))) { Copy-Item -Force (Join-Path $obj 'apphost.exe') (Join-Path $out 'SistemaComprasAlmacen.exe') -ErrorAction SilentlyContinue }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
