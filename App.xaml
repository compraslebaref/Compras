<Application x:Class="SistemaComprasAlmacen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Visibilidad dinámica de precios e importes según el rol operativo (Compras vs Almacén) -->
            <Visibility x:Key="VisibilidadPreciosPerfil">Visible</Visibility>

            <!-- Colores de selección persistentes incluso al pasar el foco al formulario derecho -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E808080" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#24808080" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextFillColorPrimary}" />

            <!-- Sombra sutil ejecutiva para tarjetas y superficies principales -->
            <DropShadowEffect x:Key="CardElevationShadow"
                              BlurRadius="14"
                              ShadowDepth="2"
                              Direction="270"
                              Color="#0F172A"
                              Opacity="0.06" />

            <!-- Estilo global para Tablas Modernas (DataGrid) -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#2294A3B8" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Estilo global para Encabezados de Columna de Tablas (DataGridColumnHeader) -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="10.8" />
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- Estilo global para filas de tablas (DataGridRow) -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="2,0,0,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsSelected" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </MultiTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Estilo global para celdas de tablas (DataGridCell) -->
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border x:Name="CellBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ComboBoxItem: se usa el estilo nativo Fluent de WPF-UI (sin sobrescritura) -->

            <!-- Virtualización global para listas desplegables (ComboBox) con cientos de productos -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pestañas con indicador subrayado (estilo nativo Windows 11) -->
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,2,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="{TemplateBinding Margin}"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="TabBorder" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="TabBorder" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Celdas de texto: recorte con puntos suspensivos y texto completo en tooltip -->
            <Style x:Key="CeldaRecortableStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Chips de estado en celdas de DataGrid -->
            <Style x:Key="StatusPillBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#E2E8F0" />
                <Setter Property="TextElement.Foreground" Value="#334155" />
                <Setter Property="TextElement.FontWeight" Value="Bold" />
                <Setter Property="TextElement.FontSize" Value="10" />
                <Style.Triggers>
                    <!-- Estados Verdes / Completados / Disponibles -->
                    <DataTrigger Binding="{Binding}" Value="Disponible">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Recibida Completa">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Atendida">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="OC Generada">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Completado">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Devuelto Completo">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="TextElement.Foreground" Value="#166534" />
                    </DataTrigger>

                    <!-- Estados Azules / Emitidos / En Proceso -->
                    <DataTrigger Binding="{Binding}" Value="Emitida">
                        <Setter Property="Background" Value="#DBEAFE" />
                        <Setter Property="TextElement.Foreground" Value="#1E40AF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="En Comparativa">
                        <Setter Property="Background" Value="#DBEAFE" />
                        <Setter Property="TextElement.Foreground" Value="#1E40AF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Cotización Entregada">
                        <Setter Property="Background" Value="#E0E7FF" />
                        <Setter Property="TextElement.Foreground" Value="#3730A3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Pagada / Lista para Almacén">
                        <Setter Property="Background" Value="#DBEAFE" />
                        <Setter Property="TextElement.Foreground" Value="#1E40AF" />
                    </DataTrigger>

                    <!-- Estados Ámbar / Pendientes / Parciales / En Préstamo -->
                    <DataTrigger Binding="{Binding}" Value="Pendiente">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Setter Property="TextElement.Foreground" Value="#92400E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Recibida Parcialmente">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Setter Property="TextElement.Foreground" Value="#92400E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="En Préstamo">
                        <Setter Property="Background" Value="#F3E8FF" />
                        <Setter Property="TextElement.Foreground" Value="#6B21A8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Activo">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Setter Property="TextElement.Foreground" Value="#92400E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="🟠 Alta (≤50%)">
                        <Setter Property="Background" Value="#FFEDD5" />
                        <Setter Property="TextElement.Foreground" Value="#9A3412" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="🟡 Media">
                        <Setter Property="Background" Value="#FEF9C3" />
                        <Setter Property="TextElement.Foreground" Value="#854D0E" />
                    </DataTrigger>

                    <!-- Estados Rojos / Críticos / Cancelados / Dañados -->
                    <DataTrigger Binding="{Binding}" Value="🔴 Crítica (Agotado)">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="TextElement.Foreground" Value="#991B1B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Cancelada">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="TextElement.Foreground" Value="#991B1B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Dañada">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="TextElement.Foreground" Value="#991B1B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Extraviada / Baja">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="TextElement.Foreground" Value="#991B1B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Alta">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="TextElement.Foreground" Value="#991B1B" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
