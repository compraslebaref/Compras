<UserControl x:Class="SistemaComprasAlmacen.NuevaSolicitudCaptura"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="TituloPaso" Text="Datos de la solicitud" FontSize="22" FontWeight="SemiBold" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="BtnContinuar" Content="Siguiente" Appearance="Primary" Click="Continuar_Click" />
            </StackPanel>
            <TextBlock x:Name="TxtError" Foreground="#A4262C" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>
        <ScrollViewer x:Name="AreaCaptura" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,10,0">
                <StackPanel x:Name="PasoDatos">
                    <TextBlock Text="Departamento" />
                    <ComboBox x:Name="CboDepartamento" SelectionChanged="Departamento_SelectionChanged" Margin="0,4,0,12" />
                    <TextBlock Text="Solicitante" />
                    <ComboBox x:Name="CboSolicitante" Margin="0,4,0,12" />
                    <TextBlock Text="Proyecto (opcional)" />
                    <ComboBox x:Name="CboProyecto" Margin="0,4,0,12" />
                    <TextBlock Text="Tipo de solicitud" />
                    <ComboBox x:Name="CboTipo" SelectedIndex="0" Margin="0,4,0,12">
                        <ComboBoxItem Content="Requerimiento de Compra" />
                        <ComboBoxItem Content="Solo Cotización / Presupuesto" />
                    </ComboBox>
                    <TextBlock Text="Notas (opcional)" />
                    <ui:TextBox x:Name="TxtNotas" Margin="0,4,0,10" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" />
                    <CheckBox x:Name="ChkPartidas" Content="Usar partidas para agrupar artículos" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkNotificar" Content="Notificar por correo al gerente" IsChecked="True"
                              Checked="Notificacion_Changed" Unchecked="Notificacion_Changed" Margin="0,0,0,6" />
                    <StackPanel x:Name="PnlTiempo" Orientation="Horizontal">
                        <TextBlock Text="Tiempo aproximado" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CboTiempo" IsEditable="True" Text="12 a 24 hrs" MinWidth="150">
                            <ComboBoxItem Content="4 a 12 hrs (Urgente)" />
                            <ComboBoxItem Content="12 a 24 hrs" />
                            <ComboBoxItem Content="24 a 48 hrs" />
                            <ComboBoxItem Content="1 a 2 días hábiles" />
                            <ComboBoxItem Content="2 a 3 días hábiles" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="PasoArticulos" Visibility="Collapsed">
                    <TextBlock x:Name="TxtResumen" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel x:Name="PnlArticulos" />
                    <ui:Button x:Name="BtnCrearPartida" Content="+ Crear partida" Click="CrearPartida_Click"
                               HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
