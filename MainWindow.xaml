                                            <ui:Button x:Name="BtnEntradaSinOcAlmacen" Content="+ Entrada directa sin OC" FontSize="11.5" VerticalAlignment="Center" ToolTip="Registrar llegada física de material a Almacén cuando aún no existe Orden de Compra emitida (CP-5C)" Click="BtnEntradaSinOcAlmacen_Click" />
                                        </StackPanel>
                                        <TextBlock Text="Órdenes de compra y recepción" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Clic para ver la ficha · Doble clic para abrir la recepción. También puede escanear su folio OC-xxxx." FontSize="12" Opacity="0.72" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <DataGrid x:Name="DgOrdenesCompra"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          RowHeight="38"
                                          SelectionChanged="DgOrdenesCompra_SelectionChanged"
                                          MouseDoubleClick="DgOrdenesCompra_MouseDoubleClick"
                                          KeyDown="DgOrdenesCompra_KeyDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Abrir orden" Click="BtnAbrirOrdenSeleccionada_Click" FontWeight="Bold" />
                                            <MenuItem Header="Abrir Recepción Agrupada de esta OC" Click="BtnAbrirModalRecepcionOc_Click" />
                                            <MenuItem Header="Recibir Todo lo Pendiente de esta OC" Click="BtnRecibirTodoPendienteOc_Click" />
                                            <Separator />
                                            <MenuItem Header="Imprimir Orden de Compra" Click="BtnImprimirOcSeleccionada_Click" />
                                            <MenuItem Header="Descargar Orden de Compra (PDF / PNG / CSV)" Click="BtnDescargarOcSeleccionada_Click" />
                                            <Separator />
                                            <MenuItem Header="Liquidar OC sin Factura (Nota / Remisión)" Click="BtnLiquidarOcSinFactura_Click" />
                                            <MenuItem Header="Forzar Estatus de OC (Administrador)" Click="BtnForzarEstatusOcAdmin_Click" />
                                            <Separator />
                                            <MenuItem Header="Copiar Folio de OC" Click="CtxOrdenCompraCopiarFolio_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="120" FontWeight="SemiBold" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto / Destino" Binding="{Binding ProyectoNombre}" Width="1*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Avance" Binding="{Binding AvanceRecepcionTexto}" Width="105" />
                                        <DataGridTextColumn x:Name="ColOrdenesTotal" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="105" />
                                        <DataGridTemplateColumn Header="Estatus" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding EstatusMostrar}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="⋯" FontSize="14" FontWeight="Bold" Padding="8,0,8,2" Appearance="Transparent" Tag="{Binding}" ToolTip="Opciones de la orden de compra" Click="BtnOpcionesOrdenFila_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Derecha: Ficha de la Orden de Compra seleccionada -->
                        <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel x:Name="PnlFichaOcVacia" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6">
                                    <TextBlock Text="🧾" FontSize="34" HorizontalAlignment="Center" />
                                    <TextBlock Text="Seleccione una orden de compra de la lista para ver su ficha" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="240" />
                                </StackPanel>

                                <DockPanel x:Name="PnlFichaOcContenido" Visibility="Collapsed">
                                    <!-- Encabezado: Folio + estatus -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Border x:Name="BdrFichaOcEstatus" DockPanel.Dock="Right" Style="{StaticResource StatusPillBorderStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtFichaOcFolio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="TxtFichaOcAvance" FontSize="11.5" Opacity="0.75" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Barra de avance de recepción -->
                                    <ProgressBar x:Name="PbFichaOcAvance" DockPanel.Dock="Top" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10" />

                                    <!-- Datos generales -->
                                    <Border DockPanel.Dock="Top" Padding="12,10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="98" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Fecha" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFichaOcFecha" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="1" Text="Proveedor" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFichaOcProveedor" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="2" Text="Proyecto" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFichaOcProyecto" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="3" Text="Solicitante" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtFichaOcSolicitante" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="4" Text="Origen" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtFichaOcOrigen" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="5" Text="Entrega" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtFichaOcEntrega" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="6" Text="Pago" FontSize="11.5" Opacity="0.65" Margin="0,2" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtFichaOcPago" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                        </Grid>
                                    </Border>

                                    <!-- Siguiente paso guiado -->
                                    <Border x:Name="BdrFichaOcSiguientePaso" DockPanel.Dock="Top" Padding="12,9" CornerRadius="6" Margin="0,0,0,10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtFichaOcSiguientePasoTitulo" Text="➜ SIGUIENTE PASO" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                            <TextBlock x:Name="TxtFichaOcSiguientePaso" FontSize="12" TextWrapping="Wrap" Foreground="#1E3A8A" Margin="0,3,0,6" />
                                            <WrapPanel>
                                                <ui:Button x:Name="BtnFichaOcSiguientePaso" FontSize="11.5" Padding="10,4" Margin="0,0,6,4" Click="BtnFichaOcSiguientePaso_Click" />
                                                <ui:Button x:Name="BtnFichaOcEsperando" Content="⏸ Esperando respuesta ▾" FontSize="11" Padding="8,4" Margin="0,0,6,4" ToolTip="Pausar: depende de alguien externo (no cuenta como pendiente nuestro)" Click="BtnFichaOcEsperando_Click" />
                                                <ui:Button x:Name="BtnFichaOcConcluir" Content="✓ Marcar como concluida" FontSize="11" Padding="8,4" Margin="0,0,0,4" ToolTip="Declarar que ya no requiere más pasos; oculta este aviso" Click="BtnFichaOcConcluir_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel x:Name="PnlFichaOcConcluida" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
                                        <ui:Button DockPanel.Dock="Right" Content="Reabrir" FontSize="10.5" Padding="8,2" Appearance="Transparent" ToolTip="Volver a mostrar el siguiente paso" Click="BtnFichaOcReabrir_Click" />
                                        <TextBlock Text="✓ Concluida — no requiere más pasos" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Botón abrir -->
                                    <ui:Button DockPanel.Dock="Bottom"
                                               Content="Abrir / Recibir material"
                                               Icon="{ui:SymbolIcon Open24}"
                                               Appearance="Primary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,10,0,0"
                                               Click="BtnAbrirOrdenSeleccionada_Click" />

                                    <!-- Totales (ocultos en perfil Almacén) -->
                                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                        <TextBlock x:Name="TxtFichaOcTotales" FontSize="11.5" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Partidas -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtFichaOcResumen" DockPanel.Dock="Right" FontSize="11.5" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Materiales de la orden" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataGrid x:Name="DgFichaOcPartidas"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Descripción" Binding="{Binding ProductoNombre}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="2,3" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Pedido" Binding="{Binding CantidadPedida, StringFormat={}{0:0.##}}" Width="58" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="Recibido" Binding="{Binding CantidadRecibida, StringFormat={}{0:0.##}}" Width="64" />
                                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" Width="66" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Border>
                        </Grid>

                        <!-- ===== VISTA 2: DETALLE DE LA ORDEN (con menús internos) ===== -->
                        <Border x:Name="PnlOrdenDetalle" Visibility="Collapsed" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ui:Button x:Name="BtnDespacharSalidaDesdeOcDetalle" Content="Despachar a Salida" FontSize="10.8" Padding="8,3" Margin="0,0,5,0" ToolTip="Cargar artículos de esta Orden de Compra directamente en un Vale de Salida de Almacén" Click="BtnCargarMaterialOcActualEnSalida_Click" />
                                        <ui:Button Content="Imprimir OC" Icon="{ui:SymbolIcon Print24}" FontSize="10.8" Padding="8,3" Margin="0,0,5,0" Visibility="{DynamicResource VisibilidadPreciosPerfil}" Click="BtnImprimirOcSeleccionada_Click" />
                                        <Menu Background="Transparent" VerticalAlignment="Center">
                                            <MenuItem Header="Más acciones" Padding="8,4" FontSize="11" FontWeight="SemiBold">
                                                <MenuItem Header="Descargar Orden de Compra (PDF / PNG / CSV)" Click="BtnDescargarOcSeleccionada_Click" />
                                                <MenuItem Header="Liquidar sin Factura (Nota / Remisión)" Click="BtnLiquidarOcSinFactura_Click" />
                                                <Separator />
                                                <MenuItem Header="Forzar Estatus de OC (Administrador)" Click="BtnForzarEstatusOcAdmin_Click" />
                                            </MenuItem>
                                        </Menu>
                                    </StackPanel>
                                    <ui:Button x:Name="BtnVolverListaOrdenes"
                                               DockPanel.Dock="Left"
                                               Icon="{ui:SymbolIcon ArrowLeft24}"
                                               Content="Órdenes"
                                               FontSize="11.5"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               ToolTip="Volver a la lista de órdenes de compra"
                                               Click="BtnVolverListaOrdenes_Click" />
                                    <TextBlock x:Name="TxtTituloRecepcionOc" Text="Orden de compra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <TabControl Padding="0,8,0,0">

                                    <!-- Menú 1: Recepción de mercancía -->
                                    <TabItem Header="Recepción">
                                        <DockPanel Margin="0,4,0,0">
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Folio remisión / nota:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ui:TextBox x:Name="TxtFolioRemisionRecepcionOc" Grid.Column="1" Margin="0,0,10,0" PlaceholderText="Ej. REM-4502 / Entrega parcial 1 (opcional)" />
                                                <CheckBox x:Name="ChkReservarStockProyectoRecepcion" Grid.Column="2" Content="Reservar para proyecto" IsChecked="False" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Todo el stock entra a bolsa libre de almacén" />
                                            </Grid>

                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Observaciones de esta entrega" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                        <ui:TextBox x:Name="TxtNotasRecepcionOc" PlaceholderText="Ej. Se recibieron 4 piezas hoy sin daños..." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="Lugar de entrega (correo a gerente)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                        <ComboBox x:Name="CboOcLugarEntregaRecepcion" IsEditable="True" Text="Almacén General" ToolTip="Texto para el correo al gerente: 'El folio xxx ya fue concluido con entrega en xxx'">
                                                            <ComboBoxItem Content="Almacén General" />
                                                            <ComboBoxItem Content="Resguardo en Almacén (Listo para entrega)" />
                                                            <ComboBoxItem Content="Directo en Obra / Proyecto" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkOcNotificarRecepcionGerente"
                                                              Grid.Column="2"
                                                              Content="Notificar correo a gerente"
                                                              IsChecked="True"
                                                              FontSize="11.5"
                                                              VerticalAlignment="Bottom"
                                                              Margin="0,0,0,6"
                                                              ToolTip="Envía al gerente: 'El folio xxx ya fue concluido con entrega en xxx'" />
                                                </Grid>
                                                <DockPanel>
                                                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                        <ui:Button Content="Recibir todo lo pendiente" FontSize="11" Padding="8,4" Margin="0,0,6,2" Click="BtnRecibirTodoPendienteOc_Click" />
                                                        <ui:Button Content="Limpiar a 0" FontSize="11" Padding="8,4" Margin="0,0,6,2" Click="BtnLimpiarCantidadesRecepcionOc_Click" />
                                                        <ui:Button Content="Recepción agrupada" FontSize="11" Padding="8,4" Margin="0,0,6,2" ToolTip="Abre la ventana para marcar qué artículos llegaron y asignar su ubicación en almacén" Click="BtnAbrirModalRecepcionOc_Click" />
                                                        <ui:Button Content="Cambiar marca / sustituto" FontSize="11" Padding="8,4" Margin="0,0,6,2" ToolTip="Sustituir el producto de la partida seleccionada por otra marca o equivalente real entregado por el proveedor" Click="BtnSustituirProductoEnRecepcionOc_Click" />
                                                    </WrapPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <ui:Button Content="Recogido / Directo a Obra" FontSize="11" Padding="9,4" Margin="0,0,6,2" ToolTip="Registrar que el material se recogió con el proveedor y se entregó directo en la obra o como servicio (imputa costo al proyecto y cierra la OC sin alterar el stock físico de los anaqueles de Almacén)" Click="BtnRegistrarRecepcionDirectaObraOc_Click" />
                                                        <ui:Button Content="Registrar entrada a almacén" FontSize="11" Padding="9,4" Margin="0,0,0,2" Appearance="Primary" Click="BtnRegistrarRecepcionOc_Click" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>

                                            <DataGrid x:Name="DgPartidasRecepcionOc" AutoGenerateColumns="False" CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="100" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />

                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="U. Compra" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="85" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Factor Conv." Binding="{Binding FactorConversion, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Pedida" Binding="{Binding CantidadPedida}" IsReadOnly="True" Width="80" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recibida" Binding="{Binding CantidadRecibida}" IsReadOnly="True" Width="95" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Pendiente" Binding="{Binding CantidadPendiente}" IsReadOnly="True" Width="100" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recibir Hoy" Binding="{Binding CantidadRecibirAhora, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entra a Stock" Binding="{Binding ResumenConversionAlmacen}" IsReadOnly="True" Width="105" FontWeight="SemiBold" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>

                                    <!-- Menú 2: Estatus operativo y pago -->
                                    <TabItem x:Name="TabOcEstatusPago" Header="Estatus y pago" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                        <StackPanel Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                                            <TextBlock Text="Flujo operativo: Dirección → Finanzas → Almacén" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                                    <TextBlock Text="Estatus operativo" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CboOcEstatusOperativo">
                                                        <ComboBoxItem Content="Pendiente Vo.Bo. Dirección" />
                                                        <ComboBoxItem Content="Autorizada / Pendiente Pago Finanzas" />
                                                        <ComboBoxItem Content="Pagada / Lista para Almacén" />
                                                        <ComboBoxItem Content="Emitida" />
                                                        <ComboBoxItem Content="Recibida Parcialmente" />
                                                        <ComboBoxItem Content="Recibida Completa" />
                                                        <ComboBoxItem Content="Cerrada Parcial (Admin)" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                                    <TextBlock Text="Condición de pago" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CboOcCondicionPago">
                                                        <ComboBoxItem Content="Contado (Transferencia previa)" />
                                                        <ComboBoxItem Content="Crédito 15 días" />
                                                        <ComboBoxItem Content="Crédito 30 días" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Fecha programada / Vo.Bo." FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <DatePicker x:Name="DpOcFechaProgramadaPago" SelectedDateChanged="DpOcFechaProgramadaPago_SelectedDateChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="Tiempo aprox. de entrega al pagar (correo a gerente)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CboOcTiempoAproxPago" IsEditable="True" Text="2 días hábiles" ToolTip="Tiempo relativo que se enviará al gerente: 'La cotización ya fue pagada, tiempo aprox de entrega xxx'">
                                                        <ComboBoxItem Content="Hoy mismo" />
                                                        <ComboBoxItem Content="24 a 48 hrs" />
                                                        <ComboBoxItem Content="1 día hábil" />
                                                        <ComboBoxItem Content="1 a 2 días hábiles" />
                                                        <ComboBoxItem Content="2 a 3 días hábiles" />
                                                        <ComboBoxItem Content="3 a 5 días hábiles" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button HorizontalAlignment="Left"
                                                           Appearance="Primary"
                                                           Content="Guardar flujo"
                                                           ToolTip="Actualiza el estatus operativo, condición de pago y recordatorio en el Calendario Operativo"
                                                           Click="BtnActualizarFlujoOc_Click" />
                                                <CheckBox x:Name="ChkOcNotificarPagoGerente"
                                                          Content="Notificar correo a gerente al marcar como Pagada"
                                                          IsChecked="True"
                                                          FontSize="11.5"
                                                          VerticalAlignment="Center"
                                                          Margin="12,0,8,0" />
                                                <ui:Button Content="Enviar Aviso de Pago Ahora"
                                                           FontSize="11.5"
                                                           Padding="10,5"
                                                           ToolTip="Envía inmediatamente al gerente el correo: 'La cotización ya fue pagada, tiempo aprox de entrega xxx'"
                                                           Click="BtnEnviarAvisoPagoOcManual_Click" />
                                            </WrapPanel>
                                            <ui:Button x:Name="BtnFiniquitarOcParcial" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Finiquitar / Cerrar Parcialmente (Ya no entregarán resto)" ToolTip="Cierra la OC con lo recibido hasta hoy para que deje de aparecer pendiente en Almacén (Checkpoint CP-6)" Click="BtnFiniquitarOcParcial_Click" />
                                        </StackPanel>
                                    </TabItem>

                                    <!-- Menú 3: Entradas registradas -->
                                    <TabItem Header="Entradas registradas">
                                        <DockPanel Margin="0,4,0,0">
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <ui:Button Content="Descargar entrada" Margin="0,0,6,0" ToolTip="Descargar Vale de Entrada como archivo PDF, Imagen PNG o Excel CSV" Click="BtnDescargarEntradaSeleccionada_Click" />
                                                    <ui:Button Content="Imprimir entrada" Icon="{ui:SymbolIcon Print24}" Click="BtnImprimirEntradaSeleccionada_Click" />
                                                </StackPanel>
                                                <CheckBox x:Name="ChkFiltrarEntradasPorOc"
                                                          Content="Mostrar solo entregas de esta orden"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Checked="ChkFiltrarEntradasPorOc_Changed"
                                                          Unchecked="ChkFiltrarEntradasPorOc_Changed" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgEntradasHistorial"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      MouseDoubleClick="DgEntradasHistorial_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="120" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="135" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Remisión / Factura" Binding="{Binding FacturaReferencia}" Width="155" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="180" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding TipoEntrada}" Width="145" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Notas" Binding="{Binding Notas}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>

                                </TabControl>
                            </DockPanel>
                        </Border>

                    </Grid>
                </TabItem>

                <!-- ==================== TAB 5: ALMACÉN (con menús internos) ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Barra de Búsqueda y Escaneo de Almacén -->
                        <Border Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="BarcodeScanner24"
                                               FontSize="20"
                                               Margin="4,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                                <ui:TextBox x:Name="TxtBuscarAlmacen"
                                            Grid.Column="1"
                                            PlaceholderText="Buscar o escanear: producto, SOL-, OC-, ENT-, SAL-, HER- o PRE-"
                                            VerticalContentAlignment="Center"
                                            FontSize="13"
                                            PreviewKeyDown="TxtBuscarAlmacen_KeyDown"
                                            TextChanged="TxtBuscarAlmacen_TextChanged" />

                                <ui:Button Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Search24}"
                                           Content="Buscar / Agregar"
                                           Click="BtnBuscarAlmacen_Click" />

                                <ui:Button Grid.Column="3"
                                           Margin="6,0,0,0"
                                           Content="Limpiar Filtro"
                                           Click="BtnLimpiarBusquedaAlmacen_Click" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                                    <ui:Button Content="Exportar Existencias (CSV)"
                                               ToolTip="Descargar archivo CSV únicamente con los artículos que tienen existencia mayor a 0 en Almacén"
                                               Click="BtnExportarExistenciasCatalogo_Click" />
                                    <Menu Background="{DynamicResource ControlFillColorDefaultBrush}"
                                          BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                          BorderThickness="1"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0">
                                        <MenuItem Header="Herramientas ▾" Padding="10,6" FontSize="11.5" FontWeight="SemiBold">
                                            <MenuItem Header="Reingresar Sobrante de Obra a Stock (SOB)" Click="BtnReingresoSobranteObra_Click" />
                                            <MenuItem Header="Ajuste Físico / Merma de Inventario (AJU)" Click="BtnAjusteInventarioMerma_Click" />
                                            <Separator />
                                            <MenuItem Header="Garantías y TCO de Herramientas (HER)" Click="BtnAbrirGarantiasEquipos_Click" />
                                            <MenuItem Header="Auditoría de Consumo y Resguardo por Cuadrilla" Click="BtnAbrirAuditoriaCuadrillas_Click" />
                                        </MenuItem>
                                    </Menu>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" Padding="0,8,0,0">
                            <!-- ===== ENTRADA DE MATERIAL (ligada a la Orden de Compra) ===== -->
                            <TabItem Header="Entrada de material">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="430" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Izquierda: OCs que esperan material -->
                                    <Border Grid.Column="0" Margin="0,0,12,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Content="+ Entrada sin OC" FontSize="11" Padding="8,4" Margin="0,0,6,0" ToolTip="Material que llegó sin Orden de Compra emitida (CP-5C)" Click="BtnEntradaSinOcAlmacen_Click" />
                                                    <ui:Button Content="+ Sobrante de obra" FontSize="11" Padding="8,4" ToolTip="Reingresar a stock material sobrante de un proyecto" Click="BtnReingresoSobranteObra_Click" />
                                                </StackPanel>
                                                <TextBlock Text="Entrada de Material" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Órdenes de compra que esperan material. Seleccione la OC del proveedor que llegó y registre lo que se recibió." FontSize="12" Opacity="0.72" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <CheckBox x:Name="ChkEntradaMostrarTodas" DockPanel.Dock="Right" Content="Mostrar también recibidas" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkEntradaMostrarTodas_Changed" Unchecked="ChkEntradaMostrarTodas_Changed" />
                                                <ui:TextBox x:Name="TxtEntradaBuscarOc" PlaceholderText="Buscar o escanear OC-xxxx, proveedor o proyecto..." VerticalContentAlignment="Center" TextChanged="TxtEntradaBuscarOc_TextChanged" PreviewKeyDown="TxtEntradaBuscarOc_PreviewKeyDown" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgEntradaOcsPendientes"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      RowHeight="36"
                                                      SelectionChanged="DgEntradaOcsPendientes_SelectionChanged"
                                                      MouseDoubleClick="DgEntradaOcsPendientes_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="OC" Binding="{Binding Folio}" Width="115" FontWeight="SemiBold" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto / Destino" Binding="{Binding ProyectoNombre}" Width="1*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Avance" Binding="{Binding AvanceRecepcionTexto}" Width="105" />
                                                    <DataGridTemplateColumn Header="Estatus" Width="160">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding EstatusMostrar}" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <!-- Derecha: lo que falta por llegar de la OC y sus entradas anteriores -->
                                    <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel x:Name="PnlEntradaOcVacia" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6">
                                                <TextBlock Text="📦" FontSize="34" HorizontalAlignment="Center" />
                                                <TextBlock Text="Seleccione la orden de compra del material que llegó" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="240" />
                                            </StackPanel>
                                            <DockPanel x:Name="PnlEntradaOcContenido" Visibility="Collapsed">
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <TextBlock x:Name="TxtEntradaOcFolio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="TxtEntradaOcInfo" FontSize="11.5" Opacity="0.78" TextWrapping="Wrap" Margin="0,2,0,6" />
                                                    <ProgressBar x:Name="PbEntradaOcAvance" Height="6" Minimum="0" Maximum="100" />
                                                </StackPanel>

                                                <ui:Button x:Name="BtnEntradaRegistrarOc"
                                                           DockPanel.Dock="Bottom"
                                                           Content="📥 Registrar entrada de esta OC"
                                                           Appearance="Primary"
                                                           HorizontalAlignment="Stretch"
                                                           Margin="0,10,0,0"
                                                           ToolTip="Abre la recepción: indique qué y cuánto llegó, folio de remisión y ubicación. Se genera el vale ENT-xxxx ligado a esta OC y se suma al inventario."
                                                           Click="BtnEntradaRegistrarOc_Click" />

                                                <!-- Entradas anteriores de esta OC -->
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                                    <TextBlock Text="Entradas ya registradas de esta OC" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,4" />
                                                    <DataGrid x:Name="DgEntradaOcHistorial" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="130" MouseDoubleClick="DgEntradaOcHistorial_MouseDoubleClick">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Vale" Binding="{Binding Folio}" Width="115" FontWeight="SemiBold" />
                                                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*" />
                                                            <DataGridTextColumn Header="Remisión / Factura" Binding="{Binding FacturaReferencia}" Width="*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock x:Name="TxtEntradaOcSinHistorial" Text="Aún no se ha recibido nada de esta OC." FontSize="11.5" Opacity="0.65" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <TextBlock DockPanel.Dock="Top" Text="Materiales de la OC" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
                                                <DataGrid x:Name="DgEntradaOcPartidas" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Descripción" Binding="{Binding ProductoNombre}" Width="*">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                                    <Setter Property="Margin" Value="2,3" />
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Pedido" Binding="{Binding CantidadPedida, StringFormat={}{0:0.##}}" Width="55" />
                                                        <DataGridTextColumn Header="Recibido" Binding="{Binding CantidadRecibida, StringFormat={}{0:0.##}}" Width="62" />
                                                        <DataGridTextColumn Header="Falta" Binding="{Binding CantidadPendiente, StringFormat={}{0:0.##}}" Width="50" FontWeight="Bold" />
                                                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" Width="62" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Salida de material">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel Margin="0,0,0,8">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Content="Cargar de OC Recibida"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       ToolTip="Cargar automáticamente los artículos recibidos de una Orden de Compra para darles salida"
                                                       Click="BtnCargarMaterialOcRecibidaEnSalida_Click" />
                                            <ui:Button DockPanel.Dock="Right" Content="Cargar desde Solicitud (SOL)" FontSize="11" Margin="8,0,0,0" ToolTip="Seleccionar una Solicitud (SOL-xxxx) para precargar sus artículos en este Vale de Salida" Click="BtnCargarMaterialSolicitudEnSalida_Click" />
                                            <TextBlock Text="Salida de Material" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Gerencia que Autoriza *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalDepartamento" SelectionChanged="CboSalDepartamento_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="Técnico / Empleado que Recibe *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalEncargado" IsEditable="True" PreviewKeyDown="CboSalEncargado_PreviewKeyDown" ToolTip="Seleccione del directorio o escriba libremente el nombre de quien recibe" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Proyecto / Destino (Opcional)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalProyecto" SelectionChanged="CboSalProyecto_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Padding="8" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock x:Name="TxtContadorFiltroProductoSal" DockPanel.Dock="Right" Margin="8,0,0,0" Text="" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                                    <TextBlock Text="Buscar Artículo o Escanear con Pistola" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ui:TextBox x:Name="TxtSalBuscarProductoPos"
                                                            Margin="0,0,0,6"
                                                            PlaceholderText="Escriba nombre, código, marca o escanee código de barras (Enter agrega directo)..."
                                                            VerticalContentAlignment="Center"
                                                            TextChanged="TxtSalBuscarProductoPos_TextChanged"
                                                            PreviewKeyDown="TxtSalBuscarProductoPos_KeyDown" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="85" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="CboSalProductoPos"
                                                              Grid.Column="0"
                                                              Margin="0,0,6,0"
                                                              PreviewKeyDown="CboSalProductoPos_PreviewKeyDown" />
                                                    <ui:TextBox x:Name="TxtSalCantidadPos"
                                                                Grid.Column="1"
                                                                PlaceholderText="Cant. (1)"
                                                                Margin="0,0,6,0"
                                                                VerticalContentAlignment="Center"
                                                                PreviewKeyDown="TxtSalCantidadPos_KeyDown" />
                                                    <ui:Button Grid.Column="2" Appearance="Primary" Content="+ Agregar" Click="BtnAgregarPartidaSalidaPos_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <TextBlock Text="Observaciones de Salida" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtSalNotas" Margin="0,0,0,8" PlaceholderText="Ej. Entrega para instalación eléctrica en planta..." />
                                        <UniformGrid Columns="2">
                                            <ui:Button Content="Limpiar" Margin="0,0,6,0" Click="BtnLimpiarSalidaPos_Click" />
                                            <ui:Button Content="Registrar Salida" Appearance="Primary" Click="BtnRegistrarSalidaAlmacen_Click" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <DataGrid x:Name="DgPartidasSalidaPos" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="85" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Material" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cantidad" Binding="{Binding CantidadEntregada}" Width="90" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding UnidadAlmacen}" IsReadOnly="True" Width="75" />
                                            <DataGridTemplateColumn Header="Acciones" Width="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="-" Padding="6,1" Margin="0,0,3,0" Click="BtnDisminuirPartidaSalidaPos_Click" ToolTip="Disminuir 1" />
                                                            <Button Content="+" Padding="6,1" Margin="0,0,3,0" Click="BtnAumentarPartidaSalidaPos_Click" ToolTip="Aumentar 1" />
                                                            <Button Content="✕" Padding="6,1" Foreground="#DC2626" Click="BtnQuitarPartidaSalidaPos_Click" ToolTip="Quitar de la salida" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            </TabItem>
                            <TabItem Header="Préstamo de herramientas">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Content="+ Cargar Maletín (KIT)"
                                                           FontSize="11"
                                                           Padding="8,4"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Cargar en 1 clic todas las herramientas disponibles de un Maletín / Kit (KIT-xxxx) a la lista de préstamo actual o despacharlo directo"
                                                           Click="BtnCargarKitEnPrestamoActual_Click" />
                                                <ui:Button Content="Check-list Regreso de Kit"
                                                           FontSize="11"
                                                           Padding="8,4"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Abrir el check-list visual rápido para revisar qué herramientas regresaron en un maletín y cuáles se quedan en obra o tienen daño"
                                                           Click="BtnChecklistRegresoKitRapido_Click" />
                                                <ui:Button Content="Maletines / Kits (KIT)"
                                                           FontSize="11"
                                                           Padding="8,4"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Administrar la composición de maletines por cuadrilla (KIT-0001, KIT-0002...), despachar o revisar regresos"
                                                           Click="BtnAbrirGestorKitsHerramientas_Click" />
                                                <ui:Button Content="Nueva Herramienta"
                                                           FontSize="11"
                                                           Padding="8,4"
                                                           Click="BtnNuevaHerramientaIndividual_Click" />
                                            </StackPanel>
                                            <TextBlock Text="Préstamo de Herramienta y Maletines" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="125" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Depto. que Aprueba *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPreDepartamento" SelectionChanged="CboPreDepartamento_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="Persona que Recibe (Abierto) *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPrePersonaRecibe" IsEditable="True" ToolTip="Seleccione del directorio o escriba el nombre abierto de quien recibe la herramienta" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                <TextBlock Text="Proyecto Destino" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPreProyecto" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                <TextBlock Text="Fecha Compromiso" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <DatePicker x:Name="DpPreFechaCompromiso" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CboHerramientaDisponible"
                                                      Grid.Column="0"
                                                      Margin="0,0,6,0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      PreviewKeyDown="CboHerramientaDisponible_PreviewKeyDown"
                                                      ToolTip="Seleccione una herramienta disponible y presione '+ Agregar a Lista' para incluir varias en un mismo vale PRE-xxxx" />
                                            <ui:Button Grid.Column="1"
                                                       Content="+ Agregar a Lista"
                                                       Margin="0,0,6,0"
                                                       ToolTip="Agregar esta herramienta a la lista actual para prestar varias en un solo Vale PRE-xxxx"
                                                       Click="BtnAgregarHerramientaAPrestamo_Click" />
                                            <ui:Button x:Name="BtnRegistrarPrestamoHer"
                                                       Grid.Column="2"
                                                       Appearance="Primary"
                                                       Content="Registrar Préstamo"
                                                       ToolTip="Emitir un único Vale de Préstamo (PRE-xxxx) con todas las herramientas de la lista"
                                                       Click="BtnPrestarHerramienta_Click" />
                                        </Grid>

                                        <!-- Lista de herramientas acumuladas para un mismo préstamo PRE-xxxx -->
                                        <Border x:Name="BdrListaHerramientasPorPrestar"
                                                Visibility="Collapsed"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Vaciar lista"
                                                            FontSize="10.5"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            Click="BtnLimpiarListaPrestamo_Click" />
                                                    <TextBlock x:Name="TxtResumenListaPrestamoHer"
                                                               Text="Lista para prestar en un solo vale (0 herramientas):"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ItemsControl x:Name="IcHerramientasPorPrestar">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White"
                                                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="7,3"
                                                                    Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CodigoIndividual}"
                                                                               FontFamily="Consolas"
                                                                               FontWeight="Bold"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding ProductoNombre}"
                                                                               FontSize="11"
                                                                               MaxWidth="185"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding ProductoNombre}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0" />
                                                                    <Button Content="✕"
                                                                            FontSize="10"
                                                                            Padding="4,0"
                                                                            Foreground="#DC2626"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip="Quitar de la lista"
                                                                            Tag="{Binding}"
                                                                            Click="BtnQuitarHerramientaDePrestamo_Click" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Devolución -->
                                    <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="4" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Devolución de Herramienta (Completa, Parcial o con Incidencia)" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CboEstadoRetornoHerramienta" Grid.Column="0" SelectedIndex="0" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="Bueno (Completo)" />
                                                    <ComboBoxItem Content="Incompleto / Falta Pieza" />
                                                    <ComboBoxItem Content="Dañado" />
                                                    <ComboBoxItem Content="Extraviado" />
                                                </ComboBox>
                                                <ui:TextBox x:Name="TxtObsRetornoHerramienta" Grid.Column="1" Margin="0,0,6,0" PlaceholderText="Observaciones al devolver (ej. faltó accesorio, se devuelve 1 de 2)..." />
                                                <ui:Button Grid.Column="2" Content="Registrar Devolución" Appearance="Primary" Margin="0,0,6,0" Click="BtnRegistrarDevolucionHerramienta_Click" />
                                                <ui:Button Grid.Column="3" Content="Imprimir Vale" Click="BtnReimprimirValePrestamo_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid x:Name="DgPrestamosHerramientas"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              MouseDoubleClick="DgPrestamosHerramientas_MouseDoubleClick">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <StackPanel Margin="0,0,0,4">
                                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="8,5"
                                                                                Margin="0,2,0,1"
                                                                                Cursor="Hand"
                                                                                Tag="{Binding Name}"
                                                                                ToolTip="Clic para abrir devolución agrupada de este vale (seleccione qué sí y qué no llegó)"
                                                                                MouseLeftButtonUp="HeaderGrupoPrestamo_MouseLeftButtonUp">
                                                                            <DockPanel>
                                                                                <Button DockPanel.Dock="Right"
                                                                                        Content="Devolver / Revisar Vale"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold"
                                                                                        Padding="8,2"
                                                                                        Margin="8,0,0,0"
                                                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                                        Foreground="White"
                                                                                        BorderThickness="0"
                                                                                        Cursor="Hand"
                                                                                        Tag="{Binding Name}"
                                                                                        Click="BtnAbrirDevolucionGrupoPrestamo_Click" />
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="11.5"
                                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <ItemsPresenter />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Abrir Devolución Agrupada del Vale (PRE-xxxx)" Click="BtnRegistrarDevolucionHerramienta_Click" FontWeight="Bold" />
                                                <MenuItem Header="Imprimir Hoja de Resguardo (PRE-xxxx)" Click="BtnReimprimirValePrestamo_Click" />
                                                <MenuItem Header="Descargar Hoja de Resguardo (PDF / PNG / CSV)" Click="BtnDescargarValePrestamo_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding FolioVale}" Width="90" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding CodigoIndividual}" Width="78" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Herramienta" Binding="{Binding HerramientaDescripcion}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Depto. Aprueba" Binding="{Binding DepartamentoNombre}" Width="125" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Quien Recibe" Binding="{Binding EncargadoNombre}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha Promesa" Binding="{Binding FechaPromesa}" Width="120" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estado" Binding="{Binding EstadoDevolucion}" Width="88" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            </TabItem>
                            <TabItem Header="Historial de movimientos">
                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <ui:Button Content="+ Sobrante de Obra"
                                                   FontSize="11"
                                                   Padding="8,4"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Reingresar material sobrante de un proyecto directamente a anaquel (A–F) sumando a existencias sin requerir un Vale de Salida previo"
                                                   Click="BtnReingresoSobranteObra_Click" />
                                        <ui:Button Content="Ajuste / Merma (AJU)"
                                                   FontSize="11"
                                                   Padding="8,4"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Ajustar existencias por conteo físico real o baja por daño/merma sin simular salidas falsas a obra"
                                                   Click="BtnAjusteInventarioMerma_Click" />
                                        <ui:Button Content="Exportar Existencias (CSV)"
                                                   FontSize="11"
                                                   Padding="8,4"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Descargar archivo CSV únicamente con los artículos que tienen existencia mayor a 0 en Almacén"
                                                   Click="BtnExportarExistenciasCatalogo_Click" />
                                        <ui:Button Content="Devolver Material Sobrante"
                                                   FontSize="11"
                                                   Padding="8,4"
                                                   Appearance="Primary"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Abrir ventana de devolución agrupada de material para indicar qué regresó y cuánto"
                                                   Click="BtnDevolverMaterialSalida_Click" />
                                        <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <MenuItem Header="Opciones del Vale" Padding="10,5" FontWeight="SemiBold">
                                                <MenuItem Header="Descargar Vale (PDF / PNG / CSV)" Click="BtnDescargarMovimientoAlmacen_Click" />
                                                <MenuItem Header="Devolver Material Sobrante de Salida" Click="BtnDevolverMaterialSalida_Click" />
                                                <MenuItem Header="Reingresar Sobrante de Obra a Stock (Sin Vale Previo)" Click="BtnReingresoSobranteObra_Click" />
                                                <MenuItem Header="Ajuste Físico de Inventario / Merma (AJU)" Click="BtnAjusteInventarioMerma_Click" />
                                                <MenuItem Header="Generar Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                                            </MenuItem>
                                        </Menu>
                                        <ui:Button Content="Ver / Imprimir Vale" Icon="{ui:SymbolIcon Print24}" Click="BtnImprimirMovimientoAlmacen_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Historial de Entradas, Salidas y Devoluciones de Almacén" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataGrid x:Name="DgMovimientosAlmacen"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MouseDoubleClick="DgMovimientosAlmacen_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ver / Imprimir Vale" Click="BtnImprimirMovimientoAlmacen_Click" FontWeight="Bold" />
                                            <MenuItem Header="Descargar Vale (PDF / PNG / CSV)" Click="BtnDescargarMovimientoAlmacen_Click" />
                                            <Separator />
                                            <MenuItem Header="Registrar Devolución de Material Sobrante" Click="BtnDevolverMaterialSalida_Click" />
                                            <MenuItem Header="Generar Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="125" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding TipoMovimiento}" Width="95" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="125" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Responsable / Proveedor" Binding="{Binding ResponsableOProveedor}" Width="210" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="220" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Detalle / Notas" Binding="{Binding DetalleResumen}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 6: FACTURAS Y COMPRAS SIN FACTURA ==================== -->
                <TabItem>
                    <Grid>
                        <TabControl Padding="0,6,0,0">
                            <!-- SUB-TAB 0: COMPROBANTES REGISTRADOS (vista inicial) -->
                            <TabItem Header="Comprobantes registrados">
                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right"
                                               Content="Eliminar Comprobante (Admin)"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Margin="8,0,0,0"
                                               ToolTip="Eliminar la factura o nota seleccionada del sistema (Requiere PIN Administrador)"
                                               Click="BtnEliminarFacturaXml_Click" />
                                    <TextBlock Text="Comprobantes Registrados (Facturas XML y Notas sin Factura)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataGrid x:Name="DgFacturasRegistradas" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgFacturasRegistradas_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding TipoComprobante}" Width="120" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="UUID / Referencia" Binding="{Binding Uuid}" Width="185" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding SerieFolio}" Width="95" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding FechaTimbrado}" Width="125" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="RFC" Binding="{Binding EmisorRfc}" Width="110" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding EmisorNombre}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="135" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="145" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="90" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="IVA" Binding="{Binding Iva, StringFormat={}{0:C2}}" Width="80" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                            </TabItem>

                            <!-- SUB-TAB 1: FACTURA XML CFDI 4.0 -->
                            <TabItem Header="Cargar Factura XML (CFDI 4.0)">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Barra Superior XML -->
                                    <Border Grid.Row="0" Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <ui:Button Margin="0,0,8,0" Content="Subir XML" Click="BtnSubirArchivoXml_Click" />
                                                    <ui:Button Appearance="Primary" Content="Guardar Factura" Click="BtnGuardarFacturaXml_Click" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Facturas XML CFDI" FontSize="15.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtXmlResumenActual" Text="Seleccione un archivo XML para cargar sus conceptos." FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Proyecto Destino" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboXmlProyecto" SelectionChanged="CboXmlProyecto_SelectionChanged" ToolTip="Proyecto al que se asigna la compra (por defecto Stock General)" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                    <TextBlock Text="Orden de Compra (Emitida o Recibida)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboXmlOrdenCompra" SelectionChanged="CboXmlOrdenCompra_SelectionChanged" ToolTip="Asociar a una OC existente del proveedor (incluso si ya fue recibida con remisión) o crear una nueva automáticamente" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                    <CheckBox x:Name="ChkXmlIngresarAlmacenAuto"
                                                              Content="Ingresar a Almacén al Guardar"
                                                              Margin="0,0,12,0"
                                                              ToolTip="Si se marca y la mercancía aún no se ha recibido, registra automáticamente su entrada a Almacén al guardar el XML" />
                                                    <CheckBox x:Name="ChkXmlDirectoAObra"
                                                              Content="Consumido Directo en Obra"
                                                              ToolTip="Para compras urgentes de mostrador o recolecciones entregadas directo a obra: imputa el costo al proyecto y cierra la orden sin sumar existencias falsas a los anaqueles de Almacén" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Imputar a Camioneta (Taller / Gasolina):" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="CboXmlVehiculoFlotilla" Grid.Column="1" Margin="0,0,6,0" ToolTip="Si esta factura XML es de gasolina, taller o refacciones de una camioneta (VEH-xxxx), selecciónela para registrar el gasto y actualizar su Costo por Kilómetro automáticamente" />
                                                <ComboBox x:Name="CboXmlTipoGastoVehiculo" Grid.Column="2" Margin="0,0,6,0" SelectedIndex="0" ToolTip="Categoría del gasto vehicular">
                                                    <ComboBoxItem Content="Gasolina / Combustible" />
                                                    <ComboBoxItem Content="Mantenimiento Preventivo" />
                                                    <ComboBoxItem Content="Reparación / Taller" />
                                                    <ComboBoxItem Content="Llantas / Refacciones" />
                                                    <ComboBoxItem Content="Seguro / Peajes" />
                                                </ComboBox>
                                                <ui:TextBox x:Name="TxtXmlKilometrajeVehiculo" Grid.Column="3" PlaceholderText="Odómetro (km)" Margin="0,0,6,0" ToolTip="Kilometraje actual de la camioneta al momento de esta factura (opcional)" />
                                                <ui:Button Grid.Column="4" Content="Flotilla / CPK" FontSize="11" Padding="8,4" Click="BtnAbrirFlotillaYGarantias_Click" ToolTip="Abrir bitácora de camionetas (VEH-xxxx), Costo por Kilómetro (CPK) y Garantías de Equipos" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Conceptos XML -->
                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                    <ComboBox x:Name="CboXmlVincularProducto" Width="230" Margin="0,0,5,0" ToolTip="Seleccione un producto existente del catálogo para vincularlo" />
                                                    <ui:Button Content="Vincular" FontSize="10.8" Padding="7,3" Margin="0,0,5,0" Click="BtnVincularConceptoXmlConProducto_Click" />
                                                    <ui:Button Content="Como Nuevo" FontSize="10.8" Padding="7,3" Margin="0,0,5,0" ToolTip="Desvincular para que se cree como un producto nuevo en el catálogo" Click="BtnMarcarConceptoComoNuevo_Click" />
                                                    <ui:Button Content="+ Crear en Catálogo" FontSize="10.8" Padding="8,3" Appearance="Primary" ToolTip="Crear en el catálogo los productos que aún no están registrados" Click="BtnCrearProductoDesdeConceptoXml_Click" />
                                                </WrapPanel>
                                                <TextBlock Text="Conceptos del XML" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <DataGrid x:Name="DgXmlConceptosActual" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Clave SAT" Binding="{Binding ClaveProdServ}" Width="95" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Identificación" Binding="{Binding NoIdentificacion}" Width="125" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding Cantidad}" Width="70" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding Unidad}" Width="110" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P. Unitario" Binding="{Binding ValorUnitario, StringFormat={}{0:C2}}" Width="110" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="105" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus / Producto en Catálogo" Binding="{Binding ProductoVinculadoNombre}" Width="280" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 2: COMPRA SIN FACTURA (NOTA DE REMISIÓN / TICKET / EFECTIVO) -->
                            <TabItem Header="Registrar Compra sin Factura (Nota / Ticket)">
                                <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <CheckBox x:Name="ChkSinFacMasIva" Content="Agregar +16% IVA" IsChecked="False" Margin="0,0,14,0" Checked="ChkSinFacMasIva_Changed" Unchecked="ChkSinFacMasIva_Changed" />
