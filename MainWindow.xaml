                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Departamento" Binding="{Binding DepartamentoNombre}" Width="165" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Puesto" Binding="{Binding Puesto}" Width="145" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Correo Corporativo" Binding="{Binding Correo}" Width="195" FontWeight="SemiBold" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Teléfono" Binding="{Binding Telefono}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                    <TabItem Header="Solicitudes, salidas y pr&#233;stamos">
                                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesglosePersonalTitulo" DockPanel.Dock="Top" Text="Desglose de Solicitudes, Salidas y Préstamos" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <DataGrid x:Name="DgDesglosePersonal" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="120" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus" Binding="{Binding Estatus}" Width="125" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                </TabControl>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoEncargado_Click" />
                                                    <TextBlock Text="Datos del Personal" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Departamento Asignado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboAltaEncargadoDepto" Margin="0,0,0,6" />

                                                <TextBlock Text="Nombre Completo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtAltaEncargadoNombre" Margin="0,0,0,6" PlaceholderText="Ej. Ing. Carlos Mendoza" />

                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Puesto / Cargo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoPuesto" PlaceholderText="Ej. Gerente Mecánico" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Teléfono / Ext." FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoTelefono" PlaceholderText="Ej. 55-1020-3040" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="Correo Corporativo (Notificaciones Automáticas)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtAltaEncargadoCorreo" Margin="0,0,0,10" PlaceholderText="Ej. gerente@empresa.com.mx" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Personal" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarEncargado_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarEncargado_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoDepartamento_Click" />
                                                    <TextBlock Text="Departamentos" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <DataGrid x:Name="DgDirDepartamentos"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          Height="145"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="DgDirDepartamentos_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="90" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Departamento" Binding="{Binding Nombre}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoCodigo" PlaceholderText="Ej. ING-MEC" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Nombre del Departamento" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoNombre" PlaceholderText="Ej. Ingeniería Mecánica" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Departamento" HorizontalAlignment="Stretch" Click="BtnGuardarDepartamento_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarDepartamento_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 4: HERRAMIENTAS Y CATEGORÍAS -->
                        <TabItem Header="Herramientas y Categorías">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <TabControl Grid.Column="0" Margin="0,0,10,0" Padding="0,4,0,0">
                                    <TabItem Header="Herramientas">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:Button Content="Garantías y TCO (HER-xxxx)"
                                                               FontSize="11.5"
                                                               Padding="10,4"
                                                               Margin="0,0,6,0"
                                                               ToolTip="Consultar vigencia de garantías con proveedor y alerta de reemplazo al 50% de mantenimiento (TCO)"
                                                               Click="BtnAbrirGarantiasEquipos_Click" />
                                                    <ui:Button Content="Maletines / Kits (KIT-xxxx)"
                                                               FontSize="11.5"
                                                               Padding="10,4"
                                                               Margin="0,0,6,0"
                                                               ToolTip="Configurar maletines y cajas de herramientas para salida y revisión de regreso en 1 clic"
                                                               Click="BtnAbrirGestorKitsHerramientas_Click" />
                                                    <ui:Button Content="Mapa e Inventario por Cuadrante"
                                                               FontSize="11.5"
                                                               Padding="10,4"
                                                               ToolTip="Ver mapa gráfico 3x3 de anaqueles A–F y consultar qué herramientas y materiales hay en cada cuadrante"
                                                               Click="BtnAbrirMapaAnaqueles_Click" />
                                                </StackPanel>
                                                <TextBlock Text="Inventario Individual de Herramientas" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgDirHerramientas"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirHerramientas_SelectionChanged">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Prestar esta Herramienta (Ir a Vale de Préstamo)" Click="CtxDirHerPrestar_Click" FontWeight="Bold" />
                                                        <MenuItem Header="Reubicar en Mapa Gráfico 3×3 (A–F)" Click="CtxDirHerReubicarMapa_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Marcar como Disponible" Click="CtxDirHerMarcarDisponible_Click" />
                                                        <MenuItem Header="Marcar como Dañada / Mantenimiento" Click="CtxDirHerMarcarDanada_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Copiar Código HER-xxxx y Serie" Click="CtxDirHerCopiarCodigo_Click" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding CodigoIndividual}" Width="95" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Herramienta" Binding="{Binding ProductoNombre}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Marca / Modelo" Binding="{Binding MarcaModelo}" Width="140" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Núm. Serie" Binding="{Binding NumeroSerie}" Width="115" />
                                                    <DataGridTemplateColumn Header="Estado" Width="125">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Estado}">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Ubicación" Binding="{Binding Ubicacion}" Width="105" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="En Resguardo De" Binding="{Binding EncargadoActual}" Width="135" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                    <TabItem Header="Categor&#237;as">
                                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Categorías del Catálogo Visual" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirCategorias"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirCategorias_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="ID" Binding="{Binding Id}" Width="55" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Nombre de la Categoría" Binding="{Binding Nombre}" Width="240" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Campos Técnicos de esta Categoría" Binding="{Binding CamposResumen}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                </TabControl>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nueva" Margin="8,0,0,0" Click="BtnNuevaHerramientaDir_Click" />
                                                    <TextBlock Text="Datos de la Herramienta" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Producto Base" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboDirHerProducto" Margin="0,0,0,6" />

                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código Individual" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerCodigo" FontFamily="Consolas" PlaceholderText="Ej. HER-0007" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Número de Serie" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerSerie" PlaceholderText="Ej. BOS-882910 o S/N" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="Marca / Modelo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerMarca" Margin="0,0,0,6" PlaceholderText="Ej. Bosch GSB 16 RE" />

                                                <TextBlock Text="Estado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboDirHerEstado" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="Disponible" />
                                                    <ComboBoxItem Content="En Préstamo" />
                                                    <ComboBoxItem Content="Dañada" />
                                                    <ComboBoxItem Content="Extraviada / Baja" />
                                                </ComboBox>

                                                <TextBlock Text="Ubicación en Almacén (Anaquel A–F, Detrás de A, Gabinete o Piso)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="TxtDirHerUbicacion"
                                                              Grid.Column="0"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="True"
                                                              ToolTip="Seleccione de la lista desplegable o escriba la ubicación (Ej. A-04, DETRAS-A-01, GABINETE-01)"
                                                              SelectionChanged="CboUbicacionAlmacen_SelectionChanged" />
                                                    <ui:Button Grid.Column="1"
                                                               Content="Mapa"
                                                               FontSize="11.5"
                                                               Padding="10,5"
                                                               Margin="6,0,0,0"
                                                               ToolTip="Abrir selector gráfico 3x3 de anaquel y cuadrante"
                                                               Click="BtnSelectorUbicacionDirHer_Click" />
                                                </Grid>

                                                <TextBlock Text="Notas / Accesorios Incluidos" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerNotas" Margin="0,0,0,10" PlaceholderText="Ej. En maletín con llave de mandril..." />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Herramienta" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarHerramientaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarHerramientaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nueva" Margin="8,0,0,0" Click="BtnNuevaCategoriaDir_Click" />
                                                    <TextBlock Text="Categoría y Plantilla Técnica" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Nombre de la Categoría" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatNombre" Margin="0,0,0,6" PlaceholderText="Ej. Refrigeración y Aire Acondicionado" />

                                                <TextBlock Text="Etiqueta Campo Técnico 1" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo1" Margin="0,0,0,6" PlaceholderText="Ej. Capacidad Eléctrica / Voltaje" />

                                                <TextBlock Text="Etiqueta Campo Técnico 2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo2" Margin="0,0,0,6" PlaceholderText="Ej. Corriente / Potencia / Material" />

                                                <TextBlock Text="Etiqueta Campo Técnico 3" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo3" Margin="0,0,0,8" PlaceholderText="Ej. Gas / Polos / Color / Norma" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Categoría" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarCategoriaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarCategoriaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ==================== TAB 9: FLOTILLA VEHICULAR Y COSTO POR KM (CPK) ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Encabezado y Acciones Principales del Módulo de Flotilla -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="+ Nueva Camioneta / Unidad"
                                           FontSize="11.5"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="BtnModalNuevaCamionetaFlotilla_Click" />
                                <ui:Button Content="+ Registrar Carga de Gasolina"
                                           Appearance="Primary"
                                           FontSize="11.5"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="BtnModalCargaGasolinaFlotilla_Click" />
                                <ui:Button Content="+ Registrar Gasto (Taller / Otros)"
                                           FontSize="11.5"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="BtnModalGastoTallerFlotilla_Click" />
                                <ui:Button Content="Check-list Semanal + Kilometraje"
                                           FontSize="11.5"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="BtnModalChecklistSemanalFlotilla_Click" />
                                <ui:Button Content="Imprimir Check-list Semanal"
                                           FontSize="11.5"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="BtnImprimirChecklistSemanalFlotilla_Click" />
                                <Menu Background="{DynamicResource ControlFillColorDefaultBrush}"
                                      BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                      BorderThickness="1"
                                      VerticalAlignment="Center">
                                    <MenuItem Header="Herramientas ▾" Padding="8,5" FontSize="11.5" FontWeight="SemiBold">
                                        <MenuItem Header="Exportar Resumen de Flotilla y CPK (CSV)" Click="BtnExportarFlotillaCsv_Click" />
                                        <MenuItem Header="Respaldo Integral del Sistema (.ZIP)" Click="BtnModalRespaldoZip_Click" />
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Control de Flotilla Vehicular, Combustible y Mantenimiento" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="Monitoreo de Costo por Kilómetro (CPK), rendimiento km/L, estimación de próximo servicio según consumo y bitácora semanal imprimible."
                                           FontSize="11.5" Opacity="0.72" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Tarjetas de KPIs Ejecutivos de Flotilla -->
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
                            <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1,1,1,3">
                                <StackPanel>
                                    <TextBlock Text="COSTO PROMEDIO POR KM (CPK)" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                    <TextBlock x:Name="TxtKpiFlotillaCpk" Text="$0.00 / km" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="TxtKpiFlotillaCpkSub" Text="0 km recorridos en flotilla" FontSize="10.8" Opacity="0.72" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="#10B981" BorderThickness="1,1,1,3">
                                <StackPanel>
                                    <TextBlock Text="RENDIMIENTO Y COMBUSTIBLE" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                    <TextBlock x:Name="TxtKpiFlotillaCombustible" Text="$0.00" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                    <TextBlock x:Name="TxtKpiFlotillaRendimientoSub" Text="0.0 km/L promedio | 0 L" FontSize="10.8" Opacity="0.72" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="#F59E0B" BorderThickness="1,1,1,3">
                                <StackPanel>
                                    <TextBlock Text="TALLER, REFACCIONES Y OTROS" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                    <TextBlock x:Name="TxtKpiFlotillaMantenimiento" Text="$0.00" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                    <TextBlock x:Name="TxtKpiFlotillaMantenimientoSub" Text="Gasto total flotilla: $0.00" FontSize="10.8" Opacity="0.72" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="#6366F1" BorderThickness="1,1,1,3">
                                <StackPanel>
                                    <TextBlock Text="UNIDADES ACTIVAS EN RUTA" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                    <TextBlock x:Name="TxtKpiFlotillaUnidades" Text="0 unidades" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                    <TextBlock x:Name="TxtKpiFlotillaUnidadesSub" Text="Odómetro acumulado: 0 km" FontSize="10.8" Opacity="0.72" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="#EF4444" BorderThickness="1,1,1,3">
                                <StackPanel>
                                    <TextBlock Text="PRÓXIMO SERVICIO ESTIMADO" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                    <TextBlock x:Name="TxtKpiFlotillaAlertasServicio" Text="Al día" FontSize="18" FontWeight="Bold" Margin="0,4,0,2" />
                                    <TextBlock x:Name="TxtKpiFlotillaAlertasServicioSub" Text="Sin mantenimientos vencidos" FontSize="10.8" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Cuerpo Principal: Tabla de Flotilla y Detalle de Unidad Seleccionada -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.15*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <!-- Tabla Principal de Camionetas y Estimación de Servicio -->
                            <Border Grid.Row="0" Margin="0,0,0,10" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="Editar Unidad Seleccionada"
                                                       FontSize="10.8"
                                                       Padding="8,3"
                                                       Margin="0,0,6,0"
                                                       Click="BtnEditarCamionetaSeleccionadaFlotilla_Click" />
                                            <ui:Button Content="Eliminar Unidad Seleccionada"
                                                       FontSize="10.8"
                                                       Padding="8,3"
                                                       Click="BtnEliminarCamionetaSeleccionadaFlotilla_Click" />
                                        </StackPanel>
                                        <TextBlock Text="Padrón de Camionetas y Unidades de Flotilla (Selecciona una unidad para ver su bitácora inferior)"
                                                   FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <DataGrid x:Name="DgFlotillaPrincipal"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionChanged="DgFlotillaPrincipal_SelectionChanged"
                                              MouseDoubleClick="DgFlotillaPrincipal_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoVehiculo}" Width="82" />
                                            <DataGridTextColumn Header="Unidad / Modelo" Binding="{Binding MarcaModelo}" Width="1.2*" />
                                            <DataGridTextColumn Header="Placas" Binding="{Binding Placas}" Width="86" />
                                            <DataGridTextColumn Header="Responsable / Cuadrilla" Binding="{Binding ResponsableHabitual}" Width="1.1*" />
                                            <DataGridTextColumn Header="Odómetro Actual" Binding="{Binding KilometrajeActual, StringFormat={}{0:N0} km}" Width="105" />
                                            <DataGridTextColumn Header="Km Recorridos" Binding="{Binding KilometrosRecorridosPeriodo, StringFormat={}{0:N0} km}" Width="95" />
                                            <DataGridTextColumn Header="Rendimiento" Binding="{Binding RendimientoTexto}" Width="135" />
                                            <DataGridTextColumn Header="Gasto Combustible" Binding="{Binding GastoCombustibleAcumulado, StringFormat={}{0:C2}}" Width="110" />
                                            <DataGridTextColumn Header="Taller / Otros" Binding="{Binding GastoMantenimientoAcumulado, StringFormat={}{0:C2}}" Width="100" />
                                            <DataGridTextColumn Header="CPK ($/km)" Binding="{Binding CostoPorKilometroTexto}" Width="95" />
                                            <DataGridTextColumn Header="Meta Servicio (Cada X km)" Binding="{Binding AlertaServicioTexto}" Width="175" />
                                            <DataGridTextColumn Header="Estimación Próximo Servicio" Binding="{Binding EstimacionProximoServicioFechaTexto}" Width="195" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Panel Inferior: Bitácora de Cargas de Gasolina/Gastos y Check-lists Semanales de la Unidad -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Bitácora de Gasolina y Gastos de la Unidad -->
                                <Border Grid.Column="0" Margin="0,0,8,0" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Content="Eliminar Gasto Seleccionado"
                                                       FontSize="10.8"
                                                       Padding="8,3"
                                                       Click="BtnEliminarGastoSeleccionadoFlotilla_Click" />
                                            <TextBlock x:Name="TxtTituloBitacoraGastosFlotilla"
                                                       Text="Historial de Cargas de Gasolina, Taller y Otros Gastos"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgFlotillaGastosUnidad"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="86" />
                                                <DataGridTextColumn Header="Categoría / Tipo" Binding="{Binding TipoGasto}" Width="140" />
                                                <DataGridTextColumn Header="Odómetro" Binding="{Binding KilometrajeRegistro, StringFormat={}{0:N0} km}" Width="85" />
                                                <DataGridTextColumn Header="Litros / Precio" Binding="{Binding LitrosYPrecioTexto}" Width="125" />
                                                <DataGridTextColumn Header="Monto c/IVA" Binding="{Binding MontoConIva, StringFormat={}{0:C2}}" Width="92" />
                                                <DataGridTextColumn Header="Estación / Taller" Binding="{Binding ProveedorTaller}" Width="125" />
                                                <DataGridTextColumn Header="Factura / Ticket" Binding="{Binding FolioReferencia}" Width="95" />
                                                <DataGridTextColumn Header="Detalle / Proyecto" Binding="{Binding Descripcion}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <!-- Historial de Revisiones Semanales e Impresión -->
                                <Border Grid.Column="1" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Content="Reimprimir Seleccionada"
                                                           FontSize="10.8"
                                                           Padding="8,3"
                                                           Margin="0,0,6,0"
                                                           Click="BtnReimprimirRevisionSemanalFlotilla_Click" />
                                                <ui:Button Content="Eliminar Revisión"
                                                           FontSize="10.8"
                                                           Padding="8,3"
                                                           Click="BtnEliminarRevisionSemanalFlotilla_Click" />
                                            </StackPanel>
                                            <TextBlock Text="Bitácora de Check-lists Semanales de Estado"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgFlotillaRevisionesUnidad"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  MouseDoubleClick="DgFlotillaRevisionesUnidad_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Folio" Binding="{Binding FolioRevision}" Width="78" />
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="84" />
                                                <DataGridTextColumn Header="Odómetro" Binding="{Binding KilometrajeRegistrado, StringFormat={}{0:N0} km}" Width="82" />
                                                <DataGridTextColumn Header="Tanque" Binding="{Binding NivelCombustible}" Width="82" />
                                                <DataGridTextColumn Header="Estado Físico" Binding="{Binding ResumenEstadoFisico}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            </ScrollViewer>
        </Grid>

        <!-- Indicador global de carga / procesamiento -->
        <Grid x:Name="OverlayCargando"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="999"
              Background="#75000000"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,22"
                    CornerRadius="8"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="44"
                                     Height="44"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,12" />
                    <TextBlock x:Name="TxtMensajeCargando"
                               Text="Procesando..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Por favor espera un momento"
                               FontSize="11.5"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notificación Toast Discreta (No Intrusiva, Esquina Inferior Derecha) -->
        <Border x:Name="BdrToastNotificacion"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="998"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,22,22"
                MaxWidth="420"
                Padding="14,10"
                CornerRadius="8"
                Background="#0F172A"
                BorderBrush="#10B981"
                BorderThickness="4,1,1,1"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                MouseLeftButtonUp="BdrToastNotificacion_MouseLeftButtonUp">
            <StackPanel>
                <TextBlock x:Name="TxtToastTitulo"
                           Text="Operación completada"
                           Foreground="#34D399"
                           FontSize="11.5"
                           FontWeight="Bold" />
                <TextBlock x:Name="TxtToastMensaje"
                           Text=""
                           Foreground="White"
                           FontSize="12"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
