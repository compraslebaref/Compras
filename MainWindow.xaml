                                                            <StackPanel Margin="3,0,0,0">
                                                                <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompDias3" Text="1" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Text="Notas / Marca ofertada" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Vigencia Cot. (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
