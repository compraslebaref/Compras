                                                       Appearance="Primary"
                                                       Click="BtnEnviarCarritoASolicitud_Click" />
                                            <ui:Button x:Name="BtnToggleEditorCatalogo"
                                                       Grid.Column="3"
                                                       Content="Ocultar panel"
                                                       ToolTip="Ocultar o mostrar el panel lateral de edición para ver el catálogo a pantalla completa"
                                                       Click="BtnToggleEditorCatalogo_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="SvCatalogoVisual"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="SvCatalogoVisual_ScrollChanged">
                                <ItemsControl x:Name="IcCatalogoVisual">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="242"
                                                    Margin="0,0,10,10"
                                                    Padding="12"
                                                    CornerRadius="4"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    ToolTip="Clic izquierdo: Seleccionar / Editar | Clic derecho: Menú de opciones rápidas"
                                                    MouseLeftButtonUp="CardProductoCatalogo_MouseLeftButtonUp">
                                                <Border.ContextMenu>
                                                    <ContextMenu Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Agregar a la Solicitud (+1)" Tag="{Binding}" Click="CtxCardAgregarCarrito_Click" FontWeight="Bold" />
                                                        <MenuItem Header="Enviar directo a Salida de Almacén" Tag="{Binding}" Click="CtxCardEnviarSalida_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Editar Ficha del Producto" Tag="{Binding}" Click="CtxCardEditarProducto_Click" />
                                                        <MenuItem Header="Ver / Cambiar Ubicación en Mapa 3×3 (A–F)" Tag="{Binding}" Click="CtxCardAbrirMapaUbicacion_Click" />
                                                        <MenuItem Header="Abrir Ficha Individual de Herramienta (HER-xxxx)" Tag="{Binding}" Click="CtxCardAbrirFichaHerramienta_Click" />
                                                        <MenuItem Header="Ver Historial de Precios y Gráficas en Análisis" Tag="{Binding}" Click="CtxCardVerAnalisisPrecio_Click" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                        <Separator />
                                                        <MenuItem Header="Copiar Código Interno (PRD-xxxx)" Tag="{Binding}" Click="CtxCardCopiarCodigo_Click" />
                                                        <MenuItem Header="Eliminar Producto del Catálogo" Tag="{Binding}" Click="CtxCardEliminarProducto_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="BorderThickness" Value="2.5" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Height="135"
                                                            CornerRadius="8"
                                                            Background="White"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Box24" FontSize="38" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding CategoriaNombre}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Image Source="{Binding ImagenMiniatura, Mode=OneWay}"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"
                                                                   Stretch="Uniform"
                                                                   Margin="4" />
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                <TextBlock Text="{Binding CategoriaNombre}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="9.5" FontWeight="SemiBold" MaxWidth="115" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#0F172A">
                                                                <TextBlock Text="{Binding CodigoInterno}" Foreground="White" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="6"
                                                                    Padding="6,2"
                                                                    CornerRadius="4"
                                                                    Background="#DCFCE7"
                                                                    BorderBrush="#86EFAC"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Clic para abrir el Mapa de Anaqueles en esta coordenada"
                                                                    MouseLeftButtonDown="BadgeUbicacionCard_MouseLeftButtonDown">
                                                                <TextBlock Text="{Binding UbicacionBadgeTexto, Mode=OneWay}" Foreground="#166534" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}" />
                                                    <TextBlock Text="{Binding FichaTecnicaResumen}" FontSize="10.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FichaTecnicaResumen}" Margin="0,1,0,1" />
                                                    <TextBlock Text="{Binding ConversionTexto}" FontSize="11" Opacity="0.72" Margin="0,0,0,4" />

                                                    <Grid Margin="0,2,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Existencia" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                                <Run Text="{Binding StockActual, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                                                <Run Text="{Binding UnidadAlmacen, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                                            <TextBlock Text="Costo" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock Text="{Binding UltimoCostoCompra, StringFormat={}{0:C2}}" FontSize="13" FontWeight="Bold" Foreground="#107C10" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ui:Button HorizontalAlignment="Stretch"
                                                               Appearance="Primary"
                                                               Content="Agregar a Solicitud"
                                                               Tag="{Binding}"
                                                               Click="BtnAgregarProductoCarrito_Click" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Derecha: Panel del producto (Ficha de lectura / Editar) -->
                        <Border x:Name="PnlPanelProducto" Grid.Column="1" Padding="14,10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <ui:Button x:Name="BtnNuevoProductoCatalogo"
                                               DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               Content="Nuevo producto"
                                               Icon="{ui:SymbolIcon Add24}"
                                               Appearance="Primary"
                                               FontSize="11.5"
                                               ToolTip="Preparar el alta de un nuevo artículo en el catálogo"
                                               Click="BtnNuevoProducto_Click" />
                                    <TextBlock Text="Producto" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                </DockPanel>

                                <TabControl x:Name="TcPanelProducto" Padding="0" SelectionChanged="TcPanelProducto_SelectionChanged">

                                    <!-- ===== PESTAÑA 1: FICHA (solo lectura, información concreta) ===== -->
                                    <TabItem Header="Ficha">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <TextBlock x:Name="TxtFichaVacia"
                                                           Text="Seleccione un producto del catálogo para ver su ficha, o cree uno nuevo."
                                                           TextWrapping="Wrap"
                                                           Opacity="0.72"
                                                           Margin="0,18,0,0" />

                                                <StackPanel x:Name="PnlFichaContenido" Visibility="Collapsed" Margin="0,8,0,4">
                                                    <Border Height="160" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <ui:SymbolIcon Symbol="Box24" FontSize="46" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="ImgFichaProducto" Stretch="Uniform" Margin="6" />
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock x:Name="TxtFichaNombre" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtFichaCodigo" FontFamily="Consolas" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,10" />

                                                    <Border Padding="12,10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Existencia" FontSize="11" Opacity="0.72" />
                                                                <TextBlock x:Name="TxtFichaExistencia" FontSize="22" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="TxtFichaStockDetalle" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border x:Name="BdrFichaEstadoStock" Grid.Column="1" Padding="8,3" CornerRadius="4" VerticalAlignment="Top" Background="#DCFCE7">
                                                                <TextBlock x:Name="TxtFichaEstadoStock" FontSize="11" FontWeight="SemiBold" Foreground="#166534" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <DockPanel Margin="0,0,0,6">
                                                        <ui:Button DockPanel.Dock="Right" Content="Ver mapa" FontSize="11.5" Margin="8,0,0,0" Click="BtnFichaMapa_Click" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Ubicación en almacén" FontSize="11" Opacity="0.72" />
                                                            <TextBlock x:Name="TxtFichaUbicacion" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <StackPanel x:Name="PnlFichaDetalles" />

                                                    <StackPanel Margin="0,14,0,0">
                                                        <ui:Button Content="Agregar a solicitud" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="BtnFichaAgregarSolicitud_Click" />
                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <ui:Button Content="Enviar a salida" HorizontalAlignment="Stretch" Margin="0,0,3,0" Click="BtnFichaEnviarSalida_Click" />
                                                            <ui:Button Content="Editar" Icon="{ui:SymbolIcon Edit24}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Click="BtnFichaEditar_Click" />
                                                        </UniformGrid>
                                                        <ui:Button Content="Ver historial detallado" Icon="{ui:SymbolIcon History24}" HorizontalAlignment="Stretch" Click="BtnFichaHistorial_Click" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- ===== PESTAÑA 2: EDITAR (formulario) ===== -->
                                    <TabItem Header="Editar">
                                        <ScrollViewer x:Name="SvEditorProducto" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,8,6,0">
                                    <!-- Banner visual claro de Modo Alta vs Modo Edición -->
                                    <Border x:Name="BdrModoEditorProducto"
                                            Padding="10,7"
                                            CornerRadius="4"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtModoEditorProductoTitulo"
                                                       Text="MODO: ALTA DE NUEVO PRODUCTO"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="TxtModoEditorProductoSubtitulo"
                                                       Text="Escriba el nombre del nuevo artículo y presione '➕ Crear Nuevo Producto' abajo."
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Height="115" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Sin imagen (Ctrl+V para pegar)" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="ImgPreviewProducto" Stretch="Uniform" Margin="4" />
                                        </Grid>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <ui:Button Content="Pegar Imagen" Margin="0,0,4,0" Click="BtnPegarImagenPortapapeles_Click" />
                                        <ui:Button Content="Subir Archivo" Margin="4,0,0,0" Click="BtnSubirImagenArchivo_Click" />
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Código Interno" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoInterno" FontFamily="Consolas" PlaceholderText="Ej. PRD-0011" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Código de Barras" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoBarras" FontFamily="Consolas" PlaceholderText="Ej. 750100010001" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Nombre del Producto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtProdNombre" Margin="0,0,0,6" PlaceholderText="Ej. Compresor Scroll 5 Toneladas / Paño Microfibra" />

                                    <TextBlock Text="Categoría (Define los campos técnicos abajo)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CboProdCategoria" Margin="0,0,0,6" SelectionChanged="CboProdCategoria_SelectionChanged" />

                                    <DockPanel Margin="0,0,0,2">
                                        <ui:Button DockPanel.Dock="Right"
                                                   Margin="6,0,0,0"
                                                   Content="Gestionar Familias"
                                                   FontSize="10"
                                                   Padding="6,1"
                                                   ToolTip="Crear, renombrar o unificar familias de productos manualmente"
                                                   Click="BtnGestionarFamilias_Click" />
                                        <TextBlock Text="Familia / Agrupador Genérico" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ComboBox x:Name="CboProdFamilia"
                                              IsEditable="True"
                                              Margin="0,0,0,6"
                                              ToolTip="Seleccione una familia existente o escriba una nueva manualmente para agrupar artículos equivalentes en Comparativa" />

                                    <!-- Ficha Técnica Inteligente (Universal + Dinámica por Categoría) -->
                                    <Border Padding="8" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <ui:Button DockPanel.Dock="Right"
                                                           Margin="6,0,0,0"
                                                           Content="Autocompletar"
                                                           FontSize="10.5"
                                                           Padding="6,2"
                                                           ToolTip="Detectar categoría, marca, modelo, medidas y especificaciones desde el nombre"
                                                           Click="BtnAutocompletarFichaProducto_Click" />
                                                <TextBlock Text="Ficha Técnica y Especificaciones" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <!-- Nivel 1: Campos Universales (Marca, Modelo, Medidas) -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Marca" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdMarca" PlaceholderText="Ej. LG, Trane, Pretul, 3M" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Modelo / N° Parte" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdModelo" PlaceholderText="Ej. EBR80820305, MVPP600" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Medidas / Dimensiones" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdMedidas" Margin="0,0,0,6" PlaceholderText="Ej. 40x40 cm, 3/4 x 2 pulg, 18 m x 19 mm" />

                                            <!-- Nivel 2: Campos Dinámicos según la Categoría seleccionada -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock x:Name="LblProdCampo1" Text="Capacidad Eléctrica / Voltaje" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBox x:Name="TxtProdCapacidadElectrica" PlaceholderText="Ej. 220V / 5 Ton / Microfibra" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock x:Name="LblProdCampo2" Text="Corriente / Potencia / Material" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBox x:Name="TxtProdEspecificacion1" PlaceholderText="Ej. 40A, 160W, Cédula 40, 4 L" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock x:Name="LblProdCampo3" Text="Gas / Polos / Color / Especificación" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                            <ui:TextBox x:Name="TxtProdEspecificacion2" Margin="0,0,0,6" PlaceholderText="Ej. R-410A, Trifásico, IP65, Color Azul" />

                                            <TextBlock Text="Notas Técnicas / Descripción Adicional" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdDescripcion" PlaceholderText="Observaciones adicionales, compatibilidad o referencia SAT..." />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="8" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Unidades y Conversión (Mayoreo a Menudeo)" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="85" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Unidad Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="TxtProdUnidadCompra" IsEditable="True" SelectionChanged="UnidadOFactorProducto_Changed" LostFocus="UnidadOFactorProducto_Changed" ToolTip="Unidad en que lo factura el proveedor (Caja, Paquete, Rollo, Pieza, etc.)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Unidad Entrega" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="TxtProdUnidadAlmacen" IsEditable="True" SelectionChanged="UnidadOFactorProducto_Changed" LostFocus="UnidadOFactorProducto_Changed" ToolTip="Unidad en que se guarda y entrega en almacén (Pieza, Rollo, Metro, Litro, Par, etc.)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Piezas x Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdFactor" PlaceholderText="Ej. 1" TextChanged="TxtProdFactorOCosto_TextChanged" ToolTip="Cuántas Unidades de Entrega contiene 1 Unidad de Compra (Ej. 1 Caja = 12 Rollos)" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="TxtResumenConversionProducto"
                                                       Text="Existencia expresada en Unidad de Entrega | Costo expresado por Unidad de Compra"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock x:Name="LblProdExistenciaUnidad" Text="Existencia (Entrega)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="La existencia actual del almacén se expresa siempre en Unidades de Entrega" />
                                            <ui:TextBox x:Name="TxtProdStock" PlaceholderText="Ej. 0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock x:Name="LblProdStockMinUnidad" Text="Stock Mín. (Entrega)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="Nivel mínimo de alerta expresado en Unidades de Entrega" />
                                            <ui:TextBox x:Name="TxtProdStockMin" PlaceholderText="0 = sin alerta de mínimo" />
                                        </StackPanel>
                                        <StackPanel x:Name="PnlProdCostoEditor" Grid.Column="2" Margin="4,0,0,0" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                            <TextBlock x:Name="LblProdCostoUnidad" Text="Costo Compra ($ c/IVA)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="Costo con IVA por cada Unidad de Compra" />
                                            <ui:TextBox x:Name="TxtProdCosto" PlaceholderText="Ej. 0.00" TextChanged="TxtProdFactorOCosto_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Ubicación en Almacén (Anaquel A–F, Detrás de A, Gabinete o Piso)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="TxtProdUbicacion"
                                                      Grid.Column="0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ToolTip="Seleccione de la lista desplegable o escriba la ubicación (Ej. A-01, DETRAS-A-01, GABINETE-01, PISO-01)"
                                                      SelectionChanged="CboUbicacionAlmacen_SelectionChanged" />
                                            <ui:Button Grid.Column="1"
                                                       Content="Mapa"
                                                       FontSize="11.5"
                                                       Padding="10,5"
                                                       Margin="6,0,0,0"
                                                       ToolTip="Abrir selector gráfico 3x3 de anaqueles (A–F, Detrás de A, Gabinete y Piso)"
                                                       Click="BtnSelectorUbicacionProducto_Click" />
                                        </Grid>
                                        <Border Padding="8,5" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <ui:Button x:Name="BtnConfigurarHerramientaCatalogo"
                                                           DockPanel.Dock="Right"
                                                           Content="Configurar Ficha HER"
                                                           FontSize="11"
                                                           Padding="10,4"
                                                           ToolTip="Abrir modal de información de la herramienta (Número de serie, código individual HER-xxxx, ubicación y estado)"
                                                           Click="BtnConfigurarHerramientaCatalogo_Click" />
                                                <CheckBox x:Name="ChkProdEsHerramienta"
                                                          Content="Es Herramienta de Resguardo"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Marcar si es una herramienta de resguardo en almacén (abre el registro de ficha individual HER-xxxx)"
                                                          Click="ChkProdEsHerramienta_Click" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>

                                    <Image x:Name="ImgBarcodeProductoEditor" Height="44" Stretch="Fill" Margin="0,2,0,8" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnGuardarProductoCatalogo"
                                                   Grid.Column="0"
                                                   Content="Guardar Producto"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Click="BtnGuardarProducto_Click" />
                                        <ui:Button Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   Content="Eliminar"
                                                   Click="BtnEliminarProducto_Click" />
                                    </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ===== VISTA DE DETALLE: HISTORIAL COMPLETO DEL PRODUCTO (reemplaza el área del catálogo) ===== -->
                    <Border x:Name="PnlHistorialProducto" Visibility="Collapsed" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Left"
                                           Icon="{ui:SymbolIcon ArrowLeft24}"
                                           Content="Catálogo"
                                           FontSize="11.5"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           ToolTip="Volver al catálogo"
                                           Click="BtnVolverCatalogoDesdeHistorial_Click" />
                                <Border DockPanel.Dock="Left" Width="54" Height="54" CornerRadius="6" Margin="0,0,12,0" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image x:Name="ImgHistProducto" Stretch="Uniform" Margin="3" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHistProdTitulo" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtHistProdResumen" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TabControl Padding="0,8,0,0">

                                <TabItem x:Name="TabHistPrecios" Header="Precios de compra" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtHistPreciosResumen" DockPanel.Dock="Top" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <DataGrid x:Name="DgHistPrecios" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding FechaTexto}" Width="110" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Documento" Binding="{Binding FolioDocumento}" Width="130" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:0.##}}" Width="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding Unidad}" Width="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. s/IVA" Binding="{Binding PrecioUnitarioSinIva, StringFormat={}{0:C2}}" Width="110" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. c/IVA" Binding="{Binding PrecioUnitarioConIva, StringFormat={}{0:C2}}" Width="110" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Importe c/IVA" Binding="{Binding ImporteConIva, StringFormat={}{0:C2}}" Width="130" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <TabItem x:Name="TabHistCotizaciones" Header="Cotizaciones y Vigencias" Visibility="{DynamicResource VisibilidadPreciosPerfil}">
                                    <DataGrid x:Name="DgHistCotizacionesProducto" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha Cot." Binding="{Binding FechaCotizacion}" Width="105" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Origen" Binding="{Binding OrigenFolio}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor (Comercial)" Binding="{Binding ProveedorNombre}" Width="180" FontWeight="SemiBold" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. s/IVA" Binding="{Binding PrecioSinIva, StringFormat={}{0:C2}}" Width="110" FontWeight="Bold" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. c/IVA" Binding="{Binding PrecioConIva, StringFormat={}{0:C2}}" Width="110" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entrega (días)" Binding="{Binding DiasEntrega}" Width="95" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Vigencia y Estado" Binding="{Binding EstadoVigenciaTexto}" Width="210" FontWeight="SemiBold" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Notas / Condición" Binding="{Binding NotasCotizacion}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem x:Name="TabHistEntradas" Header="Entradas">
                                    <DataGrid x:Name="DgHistEntradas" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entrada" Binding="{Binding Folio}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Orden de Compra" Binding="{Binding OrdenCompra}" Width="140" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cantidad ingresada" Binding="{Binding Cantidad}" Width="150" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding Tipo}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem x:Name="TabHistSalidas" Header="Salidas y devoluciones">
                                    <DataGrid x:Name="DgHistSalidas" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Salida" Binding="{Binding Folio}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recibió" Binding="{Binding Recibe}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding Proyecto}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entregado" Binding="{Binding Entregado, StringFormat={}{0:0.##}}" Width="100" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Devuelto" Binding="{Binding Devuelto, StringFormat={}{0:0.##}}" Width="100" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Consumo neto" Binding="{Binding Neto, StringFormat={}{0:0.##}}" Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem x:Name="TabHistPrestamos" Header="Préstamos">
                                    <DataGrid x:Name="DgHistPrestamos" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha salida" Binding="{Binding FechaSalida}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Vale" Binding="{Binding Folio}" Width="130" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código HER" Binding="{Binding CodigoHerramienta}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recibió" Binding="{Binding Recibe}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding Proyecto}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estado" Binding="{Binding Estado}" Width="110" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha devuelto" Binding="{Binding FechaDevuelto}" Width="135" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                            </TabControl>
                        </DockPanel>
                    </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 2: SOLICITUDES (Lista → Detalle) ==================== -->
                <TabItem>
                    <Grid>

                        <ContentControl x:Name="PnlCapturaNuevaSolicitud" Visibility="Collapsed"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                        <!-- ===== VISTA 1: LISTA + FICHA (similar al Catálogo) ===== -->
                        <Grid x:Name="PnlSolicitudesLista">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Menu Background="{DynamicResource ControlFillColorDefaultBrush}"
                                              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                              BorderThickness="1"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0">
                                            <MenuItem Header="Herramientas ▾" Padding="10,6" FontWeight="SemiBold">
                                                <MenuItem Header="Nueva Solicitud en Blanco" Click="BtnNuevaSolicitudVacia_Click" />
                                                <Separator />
                                                <MenuItem Header="Notificaciones por Correo a Gerentes (Gmail SMTP y Bitácora)" Click="BtnAbrirConfigNotificacionesCorreo_Click" FontWeight="SemiBold" />
                                                <MenuItem Header="Bandeja de Solicitudes Recibidas por Correo (Gmail IMAP) y Plantilla" Click="BtnAbrirBandejaCorreosSolicitud_Click" FontWeight="SemiBold" />
                                                <Separator />
                                                <MenuItem Header="Ver Matriz de Kraljic (Insumos Rutinarios vs Estratégicos)" Click="BtnAbrirEconomiaKraljic_Click" />
                                                <MenuItem Header="Ver Variación de Precios (PPV) e Inflación por Familia" Click="BtnAbrirEconomiaPpv_Click" />
                                            </MenuItem>
                                        </Menu>
                                        <ui:Button x:Name="BtnBandejaCorreosSol"
                                                   Content="Bandeja de Correo (IMAP)"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Revisar buzón Gmail (IMAP) para crear solicitudes automáticas por asunto, ver la bandeja anti-traspapeleo y enviar la plantilla a gerentes"
                                                   Click="BtnAbrirBandejaCorreosSolicitud_Click" />
                                        <ui:Button x:Name="BtnNuevaSolicitudVacia"
                                                   Content="Nueva solicitud"
                                                   Icon="{ui:SymbolIcon Add24}"
                                                   Appearance="Primary"
                                                   VerticalAlignment="Center"
                                                   Click="BtnNuevaSolicitudVacia_Click" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Solicitudes de compra" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Clic para ver la ficha · Doble clic para abrir y editar." FontSize="12" Opacity="0.72" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid x:Name="DgHistorialSolicitudes"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          RowHeight="38"
                                          SelectionChanged="DgHistorialSolicitudes_SelectionChanged"
                                          MouseDoubleClick="DgHistorialSolicitudes_MouseDoubleClick"
                                          KeyDown="DgHistorialSolicitudes_KeyDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Abrir solicitud" Click="BtnAbrirSolicitudSeleccionada_Click" FontWeight="Bold" />
                                            <MenuItem Header="Ver Expediente Completo y Reimprimir Documentos" Click="BtnAbrirExpedienteSolicitudContext_Click" FontWeight="SemiBold" />
                                            <MenuItem Header="Abrir en Cuadro Comparativo" Click="BtnEnviarSolicitudAComparativa_Click" />
                                            <MenuItem Header="Ir al Catálogo Visual con esta Solicitud activa" Click="BtnIrCatalogoConSolicitud_Click" />
                                            <Separator />
                                            <MenuItem Header="Vista Previa / Imprimir Solicitud" Click="BtnImprimirSolicitud_Click" />
                                            <MenuItem Header="Descargar Solicitud (PDF / PNG / CSV)" Click="BtnDescargarSolicitudArchivo_Click" />
                                            <Separator />
                                            <MenuItem Header="Eliminar Solicitud" Click="BtnEliminarSolicitud_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="125" FontWeight="SemiBold" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="100" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Solicitante" Binding="{Binding EncargadoNombre}" Width="*" />
                                        <DataGridTemplateColumn Header="Estatus" Width="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding EstatusMostrar}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="⋯" FontSize="14" FontWeight="Bold" Padding="8,0,8,2" Appearance="Transparent" Tag="{Binding}" ToolTip="Opciones de la solicitud" Click="BtnOpcionesSolicitudFila_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Derecha: Ficha de la Solicitud seleccionada -->
                        <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Estado vacío -->
                                <StackPanel x:Name="PnlFichaSolVacia" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6">
                                    <TextBlock Text="📋" FontSize="34" HorizontalAlignment="Center" />
                                    <TextBlock Text="Seleccione una solicitud de la lista para ver su ficha" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="240" />
                                </StackPanel>

                                <DockPanel x:Name="PnlFichaSolContenido" Visibility="Collapsed">
                                    <!-- Encabezado: Folio + estatus -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Border x:Name="BdrFichaSolEstatus" DockPanel.Dock="Right" Style="{StaticResource StatusPillBorderStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtFichaSolFolio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="TxtFichaSolTipo" FontSize="11.5" Opacity="0.7" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Datos generales -->
                                    <Border DockPanel.Dock="Top" Padding="12,10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Fecha" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFichaSolFecha" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="1" Text="Solicitante" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFichaSolSolicitante" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="2" Text="Departamento" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFichaSolDepto" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="3" Text="Destino" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtFichaSolProyecto" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Grid.Row="4" Text="Origen" FontSize="11.5" Opacity="0.65" Margin="0,2" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtFichaSolOrigen" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                        </Grid>
                                    </Border>

                                    <!-- Siguiente paso guiado -->
                                    <Border x:Name="BdrFichaSolSiguientePaso" DockPanel.Dock="Top" Padding="12,9" CornerRadius="6" Margin="0,0,0,10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtFichaSolSiguientePasoTitulo" Text="➜ SIGUIENTE PASO" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                            <TextBlock x:Name="TxtFichaSolSiguientePaso" FontSize="12" TextWrapping="Wrap" Foreground="#1E3A8A" Margin="0,3,0,6" />
                                            <WrapPanel>
                                                <ui:Button x:Name="BtnFichaSolSiguientePaso" FontSize="11.5" Padding="10,4" Margin="0,0,6,4" Click="BtnFichaSolSiguientePaso_Click" />
                                                <ui:Button x:Name="BtnFichaSolEsperando" Content="⏸ Esperando respuesta ▾" FontSize="11" Padding="8,4" Margin="0,0,6,4" ToolTip="Pausar: depende de alguien externo (no cuenta como pendiente nuestro)" Click="BtnFichaSolEsperando_Click" />
                                                <ui:Button x:Name="BtnFichaSolConcluir" Content="✓ Marcar como concluida" FontSize="11" Padding="8,4" Margin="0,0,0,4" ToolTip="Declarar que ya no requiere más pasos; oculta este aviso" Click="BtnFichaSolConcluir_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel x:Name="PnlFichaSolConcluida" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
                                        <ui:Button DockPanel.Dock="Right" Content="Reabrir" FontSize="10.5" Padding="8,2" Appearance="Transparent" ToolTip="Volver a mostrar el siguiente paso" Click="BtnFichaSolReabrir_Click" />
                                        <TextBlock Text="✓ Concluida — no requiere más pasos" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Botón abrir -->
                                    <ui:Button x:Name="BtnFichaSolAbrir"
                                               DockPanel.Dock="Bottom"
                                               Content="Abrir / Editar solicitud"
                                               Icon="{ui:SymbolIcon Open24}"
                                               Appearance="Primary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,10,0,0"
                                               Click="BtnAbrirSolicitudSeleccionada_Click" />

                                    <!-- Notas (si existen) -->
                                    <TextBlock x:Name="TxtFichaSolNotas" DockPanel.Dock="Bottom" FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis" />

                                    <!-- Materiales -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtFichaSolResumen" DockPanel.Dock="Right" FontSize="11.5" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Text="Materiales solicitados" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataGrid x:Name="DgFichaSolPartidas"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ColFichaSolNombrePartida" Header="Partida" Binding="{Binding NombrePartida}" Visibility="Collapsed" Width="105" />
                                            <DataGridTextColumn Header="Descripción" Binding="{Binding ProductoNombre}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="2,3" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Cant." Binding="{Binding CantidadSolicitada, StringFormat={}{0:0.##}}" Width="58" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" Width="72" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Border>
                        </Grid>

                        <!-- ===== VISTA 2: DETALLE DE LA SOLICITUD (con menús internos) ===== -->
                        <Border x:Name="PnlSolicitudDetalle" Visibility="Collapsed" Padding="16" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>

                                <!-- Barra superior: volver, título, estado y acciones -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ui:Button x:Name="BtnAprobarSurtirStockSol" Content="✓ Aprobar Stock" FontSize="10.8" Padding="7,3" Margin="0,0,5,0" Visibility="{DynamicResource VisibilidadPreciosPerfil}" ToolTip="Compras aprueba que esta solicitud se surta con stock existente en Almacén (Checkpoint CP-1A)" Click="BtnAprobarSurtirStockSolicitud_Click" />
                                        <ui:Button x:Name="BtnCrearAnexoSolicitud" Content="+ Anexo" FontSize="10.8" Padding="7,3" Margin="0,0,5,0" ToolTip="Generar anexo vinculado (ej. SOL-xxxx-A1) para agregar artículos adicionales cuando esta solicitud ya está bloqueada" Click="BtnCrearAnexoSolicitud_Click" />
                                        <ui:Button x:Name="BtnVerExpedienteSolicitudDetalle" Content="Expediente" Visibility="Collapsed" Click="BtnVerExpedienteSolicitudDetalle_Click" />
                                        <ui:Button x:Name="BtnAbrirEnComparativaSol" Content="Ir a Comparativa" Appearance="Primary" FontSize="10.8" Padding="8,3" Margin="0,0,5,0" Visibility="{DynamicResource VisibilidadPreciosPerfil}" Click="BtnEnviarSolicitudAComparativa_Click" />
                                        <Menu Background="Transparent" VerticalAlignment="Center">
                                            <MenuItem Header="Más acciones" Padding="8,4" FontSize="11" FontWeight="SemiBold">
                                                <MenuItem Header="Ver Expediente y Reimprimir Documentos" Click="BtnVerExpedienteSolicitudDetalle_Click" FontWeight="SemiBold" />
                                                <MenuItem Header="Ir al Catálogo con esta Solicitud" Click="BtnIrCatalogoConSolicitud_Click" />
                                                <Separator />
                                                <MenuItem Header="Vista Previa / Imprimir Solicitud" Click="BtnImprimirSolicitud_Click" />
                                                <MenuItem Header="Descargar Solicitud (PDF / PNG / CSV)" Click="BtnDescargarSolicitudArchivo_Click" />
                                                <MenuItem Header="Exportar Existencias de Almacén (CSV)" Click="BtnExportarExistenciasCatalogo_Click" />
                                                <Separator />
                                                <MenuItem Header="Eliminar Solicitud" Click="BtnEliminarSolicitud_Click" />
                                            </MenuItem>
                                        </Menu>
                                    </StackPanel>
                                    <ui:Button x:Name="BtnVolverListaSolicitudes"
                                               DockPanel.Dock="Left"
                                               Icon="{ui:SymbolIcon ArrowLeft24}"
                                               Content="Solicitudes"
                                               FontSize="11.5"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               ToolTip="Volver a la lista de solicitudes"
                                               Click="BtnVolverListaSolicitudes_Click" />
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTituloEditorSolicitud" Text="Nueva Solicitud de Compra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                                        <Border x:Name="BdrEstadoEditorSolicitud" Padding="8,2" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtEstadoEditorSolicitud" Text="EN CAPTURA" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </WrapPanel>
                                </DockPanel>

                                <!-- Barra inferior fija: acciones principales de la solicitud -->
                                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <ui:Button x:Name="BtnLimpiarPartidasSolicitud" Content="Vaciar artículos" Margin="0,0,6,0" Click="BtnLimpiarPartidasSolicitud_Click" />
                                            <ui:Button Content="Generar salida de stock" ToolTip="Envía los artículos que sí tienen existencia en Almacén directamente a Salida de Material" Click="BtnGenerarSalidaStockSolicitud_Click" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkSolNotificarGerente" Content="Notificar correo a gerente" IsChecked="True" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Envía correo al gerente: 'Tu cotización folio xxx registrada, tiempo aprox de xx'" />
                                            <TextBlock Text="Tiempo aprox:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox x:Name="CboSolTiempoAproxRespuesta" IsEditable="True" Width="140" Margin="0,0,8,0" Text="12 a 24 hrs" ToolTip="Tiempo aproximado de atención/cotización reportado al gerente">
                                                <ComboBoxItem Content="4 a 12 hrs (Urgente)" />
                                                <ComboBoxItem Content="12 a 24 hrs" />
                                                <ComboBoxItem Content="24 a 48 hrs" />
                                                <ComboBoxItem Content="1 a 2 días hábiles" />
                                                <ComboBoxItem Content="2 a 3 días hábiles" />
                                            </ComboBox>
                                            <ui:Button x:Name="BtnGuardarSolicitud" Content="Guardar Solicitud" Appearance="Primary" Click="BtnGuardarSolicitud_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Menús internos del detalle -->
                                <TabControl Padding="0,8,0,0">

                                    <TabItem x:Name="TabSolArticulos" Header="Artículos">
                                        <DockPanel Margin="0,4,0,0">
                                            <Border DockPanel.Dock="Top" Padding="10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="TxtContadorFiltroProductoSol" DockPanel.Dock="Right" Margin="8,0,0,0" Text="" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                                        <TextBlock Text="Buscar y agregar artículo" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ui:TextBox x:Name="TxtBuscarProductoSolicitud"
                                                                Margin="0,0,0,6"
                                                                PlaceholderText="Nombre, código, marca, medida o escanee código de barras (Enter agrega)"
                                                                VerticalContentAlignment="Center"
                                                                TextChanged="TxtBuscarProductoSolicitud_TextChanged"
                                                                KeyDown="TxtBuscarProductoSolicitud_KeyDown" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ComboBox x:Name="CboSolProductoAgregar" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="CboSolProductoAgregar_SelectionChanged" />
                                                        <ui:TextBox x:Name="TxtSolCantidadAgregar" Grid.Column="1" PlaceholderText="Cant. (1)" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                                                        <ComboBox x:Name="CboSolUnidadAgregar" Grid.Column="2" IsEditable="True" Width="100" Margin="0,0,0,0" ToolTip="Unidad de medida para esta solicitud (ej. Pieza, Caja, Rollo, Metro, Paquete)" />
                                                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                                            <ui:Button Content="+ Agregar del catálogo" Appearance="Primary" FontSize="10.8" Padding="8,3" Margin="0,0,5,2" Click="BtnAgregarPartidaSolicitud_Click" />
                                                            <ui:Button Content="+ Por Familia Genérica" FontSize="10.8" Padding="8,3" Margin="0,0,5,2" ToolTip="Solicitar por familia funcional (ej. Pegamento para PVC) sin casarse con una marca específica hasta cotizar o recoger" Click="BtnAgregarPorFamiliaGenericaSolicitud_Click" />
                                                            <ui:Button Content="+ Concepto abierto" FontSize="10.8" Padding="8,3" Margin="0,0,5,2" ToolTip="Agrega el texto escrito en el buscador como necesidad genérica sin crear un producto vacío en el catálogo todavía" Click="BtnAgregarConceptoLibreSolicitud_Click" />
                                                            <ui:Button x:Name="BtnCrearCarritoEIrCatalogo" Content="Catálogo visual" FontSize="10.8" Padding="8,3" Margin="0,0,0,2" Click="BtnCrearCarritoEIrCatalogo_Click" />
                                                        </WrapPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <CheckBox x:Name="ChkSolUsaPartidas" Content="Usar partidas" VerticalAlignment="Center"
                                                          Checked="ChkSolUsaPartidas_Changed" Unchecked="ChkSolUsaPartidas_Changed" />
                                                <ui:TextBox x:Name="TxtSolPartidaActiva" Width="205" Margin="8,0,0,0" Visibility="Collapsed"
                                                            PlaceholderText="Partida para nuevos artículos" />
                                            </WrapPanel>
                                            <DataGrid x:Name="DgPartidasNuevaSolicitud"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      SelectionMode="Single"
                                                      CellEditEnding="DgPartidasNuevaSolicitud_CellEditEnding">
                                                <DataGrid.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,5" />
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </DataGrid.GroupStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn x:Name="ColSolNombrePartida" Header="Partida" Visibility="Collapsed"
                                                                        Binding="{Binding NombrePartida}" Width="135" />
                                                    <DataGridCheckBoxColumn x:Name="ColSolPartidaCotizar" Header="Cotizar" Binding="{Binding IncluirEnCotizacion, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="100" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                                    <DataGridTextColumn x:Name="ColSolPartidaUnidad" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding UnidadCompra, UpdateSourceTrigger=LostFocus}" IsReadOnly="False" Width="95" />
                                                    <DataGridTextColumn x:Name="ColSolPartidaCantidad" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding CantidadSolicitada, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Stock" Binding="{Binding StockActualAlmacen}" IsReadOnly="True" Width="80" />
                                                    <DataGridTemplateColumn Header="Acciones" Width="150">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Button Content="-" Padding="6,2" Margin="0,0,3,0" ToolTip="Disminuir cantidad" Click="BtnDisminuirPartidaSolicitud_Click" />
                                                                    <Button Content="+" Padding="6,2" Margin="0,0,5,0" ToolTip="Aumentar cantidad" Click="BtnAumentarPartidaSolicitud_Click" />
                                                                    <Button Content="Quitar" Padding="7,2" ToolTip="Quitar artículo de la solicitud" Click="BtnQuitarPartidaSolicitud_Click" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>

                                    <TabItem x:Name="TabSolExpediente" Header="Expediente y Documentos">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,6,4,10">
                                                <!-- BARRA DE REIMPRESIÓN Y DESCARGA DE DOCUMENTOS PRINCIPALES -->
                                                <Border Padding="10,8" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <ui:Button Content="Imprimir Solicitud" Icon="{ui:SymbolIcon Print24}" FontSize="10.8" Padding="8,3" Margin="0,0,5,0" ToolTip="Abrir vista previa para imprimir o descargar la Solicitud (PDF / PNG / CSV)" Click="BtnImprimirSolicitud_Click" />
                                                            <ui:Button x:Name="BtnExpReimprimirComparativa" Content="Imprimir Comparativa" Icon="{ui:SymbolIcon Scales24}" FontSize="10.8" Padding="8,3" Margin="0,0,5,0" Visibility="{DynamicResource VisibilidadPreciosPerfil}" ToolTip="Abrir vista previa para imprimir o descargar el Cuadro Comparativo de Cotizaciones (PDF / PNG / CSV)" Click="BtnExpReimprimirComparativa_Click" />
                                                            <ui:Button Appearance="Primary" Content="Expediente Completo" Icon="{ui:SymbolIcon DocumentText24}" FontSize="10.8" Padding="9,3" ToolTip="Abrir vista previa para imprimir o descargar en PDF el Expediente Completo consolidado (Solicitud, Comparativa, OCs, Recepciones, Facturas y Salidas)" Click="BtnExpImprimirExpedienteConsolidado_Click" />
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock x:Name="TxtExpTituloFolio" Text="Expediente Integral de Solicitud" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock x:Name="TxtExpSubtituloResumen" Text="Consulte la trazabilidad completa de principio a fin y reimprima o descargue en PDF cualquiera de sus documentos." FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- 4 TARJETAS DE RESUMEN DEL EXPEDIENTE -->
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="1. SOLICITUD Y ORIGEN" FontSize="10.5" FontWeight="Bold" Opacity="0.7" />
                                                            <TextBlock x:Name="TxtExpCard1Principal" Text="-" FontSize="13" FontWeight="Bold" Margin="0,3,0,2" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="TxtExpCard1Detalle" Text="-" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="10,8" Margin="3,0,3,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="2. COMPARATIVA Y ANEXOS" FontSize="10.5" FontWeight="Bold" Opacity="0.7" />
                                                            <TextBlock x:Name="TxtExpCard2Principal" Text="-" FontSize="13" FontWeight="Bold" Margin="0,3,0,2" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="TxtExpCard2Detalle" Text="-" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="10,8" Margin="3,0,3,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="3. ÓRDENES DE COMPRA Y FACTURAS" FontSize="10.5" FontWeight="Bold" Opacity="0.7" />
                                                            <TextBlock x:Name="TxtExpCard3Principal" Text="-" FontSize="13" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,2" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="TxtExpCard3Detalle" Text="-" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="10,8" Margin="6,0,0,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="4. RECEPCIONES Y SALIDAS ALMACÉN" FontSize="10.5" FontWeight="Bold" Opacity="0.7" />
                                                            <TextBlock x:Name="TxtExpCard4Principal" Text="-" FontSize="13" FontWeight="Bold" Margin="0,3,0,2" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="TxtExpCard4Detalle" Text="-" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <!-- SECCIÓN 1: PARTIDAS Y RESULTADO DE COMPARATIVA / ADJUDICACIÓN -->
                                                <Border Padding="10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Partidas Solicitadas, Proveedores Cotizados y Adjudicación" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                        <DataGrid x:Name="DgExpedienteSolPartidas" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="210">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="85" FontWeight="SemiBold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículo / Concepto" Binding="{Binding Articulo}" Width="*" MinWidth="160" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding CantidadTexto}" Width="65" FontWeight="Bold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding Unidad}" Width="70" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Opciones Cotizadas" Binding="{Binding OpcionesCotizadas}" Width="220" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor Adjudicado" Binding="{Binding ProveedorGanador}" Width="155" FontWeight="SemiBold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. c/IVA" Binding="{Binding PrecioUnitarioConIva, StringFormat={}{0:C2}}" Width="92" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="98" FontWeight="Bold" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Orden de Compra" Binding="{Binding FolioOc}" Width="115" FontWeight="SemiBold" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- SECCIÓN 2: ÓRDENES DE COMPRA GENERADAS (CON REIMPRESIÓN INDIVIDUAL) -->
                                                <Border Padding="10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Órdenes de Compra Emitidas (OC-xxxx) — Reimpresión Directa" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                        <DataGrid x:Name="DgExpedienteSolOrdenes" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="185">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio OC" Binding="{Binding Folio}" Width="115" FontWeight="Bold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="92" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" MinWidth="150" FontWeight="SemiBold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Condición Pago" Binding="{Binding CondicionPago}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recepción" Binding="{Binding AvanceRecepcionTexto}" Width="105" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus" Binding="{Binding Estatus}" Width="145" FontWeight="SemiBold" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="105" FontWeight="Bold" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                                <DataGridTemplateColumn Header="Acciones" Width="135">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:Button Content="Imprimir OC" FontSize="10" Padding="6,2" Margin="0,0,4,0" Tag="{Binding}" ToolTip="Vista previa, imprimir o descargar Orden de Compra (PDF / PNG / CSV)" Click="BtnExpReimprimirOc_Click" />
                                                                                <ui:Button Content="Ir →" FontSize="10" Padding="6,2" Tag="{Binding}" ToolTip="Abrir esta Orden de Compra en el módulo de Órdenes de Compra" Click="BtnExpIrAOc_Click" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- SECCIÓN 3: RECEPCIONES DE ALMACÉN Y FACTURAS / COMPROBANTES -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Padding="10" CornerRadius="6" Margin="0,0,5,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Recepciones en Almacén (ENT-xxxx)" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                            <DataGrid x:Name="DgExpedienteSolEntradas" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="165">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio Entrada" Binding="{Binding Folio}" Width="105" FontWeight="Bold" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="88" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="OC" Binding="{Binding OrdenCompraFolio}" Width="95" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                                    <DataGridTemplateColumn Header="Vale" Width="82">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <ui:Button Content="Imprimir" FontSize="10" Padding="6,2" Tag="{Binding}" ToolTip="Vista previa, imprimir o descargar Vale de Entrada (PDF / PNG / CSV)" Click="BtnExpReimprimirEntrada_Click" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1" Padding="10" CornerRadius="6" Margin="5,0,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Facturas CFDI / Notas Vinculadas" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                            <DataGrid x:Name="DgExpedienteSolFacturas" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="165">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding TipoComprobante}" Width="105" FontWeight="SemiBold" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio / UUID" Binding="{Binding SerieFolio}" Width="105" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding FechaTimbrado}" Width="88" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Emisor" Binding="{Binding EmisorNombre}" Width="*" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="OC" Binding="{Binding OrdenCompraFolio}" Width="95" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="92" FontWeight="Bold" Visibility="{DynamicResource VisibilidadPreciosPerfil}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- SECCIÓN 4: SALIDAS DE ALMACÉN Y BITÁCORA DE TRAZABILIDAD -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Padding="10" CornerRadius="6" Margin="0,0,5,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Vales de Salida / Entregas de Material (SAL-xxxx)" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                            <DataGrid x:Name="DgExpedienteSolSalidas" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="165">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio Vale" Binding="{Binding Folio}" Width="105" FontWeight="Bold" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="88" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Recibió" Binding="{Binding PersonaRecibeEfectiva}" Width="*" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Pzas." Binding="{Binding TotalUnidadesEntregadas}" Width="55" FontWeight="Bold" />
                                                                    <DataGridTemplateColumn Header="Vale" Width="82">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <ui:Button Content="Imprimir" FontSize="10" Padding="6,2" Tag="{Binding}" ToolTip="Vista previa, imprimir o descargar Vale de Salida (PDF / PNG / CSV)" Click="BtnExpReimprimirSalida_Click" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1" Padding="10" CornerRadius="6" Margin="5,0,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Bitácora de Trazabilidad y Checkpoints" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                                            <DataGrid x:Name="DgExpedienteSolBitacora" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="165">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha / Hora" Binding="{Binding FechaHora}" Width="115" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Checkpoint" Binding="{Binding CheckpointCodigo}" Width="75" FontWeight="Bold" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Documento" Binding="{Binding FolioReferencia}" Width="105" FontWeight="SemiBold" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus Nuevo" Binding="{Binding EstatusNuevo}" Width="125" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Detalle" Binding="{Binding Mensaje}" Width="*" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Datos generales">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                                        <TextBlock Text="Gerencia / Departamento *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CboSolDepartamento" SelectionChanged="CboSolDepartamento_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                                        <TextBlock Text="Responsable del área *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CboSolEncargado" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Proyecto / Destino (opcional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CboSolProyecto" ToolTip="Opcional: si se deja vacío o en Consumo Interno, se asigna al departamento solicitante" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Modalidad de solicitud" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CboSolTipoSolicitud" SelectedIndex="0">
                                                            <ComboBoxItem Content="Requerimiento de Compra" />
                                                            <ComboBoxItem Content="Solo Cotización / Presupuesto" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Notas o justificación" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtSolNotas" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" PlaceholderText="Ej. Material requerido para mantenimiento o cotización de propuesta..." />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Carga rápida">
                                        <StackPanel Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                                            <TextBlock Text="Cargar artículos desde una plantilla o una lista" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,12">
                                                <ui:Button Content="Descargar formato Excel" Margin="0,0,8,6" ToolTip="Descargar formato estándar de Solicitud en Excel (.csv)" Click="BtnExportarPlantillaSolicitud_Click" />
                                                <ui:Button Content="Importar solicitud" Margin="0,0,8,6" ToolTip="Cargar una Solicitud desde archivo Excel/CSV" Click="BtnImportarPlantillaSolicitud_Click" />
                                                <ui:Button Content="Enviar plantilla por correo a gerentes" Margin="0,0,8,6" ToolTip="Envía por correo a todos los gerentes el archivo CSV de plantilla y las instrucciones de llenado" Click="BtnEnviarPlantillaCorreoAGerentes_Click" />
                                                <ui:Button Content="Bandeja de Correo (IMAP)" Margin="0,0,8,6" ToolTip="Abrir bandeja de solicitudes recibidas por correo electrónico" Click="BtnAbrirBandejaCorreosSolicitud_Click" />
                                                <ui:Button x:Name="BtnToggleWhatsappSolicitud" Content="Pegar texto de WhatsApp" Margin="0,0,0,6" Click="BtnToggleWhatsappSolicitud_Click" />
                                            </WrapPanel>
                                            <Grid x:Name="PnlWhatsappCaptura" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox x:Name="TxtWhatsappInput"
                                                            Grid.Column="0"
                                                            MinHeight="80"
                                                            TextWrapping="Wrap"
                                                            AcceptsReturn="True"
                                                            VerticalContentAlignment="Top"
                                                            PlaceholderText="Pegue aquí el texto de WhatsApp (ej. 5 Tornillo 1/4, 2 Cable calibre 12)..." />
                                                <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Appearance="Primary" Content="Interpretar" Click="BtnInterpretarWhatsapp_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </TabItem>

                                </TabControl>
                            </DockPanel>
                        </Border>

                    </Grid>
                </TabItem>

                <!-- ==================== TAB 3: COMPARATIVA POR PRODUCTO ==================== -->
                <TabItem>
                    <DockPanel>
                        <!-- Barra Superior Compacta: Solicitud e Información a la Izquierda + Botones Apilados a la Derecha -->
                        <Border DockPanel.Dock="Top" Padding="10,7" CornerRadius="8" Margin="0,0,0,6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Izquierda: Selector + Avance en fila 1, e Información completa alineada a la izquierda en fila 2 -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Solicitud a cotizar:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,2" />
                                        <ComboBox x:Name="CboCompSolicitud"
                                                  Width="335"
                                                  Padding="8,4"
                                                  FontSize="12"
                                                  Margin="0,0,12,2"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CboCompSolicitud_SelectionChanged" />
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Margin="0,0,0,2">
                                            <TextBlock x:Name="TxtCompAvanceDecision" FontSize="11.5" Foreground="#047857" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TxtCompAutoGuardado" FontSize="11" Foreground="#047857" Opacity="0.85" VerticalAlignment="Center" Margin="10,0,0,2" ToolTip="Cada precio capturado se guarda automáticamente al salir de la celda" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtCompInfoSolicitud"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               HorizontalAlignment="Left"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap"
                                               Opacity="0.9"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Derecha: Botones organizados en 2 filas compactas (uno sobre otro) para ocupar mucho menos ancho -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Fila 1 de botones: Herramientas, Exportar/Imprimir y Guardar Borrador -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                        <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" MinHeight="26" Padding="0">
                                            <MenuItem Header="Herramientas ▾" Padding="8,3" FontSize="11.5" FontWeight="SemiBold">
                                                <MenuItem Header="🌐 Abrir Catálogo ¿A quién cotizar? (Google Sheets)" Click="BtnAbrirSheetsProveedores_Click" FontWeight="Bold" />
                                                <MenuItem Header="🔄 Sincronizar Proveedores y Categorías con Google Sheets..." Click="BtnSincronizarSheetsProveedores_Click" />
                                                <Separator />
                                                <MenuItem Header="Auto-Cotizar Insumos Rutinarios con Mejor Precio Histórico (Kraljic)" Click="BtnAutoAdjudicarRutinariosKraljic_Click" FontWeight="SemiBold" />
                                                <Separator />
                                                <MenuItem Header="Notificaciones por Correo a Gerentes (Gmail SMTP y Bitácora)" Click="BtnAbrirConfigNotificacionesCorreo_Click" />
                                                <Separator />
                                                <MenuItem Header="Matriz Estratégica de Kraljic" Click="BtnAbrirEconomiaKraljic_Click" />
                                                <MenuItem Header="Variación de Precios (PPV) e Inflación por Familia" Click="BtnAbrirEconomiaPpv_Click" />
                                            </MenuItem>
                                        </Menu>
                                        <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" MinHeight="26" Padding="0">
                                            <MenuItem Header="Exportar / Enviar ▾" Padding="8,3" FontSize="11.5" FontWeight="SemiBold">
                                                <MenuItem Header="✉ Enviar Comparativa por Correo (tabla + PDF)..." Click="BtnEnviarComparativaPorCorreo_Click" FontWeight="Bold" />
                                                <Separator />
                                                <MenuItem Header="Copiar Lista Limpia para Cotizar" Click="BtnCopiarListaParaCotizar_Click" />
                                                <MenuItem Header="Vista Previa / Imprimir Comparativa" Click="BtnImprimirComparativa_Click" />
                                                <MenuItem Header="Descargar Comparativa (PDF / PNG / CSV)" Click="BtnDescargarComparativaArchivo_Click" />
                                            </MenuItem>
                                        </Menu>
                                        <ui:Button Content="Guardar Borrador"
                                                   Appearance="Primary"
                                                   Padding="10,4"
                                                   FontSize="11.5"
                                                   Click="BtnGuardarBorradorComparativa_Click" />
                                    </StackPanel>

                                    <!-- Fila 2 de botones: Tiempo aprox. de entrega y Enviar Avance -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Entrega aprox:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Tiempo relativo de entrega para el correo de avance al gerente (se calcula según días cotizados o puede editarlo)" />
                                        <ComboBox x:Name="CboCompTiempoAproxAvance" IsEditable="True" Width="132" Padding="6,3" FontSize="11.5" Text="1 a 2 días hábiles" ToolTip="Tiempo aprox. de entrega reportado en: 'Tu cotización folio xxx está recibiendo avances, tiempo aprox de entrega xxx'">
                                            <ComboBoxItem Content="Hoy mismo" />
                                            <ComboBoxItem Content="24 a 48 hrs" />
                                            <ComboBoxItem Content="1 día hábil" />
                                            <ComboBoxItem Content="1 a 2 días hábiles" />
                                            <ComboBoxItem Content="2 a 4 días hábiles" />
                                            <ComboBoxItem Content="3 a 5 días hábiles" />
                                        </ComboBox>
                                        <ui:Button x:Name="BtnNotificarAvanceComp"
                                                   Content="Enviar Avance"
                                                   Margin="5,0,0,0"
                                                   Padding="10,4"
                                                   FontSize="11.5"
                                                   ToolTip="Guarda el borrador y envía ahora por correo al gerente el avance con el tiempo aproximado seleccionado"
                                                   Click="BtnNotificarAvanceComparativa_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pasos de la comparativa: 1 Articulos, 2 Comparar proveedores, 3 Emitir ordenes -->
                        <TabControl x:Name="TcComparativa" Padding="0,4,0,0">
                            <TabItem Header="1 &#183; Art&#237;culos">
                                <Border Padding="12" CornerRadius="8" Margin="0,0,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock Text="Artículos de la solicitud: haga clic en uno para comparar proveedores" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border x:Name="BdrTablaFinalTotalesAdjudicados" DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock x:Name="TxtGranTotalAdjudicadoComp" DockPanel.Dock="Right" Text="Gran Total Adjudicado c/IVA: $0.00" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Tabla Final: Totales por Proveedor Adjudicado" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DataGrid x:Name="DgTotalesAdjudicadosComp" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="145">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor Adjudicado" Binding="{Binding ProveedorNombre}" Width="185" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Partidas" Binding="{Binding CantidadPartidas}" Width="70" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículos / Códigos" Binding="{Binding ProductosResumen}" Width="*" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entrega" Binding="{Binding DiasEntregaMax, StringFormat={}{0} días}" Width="75" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Subtotal s/IVA" Binding="{Binding SubtotalSinIva, StringFormat={}{0:C2}}" Width="105" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Envío c/IVA" Binding="{Binding FleteConIva, StringFormat={}{0:C2}}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="IVA (16%)" Binding="{Binding IvaTotal, StringFormat={}{0:C2}}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total Adjudicado c/IVA" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="135" FontWeight="Bold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus OC" Binding="{Binding EstadoEmision}" Width="140" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid x:Name="DgComparativa"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  SelectionChanged="DgComparativa_SelectionChanged"
                                                  PreviewMouseLeftButtonUp="DgComparativa_PreviewMouseLeftButtonUp"
                                                  KeyDown="DgComparativa_KeyDown"
                                                  CellEditEnding="DgComparativa_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="80" />
                                                <DataGridTextColumn x:Name="ColCompNombrePartida" Header="Partida" Binding="{Binding NombrePartida}" Visibility="Collapsed" Width="120" IsReadOnly="True" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding Cantidad}" Width="65" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding UnidadCompra, UpdateSourceTrigger=LostFocus}" Width="75" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Stock" Binding="{Binding StockActualAlmacen}" IsReadOnly="True" Width="70" />
                                                <DataGridTextColumn x:Name="ColCompTablaProv1" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor 1" Binding="{Binding ResumenOpcion1}" IsReadOnly="True" Width="155" />
                                                <DataGridTextColumn x:Name="ColCompTablaProv2" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor 2" Binding="{Binding ResumenOpcion2}" IsReadOnly="True" Width="155" Visibility="Collapsed" />
                                                <DataGridTextColumn x:Name="ColCompTablaProv3" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor 3" Binding="{Binding ResumenOpcion3}" IsReadOnly="True" Width="155" Visibility="Collapsed" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Decisión / Ganador" Binding="{Binding EstadoDecisionTexto}" IsReadOnly="True" Width="165" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA" Binding="{Binding TotalGanadorConIva, StringFormat={}{0:C2}}" IsReadOnly="True" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                            <TabItem x:Name="TabCompDetalle" Header="2 &#183; Comparar proveedores">
                                <DockPanel>
                                    <StackPanel x:Name="PnlCompFiltroPartida" DockPanel.Dock="Top" Visibility="Collapsed"
                                                Orientation="Horizontal" Margin="8,5,8,4">
                                        <TextBlock Text="Partida" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="CboCompFiltroPartida" MinWidth="220" MaxWidth="480"
                                                  SelectionChanged="CboCompFiltroPartida_SelectionChanged" />
                                        <TextBlock x:Name="TxtCompFiltroPartida" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                <TabControl x:Name="TcModoCapturaComparativa" Padding="0,6,0,0" SelectionChanged="TcModoCapturaComparativa_SelectionChanged">
                                    <!-- MODO 1: CAPTURA POR PROVEEDOR (HOJA COMPLETA) -->
                                    <TabItem Header="Captura por Proveedor (Hoja Completa)">
                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <!-- Encabezado de Selección de Proveedor y Condiciones Generales -->
                                                <Border DockPanel.Dock="Top" Padding="12" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <ui:Button x:Name="BtnCargarHistoricoProveedorHoja"
                                                                           Content="Cargar Histórico"
                                                                           FontSize="10.5"
                                                                           Padding="7,3"
                                                                           Margin="0,0,4,0"
                                                                           ToolTip="Rellena automáticamente los precios vigentes o históricos que ya se le hayan cotizado a este proveedor"
                                                                           Click="BtnCargarHistoricoProveedorHoja_Click" />
                                                                <ui:Button x:Name="BtnAdjudicarTodoHojaProveedor"
                                                                           Appearance="Primary"
                                                                           Content="✓ Adjudicar Cotizados"
                                                                           FontSize="10.5"
                                                                           Padding="8,3"
                                                                           ToolTip="Marca como ganador a este proveedor en todas las partidas donde tenga precio capturado"
                                                                           Click="BtnAdjudicarTodoHojaProveedor_Click" />
                                                            </StackPanel>
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock Text="1. Columna:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,1,6,1" />
                                                                <ui:Button x:Name="BtnHojaSlot1" Content="Proveedor 1" Appearance="Primary" FontSize="10.5" Padding="7,3" Margin="0,1,4,1" Click="BtnHojaSlot1_Click" />
                                                                <ui:Button x:Name="BtnHojaSlot2" Content="Proveedor 2" FontSize="10.5" Padding="7,3" Margin="0,1,4,1" Click="BtnHojaSlot2_Click" />
                                                                <ui:Button x:Name="BtnHojaSlot3" Content="Proveedor 3" FontSize="10.5" Padding="7,3" Margin="0,1,4,1" Click="BtnHojaSlot3_Click" />
                                                                <WrapPanel x:Name="WpBotonesSlotsExtraHoja" Orientation="Horizontal" VerticalAlignment="Center" />
                                                                <ui:Button x:Name="BtnHojaAgregarSlotProveedor" Content="+ Proveedor" FontSize="10.5" Padding="7,3" Margin="0,1,4,1" ToolTip="Agregar otra columna / hoja de proveedor concursante a esta comparativa" Click="BtnHojaAgregarSlotProveedor_Click" />
                                                            </WrapPanel>
                                                        </DockPanel>

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,2" VerticalAlignment="Center">
                                                                <TextBlock Text="2. Proveedor:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <ComboBox x:Name="CboHojaProveedor" Width="270" DisplayMemberPath="EtiquetaSelectorComparativa" SelectedValuePath="Id" SelectionChanged="CboHojaProveedor_SelectionChanged" />
                                                                <ui:Button Content="+ Nuevo" FontSize="10.5" Padding="7,3" Margin="5,0,0,0" ToolTip="Dar de alta un nuevo proveedor en el directorio" Click="BtnNuevoProveedorDesdeComp_Click" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Entrega (días):" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85" />
                                                                <ui:TextBox x:Name="TxtHojaDiasEntregaGral" Width="48" Text="3" ToolTip="Días de entrega generales de esta cotización" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Vigencia (días):" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85" />
                                                                <ui:TextBox x:Name="TxtHojaDiasVigenciaGral" Width="48" Text="15" ToolTip="Días de vigencia general de los precios cotizados por este proveedor" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Envío c/IVA ($):" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85" />
                                                                <ui:TextBox x:Name="TxtHojaFleteGral" Width="68" Text="0.00" ToolTip="Flete global de esta cotización (se asigna a la primera partida cotizada o puede ajustarse por renglón)" />
                                                            </StackPanel>

                                                            <ui:Button x:Name="BtnAplicarCondicionesGeneralesHoja"
                                                                       Content="Aplicar a hoja"
                                                                       FontSize="10.5"
                                                                       Padding="8,3"
                                                                       Margin="0,0,0,2"
                                                                       ToolTip="Aplica el proveedor, días de entrega, vigencia y flete a todos los artículos de esta hoja"
                                                                       Click="BtnAplicarCondicionesGeneralesHoja_Click" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Barra inferior de totales de la hoja -->
                                                <Border DockPanel.Dock="Bottom" Padding="10,8" CornerRadius="6" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtResumenHojaProveedorActual"
                                                                   DockPanel.Dock="Right"
                                                                   FontWeight="Bold"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Text="Cotizados: 0/0 · Total Hoja c/IVA: $0.00" />
                                                        <TextBlock Text="Tip: Capture hacia abajo en la columna 'P.U. SIN IVA' o 'P.U. CON IVA' (use Enter o Tab para bajar de renglón como en Excel). Los cambios se guardan al instante."
                                                                   FontSize="11.5"
                                                                   Opacity="0.82"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </Border>

                                                <!-- Tabla tipo Hoja de Cálculo para capturar toda la cotización del proveedor de corrido -->
                                                <DataGrid x:Name="DgHojaCotizacionProveedor"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          LostKeyboardFocus="DgComparativaEdicion_LostKeyboardFocus"
                                                          SelectionChanged="DgHojaCotizacionProveedor_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" Width="82" IsReadOnly="True" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículo / Descripción" Binding="{Binding ProductoNombre}" Width="*" MinWidth="170" IsReadOnly="True" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding Cantidad}" Width="52" IsReadOnly="True" FontWeight="Bold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding UnidadCompra, UpdateSourceTrigger=LostFocus}" Width="68" IsReadOnly="False" />

                                                        <DataGridTextColumn Header="P.U. s/IVA" Binding="{Binding PrecioSinIva, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="86" FontWeight="Bold" />
                                                        <DataGridTextColumn Header="P.U. c/IVA" Binding="{Binding PrecioConIva, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="86" />
                                                        <DataGridTextColumn Header="Entrega (d)" Binding="{Binding DiasEntrega, UpdateSourceTrigger=LostFocus}" Width="78" />
                                                        <DataGridTextColumn Header="Vigencia (d)" Binding="{Binding DiasVigencia, UpdateSourceTrigger=LostFocus}" Width="82" />
                                                        <DataGridTextColumn Header="Envío c/IVA" Binding="{Binding FleteConIva, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="86" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA" Binding="{Binding ImporteTotalConIva, StringFormat={}{0:C2}}" Width="98" IsReadOnly="True" FontWeight="Bold" />
                                                        <DataGridTextColumn Header="Notas / Marca" Binding="{Binding NotasCotizacion, UpdateSourceTrigger=LostFocus}" Width="125" />
                                                        <DataGridCheckBoxColumn Header="Adjudicar" Binding="{Binding EsGanadorEnEstaOpcion, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <!-- MODO 2: MATRIZ COMPARATIVA LADO A LADO -->
                                    <TabItem Header="Matriz Comparativa (Lado a Lado)">
                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Padding="10" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <CheckBox x:Name="ChkMatrizMostrarTotalConIva"
                                                                      Content="Mostrar Total c/IVA"
                                                                      FontSize="11.5"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,12,0"
                                                                      Checked="ChkMatrizMostrarTotalConIva_Changed"
                                                                      Unchecked="ChkMatrizMostrarTotalConIva_Changed"
                                                                      ToolTip="Muestra u oculta la segunda columna de Total c/IVA por cada proveedor" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Proveedores a comparar" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                            <WrapPanel>
                                                                <ComboBox x:Name="CboMatrizProveedor1" AutomationProperties.Name="Primer proveedor" DisplayMemberPath="Etiqueta" Width="175" Margin="0,0,6,4" SelectionChanged="CboMatrizProveedor_SelectionChanged" />
                                                                <ComboBox x:Name="CboMatrizProveedor2" AutomationProperties.Name="Segundo proveedor" DisplayMemberPath="Etiqueta" Width="175" Margin="0,0,6,4" SelectionChanged="CboMatrizProveedor_SelectionChanged" />
                                                                <ComboBox x:Name="CboMatrizProveedor3" AutomationProperties.Name="Tercer proveedor" DisplayMemberPath="Etiqueta" Width="175" Margin="0,0,6,4" SelectionChanged="CboMatrizProveedor_SelectionChanged" />
                                                            </WrapPanel>
                                                            <TextBlock x:Name="TxtMatrizSinProveedores" Text="Agrega un proveedor desde la hoja de captura o el detalle del artículo." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <DataGrid x:Name="DgMatrizComparativaRapida"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          SelectionChanged="DgMatrizComparativaRapida_SelectionChanged"
                                                          LostKeyboardFocus="DgComparativaEdicion_LostKeyboardFocus">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Articulo.ProductoCodigo}" Width="80" IsReadOnly="True" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículo" Binding="{Binding Articulo.ProductoNombre}" Width="*" MinWidth="160" IsReadOnly="True" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding Articulo.Cantidad}" Width="50" IsReadOnly="True" FontWeight="Bold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding Articulo.UnidadCompra}" Width="66" IsReadOnly="True" />
                                                        <DataGridTextColumn x:Name="ColMatrizProv1" Header="P.U. Prov 1" Binding="{Binding Precio1, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="112" />
                                                        <DataGridTextColumn x:Name="ColMatrizTotal1" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA (1)" Binding="{Binding Total1, StringFormat={}{0:C2}}" Width="92" IsReadOnly="True" Visibility="Collapsed" />
                                                        <DataGridTextColumn x:Name="ColMatrizProv2" Header="P.U. Prov 2" Binding="{Binding Precio2, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="112" />
                                                        <DataGridTextColumn x:Name="ColMatrizTotal2" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA (2)" Binding="{Binding Total2, StringFormat={}{0:C2}}" Width="92" IsReadOnly="True" Visibility="Collapsed" />
                                                        <DataGridTextColumn x:Name="ColMatrizProv3" Header="P.U. Prov 3" Binding="{Binding Precio3, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="112" />
                                                        <DataGridTextColumn x:Name="ColMatrizTotal3" ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total c/IVA (3)" Binding="{Binding Total3, StringFormat={}{0:C2}}" Width="92" IsReadOnly="True" Visibility="Collapsed" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Adjudicado Actual" Binding="{Binding Articulo.EstadoDecisionTexto}" Width="150" IsReadOnly="True" FontWeight="SemiBold" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <!-- MODO 3: DETALLE POR ARTÍCULO INDIVIDUAL (TARJETAS) -->
                                    <TabItem Header="Detalle por Artículo Individual">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <!-- Encabezado del Producto Seleccionado -->
                                    <Border DockPanel.Dock="Top" Padding="12" CornerRadius="4" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <!-- Fila 1: Título y Subtítulo del Producto (Con ajuste de línea completo para no empujar ningún botón) -->
                                            <DockPanel Margin="0,0,0,2">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="Artículo:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.85" />
                                                    <ComboBox x:Name="CboCompSelectorArticuloDetalle" DisplayMemberPath="EtiquetaSelectorDetalle" MinWidth="250" MaxWidth="420" SelectionChanged="CboCompSelectorArticuloDetalle_SelectionChanged" ToolTip="Cambiar rápidamente a otro artículo de la solicitud" />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtCompProdTitulo"
                                                       Text="Seleccione un artículo en el paso 1"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock x:Name="TxtCompProdSubtitulo"
                                                       Text="Capture la cotización del proveedor o use '+ Añadir Proveedor Concursante' para comparar más proveedores."
                                                       FontSize="11.5"
                                                       Opacity="0.82"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />

                                            <!-- Fila 2: Barra de Controles y Botones de Proveedores Concursantes (Siempre visible) -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Cant.:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtCompProdCantidad" Width="64" Text="1" TextChanged="TxtCompProdCantidad_TextChanged" />
                                                    <TextBlock Text="Unidad:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0" />
                                                    <ComboBox x:Name="CboCompProdUnidad" IsEditable="True" Width="95" SelectionChanged="CboCompProdUnidad_SelectionChanged" LostFocus="CboCompProdUnidad_LostFocus" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Vigencia (días):" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtCompDiasVigencia" Width="54" Text="15" TextChanged="TxtCompExtras_TextChanged" />
                                                </StackPanel>

                                                <WrapPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ui:Button Content="← Ant."
                                                               FontSize="10.5"
                                                               Padding="7,3"
                                                               Margin="0,0,4,0"
                                                               ToolTip="Pasar al artículo anterior de la lista"
                                                               Click="BtnCompAnterior_Click" />
                                                    <ui:Button Content="Sig. →"
                                                               FontSize="10.5"
                                                               Padding="7,3"
                                                               Margin="0,0,4,0"
                                                               ToolTip="Pasar al siguiente artículo de la lista"
                                                               Click="BtnCompSiguiente_Click" />
                                                    <ui:Button x:Name="BtnAgregarOpcionProveedorComp"
                                                               Content="+ Opción Cotización"
                                                               Appearance="Primary"
                                                               FontSize="10.5"
                                                               Padding="8,3"
                                                               Margin="0,0,4,0"
                                                               ToolTip="Añade otra tarjeta u opción de proveedor concursante para comparar precios en este artículo"
                                                               Click="BtnAgregarOpcionProveedorComp_Click" />
                                                    <ui:Button x:Name="BtnNuevoProveedorRapidoComp" Content="+ Nuevo Prov." FontSize="10.5" Padding="7,3" Margin="0,0,4,0" ToolTip="Registrar un nuevo proveedor con su Nombre Comercial para usar en la comparativa" Click="BtnNuevoProveedorRapidoComp_Click" />
                                                    <ui:Button x:Name="BtnVincularLineaAbiertaComp" Content="Asociar SKU" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Vincula o convierte esta partida de Línea Abierta a un Producto (SKU) del Catálogo conservando todas sus cotizaciones y vigencias" Click="BtnVincularLineaAbiertaComp_Click" />
                                                    <ui:Button Content="Sin Decidir"
                                                               FontSize="10.5"
                                                               Padding="7,3"
                                                               ToolTip="Limpia la decisión de proveedor ganador en este artículo"
                                                               Click="BtnLimpiarGanadorProductoActual_Click" />
                                                </WrapPanel>
                                            </Grid>

                                            <TextBlock x:Name="TxtCompProdHistorial"
                                                       Margin="0,6,0,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" />

                                            <!-- Selector de Compras Históricas de Artículos Similares / Misma Familia -->
                                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Compras / Cotizaciones Similares:"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <ComboBox x:Name="CboCompReferenciasSimilares"
                                                              Grid.Column="1"
                                                              FontSize="11"
                                                              Margin="0,0,6,0"
                                                              DisplayMemberPath="EtiquetaCombo" />
                                                    <ui:Button Grid.Column="2"
                                                               Content="Usar en Op. 1"
                                                               FontSize="10.5"
                                                               Padding="8,3"
                                                               Margin="0,0,4,0"
                                                               ToolTip="Carga el proveedor y precio de esta referencia histórica en la Opción 1"
                                                               Click="BtnAplicarReferenciaSimilarOp1_Click" />
                                                    <ui:Button Grid.Column="3"
                                                               Content="+ En Nueva Opción"
                                                               FontSize="10.5"
                                                               Padding="8,3"
                                                               ToolTip="Abre otra tarjeta de proveedor (Opción 2 o 3) con esta referencia histórica para comparar"
                                                               Click="BtnAplicarReferenciaSimilarNuevaOp_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjetas de Cotización Exclusivas del Producto Seleccionado (1 por defecto, hasta N proveedores concursantes) -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Ofertas del artículo" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                                            <TextBlock x:Name="TxtCompSinOfertas" Text="Aún no hay proveedores asignados a este artículo." Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgCompOfertasArticulo" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="235" Margin="0,0,0,10">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="2*" />
                                                    <DataGridTextColumn Header="P.U. s/IVA" Binding="{Binding Precio, StringFormat={}{0:C2}}" Width="105" />
                                                    <DataGridTextColumn Header="Entrega (días)" Binding="{Binding Entrega}" Width="105" />
                                                    <DataGridTextColumn Header="Vigencia" Binding="{Binding Vigencia}" Width="190" />
                                                    <DataGridTextColumn Header="Envío c/IVA" Binding="{Binding Flete, StringFormat={}{0:C2}}" Width="105" />
                                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="95" />
                                                    <DataGridTemplateColumn Header="Acción" Width="105">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ui:Button Content="Adjudicar" IsEnabled="{Binding PuedeAdjudicar}" Click="BtnAdjudicarOfertaArticulo_Click" Padding="7,2" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <UniformGrid x:Name="UgTarjetasComparativa" Columns="1">
                                                <!-- OPCIÓN 1 -->
                                                <Border x:Name="BdrCompCard1" Margin="0,0,5,0" Padding="10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1.5">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Border x:Name="BdrBadgeGanador1" DockPanel.Dock="Right" Padding="6,2" CornerRadius="4" Background="#059669" Margin="6,0,0,0" Visibility="Collapsed">
                                                                <TextBlock Text="SELECCIONADO" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                            <TextBlock x:Name="TxtTituloCardComp1" Text="Proveedor 1" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Text="Proveedor que cotiza este artículo" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="CboCompProv1" Margin="0,0,0,8" SelectionChanged="CboCompProveedores_SelectionChanged" />

                                                        <TextBlock Text="Precio Unitario SIN IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioSinIva1" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioSinIva1_TextChanged" />

                                                        <TextBlock Text="Precio Unitario CON IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioConIva1" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioConIva1_TextChanged" />

                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompFlete1" Text="0.00" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0">
                                                                <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompDias1" Text="2" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Text="Notas / Marca ofertada" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Vigencia Cot. (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompVigencia1" Text="15" ToolTip="Días de vigencia del precio cotizado por este proveedor" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0" VerticalAlignment="Bottom">
                                                                <TextBlock Text="Estado de Vigencia" FontSize="10" Opacity="0.75" Margin="0,0,0,2" />
                                                                <TextBlock x:Name="TxtEstadoVigenciaCard1" Text="Sin cotizar" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,4" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <ui:TextBox x:Name="TxtCompNotas1" Margin="0,0,0,8" PlaceholderText="Ej. Entrega inmediata..." TextChanged="TxtCompExtras_TextChanged" />

                                                        <Border Padding="8" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,0,8">
                                                            <TextBlock x:Name="TxtResumenProv1" Text="Subtotal: $0.00&#x0a;Total c/IVA: $0.00" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" />
                                                        </Border>

                                                        <ui:Button x:Name="BtnElegirGanador1"
                                                                   HorizontalAlignment="Stretch"
                                                                   Content="Elegir Opción 1"
                                                                   Click="BtnElegirGanador1_Click" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- OPCIÓN 2 -->
                                                <Border x:Name="BdrCompCard2" Visibility="Collapsed" Margin="3,0,3,0" Padding="10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="#498205" BorderThickness="1.5">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                <Border x:Name="BdrBadgeGanador2" Padding="6,2" CornerRadius="4" Background="#059669" Margin="0,0,4,0" Visibility="Collapsed">
