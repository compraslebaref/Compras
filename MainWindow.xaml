                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Variación del Precio de Compra (PPV) e Inflación Interna por Familia" FontSize="14.5" FontWeight="Bold" />
                                                        <TextBlock Text="PPV = (Precio Promedio Histórico - Último Precio Pagado) × Cantidad. Valores positivos indican ahorro real; negativos indican inflación o sobreprecio." FontSize="11.2" Opacity="0.75" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="DgAnalisisPpv" AutoGenerateColumns="False" IsReadOnly="True">
