                                    <TabItem Header="Proveedores">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Content="🌐 ¿A quién cotizar? (Sheets)" FontSize="11" Padding="8,4" Margin="0,0,6,0" ToolTip="Abrir en Google Sheets el catálogo de proveedores por categoría para los auxiliares" Click="BtnAbrirSheetsProveedores_Click" />
                                                    <ui:Button Content="🔄 Sincronizar Sheets" Appearance="Primary" FontSize="11" Padding="8,4" ToolTip="Sincronizar proveedores, teléfonos y categorías entre el ERP y Google Sheets" Click="BtnSincronizarSheetsProveedores_Click" />
