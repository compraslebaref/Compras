                <!-- ==================== TAB 4: ÓRDENES DE COMPRA (Lista → Detalle) ==================== -->
                <TabItem>
                    <Grid>

                        <!-- ===== VISTA 1: LISTA + FICHA DE ÓRDENES DE COMPRA (similar al Catálogo) ===== -->
