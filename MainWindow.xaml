<ui:FluentWindow x:Class="SistemaComprasAlmacen.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Lebaref | Departamento de Compras"
                 Width="1440"
                 Height="900"
                 MinWidth="1180"
                 MinHeight="740"
                 WindowStartupLocation="CenterScreen"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título limpia -->
        <ui:TitleBar Grid.Row="0"
                     Title="Lebaref | Departamento de Compras"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- Barra Superior Unificada en 1 Sola Franja: Menús + Escáner Omnisciente + Mapa y Perfil -->
        <Border Grid.Row="1"
                Margin="14,2,14,8"
                Padding="10,6"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: 5 Menús Desplegables Globales -->
                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0">
                    <MenuItem Header="📦 Almacén ▾" Padding="7,4">
                        <MenuItem Header="🗺️ Mapa Gráfico de Anaqueles (A–F y PISO)" InputGestureText="F4" Click="BtnAbrirMapaAnaqueles_Click" />
                        <MenuItem Header="🔍 Ir al Catálogo Visual de Productos" InputGestureText="F3" Click="MenuIrCatalogo_Click" />
                        <MenuItem Header="➕ Dar de Alta Nuevo Producto en Catálogo" Click="MenuNuevoProductoCatalogo_Click" />
                        <Separator />
                        <MenuItem Header="📥 Registrar Entrada a Almacén (Recepción OC)" Click="BtnIrRecepciones_Click" />
                        <MenuItem Header="📤 Registrar Salida de Material (Vale de Salida)" Click="BtnIrAlmacenPos_Click" />
                        <MenuItem Header="🔄 Devolver Material Sobrante a Almacén" Click="BtnDevolverMaterialSalida_Click" />
                        <Separator />
                        <MenuItem Header="🏷️ Imprimir Catálogo de Códigos de Barras" Click="BtnImprimirCatalogoCodigos_Click" />
                    </MenuItem>

                    <MenuItem Header="📋 Compras ▾" Padding="7,4">
                        <MenuItem Header="📝 Nueva Solicitud de Compra" Click="MenuNuevaSolicitud_Click" />
                        <MenuItem Header="📥 Importar Solicitud desde Plantilla Excel / Web (.csv)" Click="BtnImportarPlantillaSolicitud_Click" />
                        <MenuItem Header="📄 Descargar Formato Estándar de Solicitud (.csv)" Click="BtnExportarPlantillaSolicitud_Click" />
                        <MenuItem Header="📊 Exportar Existencias Actuales de Almacén (.csv)" Click="BtnExportarExistenciasCatalogo_Click" />
                        <Separator />
                        <MenuItem Header="⚖️ Ir a Cuadro Comparativo de Cotizaciones" Click="MenuIrComparativa_Click" />
                        <MenuItem Header="🧾 Consultar y Emitir Órdenes de Compra" Click="BtnIrRecepciones_Click" />
                        <MenuItem Header="📂 Importar y Consultar Facturas CFDI (XML)" Click="MenuIrFacturasXml_Click" />
                    </MenuItem>

                    <MenuItem Header="🔧 Herramientas ▾" Padding="7,4">
                        <MenuItem Header="🤝 Vale de Préstamo / Devolución de Herramientas" Click="BtnIrAlmacenPos_Click" />
                        <MenuItem Header="🔧 Directorio Individual de Herramientas (HER-xxxx)" Click="MenuIrDirectorioHerramientas_Click" />
                        <MenuItem Header="🗺️ Consultar Herramientas por Cuadrante (Mapa A–F)" Click="BtnAbrirMapaAnaqueles_Click" />
                        <Separator />
                        <MenuItem Header="🦺 Generar e Imprimir Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                    </MenuItem>

                    <MenuItem Header="📊 Reportes ▾" Padding="7,4">
                        <MenuItem Header="📈 Ranking de Materiales y Proyección de Compras" Click="MenuIrAnalisisRanking_Click" />
                        <MenuItem Header="📉 Gráficas e Historial de Precios por Producto" Click="MenuIrAnalisisGraficas_Click" />
                        <MenuItem Header="🗺️ Exportar Inventario por Cuadrante / Anaquel (CSV)" Click="BtnAbrirMapaAnaqueles_Click" />
                        <Separator />
                        <MenuItem Header="🔄 Actualizar / Refrescar Todo el Sistema" InputGestureText="F5" Click="MenuRefrescarSistema_Click" />
                    </MenuItem>

                    <MenuItem Header="⚙️ Sistema ▾" Padding="7,4">
                        <MenuItem Header="🔓 Activar / Cerrar Sesión Perfil Administrador" Click="BtnPerfilAdmin_Click" />
                        <MenuItem Header="🔑 Cambiar PIN de Administrador" Click="BtnCambiarPinAdmin_Click" />
                        <MenuItem Header="💾 Crear Respaldo Local de Base de Datos (SQLite)" Click="BtnRespaldarDb_Click" />
                        <Separator />
                        <MenuItem Header="📚 Directorios Maestros (Proveedores, Proyectos, Personal)" Click="MenuIrDirectorios_Click" />
                    </MenuItem>
                </Menu>

                <!-- Centro: Escáner Omnisciente -->
                <Grid Grid.Column="1" Margin="4,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="BarcodeScanner24"
                                   FontSize="18"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#0078D4" />
                    <ui:TextBox x:Name="TxtOmniScanner"
                                Grid.Column="1"
                                PlaceholderText="Escanear código o folio (F2: Escáner | F3: Catálogo | F4: Mapa A–F)..."
                                VerticalContentAlignment="Center"
                                FontSize="12.5"
                                FontFamily="Consolas"
                                PreviewKeyDown="TxtOmniScanner_KeyDown"
                                TextChanged="TxtOmniScanner_TextChanged" />
                    <ui:Button Grid.Column="2"
                               Margin="6,0,0,0"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Search24}"
                               Content="Buscar"
                               Click="BtnProcesarOmniScanner_Click" />
                </Grid>

                <!-- Derecha: Botones Ejecutivos (Mapa A–F, Tema Claro/Oscuro y Perfil) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="🗺️ Mapa A–F"
                               FontSize="11.5"
                               Padding="10,5"
                               Margin="0,0,6,0"
                               ToolTip="Abrir Mapa Gráfico 3x3 e Inventario por Cuadrante (Atajo: F4)"
                               Click="BtnAbrirMapaAnaqueles_Click" />
                    <ui:Button x:Name="BtnAlternarTema"
                               Content="🌙 Oscuro"
                               FontSize="11.5"
                               Padding="10,5"
                               Margin="0,0,6,0"
                               ToolTip="Alternar entre Modo Claro de Alto Contraste (Bodega) y Modo Oscuro Slate (Oficina)"
                               Click="BtnAlternarTema_Click" />
                </StackPanel>
                <ui:Button x:Name="BtnPerfilAdmin"
                           Grid.Column="3"
                           Content="Perfil: Estándar"
                           FontSize="11.5"
                           Padding="10,5"
                           ToolTip="Activar o cerrar sesión de Perfil Administrador (PIN por defecto: 1234)"
                           Click="BtnPerfilAdmin_Click" />
            </Grid>
        </Border>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebarNavegacion" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú Lateral Ejecutivo con Secciones, Badges en Vivo y Modo Colapsable -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="10,12"
                    CornerRadius="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource CardElevationShadow}">
                <DockPanel LastChildFill="False">
                    <!-- Cabecera de Identidad Corporativa + Botón Colapsar -->
                    <Border DockPanel.Dock="Top"
                            Padding="8,6"
                            Margin="0,0,0,10"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="#2563EB"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BoxMultiple24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="PnlMarcaSidebar" Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="LEBAREF" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB" />
                                <TextBlock Text="Compras &amp; WMS" FontSize="10.5" Opacity="0.72" />
                            </StackPanel>
                            <ui:Button x:Name="BtnToggleSidebar"
                                       Grid.Column="2"
                                       Content="⟪"
                                       Padding="6,3"
                                       FontSize="11"
                                       ToolTip="Contraer o expandir menú lateral para ganar espacio en pantalla"
                                       Click="BtnToggleSidebar_Click" />
                        </Grid>
                    </Border>

                    <!-- Navegación Agrupada por Flujo de Trabajo con Contadores Dinámicos -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="LblSecGeneral" Text="OPERACIÓN GENERAL" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,2,0,4" />

                            <ui:Button x:Name="NavDashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Appearance="Primary" Icon="{ui:SymbolIcon Home24}" Content="Inicio" ToolTip="Inicio y Resumen Ejecutivo" Click="NavButton_Click" Tag="0" />

                            <Grid>
                                <ui:Button x:Name="NavCatalogo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon Grid24}" Content="Catálogo" ToolTip="Catálogo Visual, Alertas y Coordenadas 3x3 (Atajo: F3)" Click="NavButton_Click" Tag="1" />
                                <Border x:Name="BdgSidebarAlertas" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="10" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarAlertas" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#991B1B" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="LblSecCompras" Text="ABASTECIMIENTO Y COMPRAS" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,10,0,4" />

                            <Grid>
                                <ui:Button x:Name="NavSolicitudes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon ClipboardTaskListLtr24}" Content="Solicitudes" ToolTip="Solicitudes de Compra y Carritos" Click="NavButton_Click" Tag="2" />
                                <Border x:Name="BdgSidebarSolicitudes" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="10" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarSolicitudes" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavComparativa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon Scales24}" Content="Comparativa" ToolTip="Cuadro Comparativo Multiproveedor" Click="NavButton_Click" Tag="3" />

                            <Grid>
                                <ui:Button x:Name="NavOrdenes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon DocumentText24}" Content="Órdenes de Compra" ToolTip="Órdenes de Compra y Recepción de Mercancía" Click="NavButton_Click" Tag="4" />
                                <Border x:Name="BdgSidebarOcs" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="10" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarOcs" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavFacturasXml" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon ReceiptMoney24}" Content="Facturas" ToolTip="Facturas CFDI 4.0 y Notas de Compra" Click="NavButton_Click" Tag="6" />

                            <TextBlock x:Name="LblSecAlmacen" Text="BODEGA Y CONTROL" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,10,0,4" />

                            <Grid>
                                <ui:Button x:Name="NavAlmacenPos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon Box24}" Content="Almacén" ToolTip="Salidas de Almacén y Préstamos de Herramientas" Click="NavButton_Click" Tag="5" />
                                <Border x:Name="BdgSidebarPrestamos" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="10" Background="#F3E8FF" BorderBrush="#D8B4FE" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarPrestamos" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#6B21A8" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavAnalisis" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon DataTrending24}" Content="Análisis" ToolTip="Ranking de Consumo e Historial Gráfico de Precios" Click="NavButton_Click" Tag="7" />
                            <ui:Button x:Name="NavDirectorios" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="10,9" Icon="{ui:SymbolIcon Settings24}" Content="Directorios" ToolTip="Proveedores, Proyectos, Personal y Herramientas" Click="NavButton_Click" Tag="8" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="PnlFooterSidebar"
                            DockPanel.Dock="Bottom"
                            CornerRadius="8"
                            Padding="10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatusCarrito"
                                       Text="Solicitud: 0 artículos"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       FontSize="12" />
                            <TextBlock x:Name="TxtUltimoEscaneo"
                                       Text="Escáner listo"
                                       FontSize="11"
                                       Opacity="0.72"
                                       Margin="0,2,0,8"
                                       TextWrapping="Wrap" />
                            <ui:Button Content="Respaldar Datos"
                                       Icon="{ui:SymbolIcon Database24}"
                                       HorizontalAlignment="Stretch"
                                       FontSize="11.5"
                                       Click="BtnRespaldarDb_Click" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Contenedor de Vistas -->
            <TabControl x:Name="MainTabControl"
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ==================== TAB 0: INICIO ==================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="🗺️ Abrir Mapa de Bodega 3×3" Margin="0,0,8,0" Click="BtnAbrirMapaAnaqueles_Click" />
                                    <ui:Button Content="+ Nueva Solicitud" Appearance="Primary" Click="MenuNuevaSolicitud_Click" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Panel de Control Ejecutivo" FontSize="21" FontWeight="Bold" />
                                    <TextBlock Text="Haz clic en cualquier indicador KPI para navegar directamente al módulo correspondiente." FontSize="11.5" Opacity="0.7" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <UniformGrid Columns="5" Margin="0,0,0,16">
                                <!-- KPI 1: Solicitudes Pendientes -->
                                <Border Margin="0,0,8,0" Padding="14,12" CornerRadius="10" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#93C5FD" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para abrir Solicitudes de Compra pendientes"
                                        MouseLeftButtonUp="KpiCardSolicitudes_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SOLICITUDES PENDIENTES" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiSolicitudes" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,2" />
                                            <TextBlock Text="Ir a Solicitudes →" FontSize="10.5" Foreground="#2563EB" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" Foreground="#1D4ED8" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 2: Órdenes Abiertas -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="10" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#FDBA74" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para ir a Recepción de Órdenes de Compra abiertas"
                                        MouseLeftButtonUp="KpiCardOrdenes_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ÓRDENES ABIERTAS" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiOcsAbiertas" Text="0" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,2" />
                                            <TextBlock Text="Recibir Mercancía →" FontSize="10.5" Foreground="#EA580C" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#FFEDD5" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="DocumentText24" Foreground="#C2410C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 3: Alertas Stock Mínimo -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="10" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#FCA5A5" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para filtrar productos con Stock Mínimo mayor al Actual"
                                        MouseLeftButtonUp="KpiCardAlertas_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DÉFICIT DE STOCK" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiStockBajo" Text="0" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,2" />
                                            <TextBlock Text="Reabastecer Stock →" FontSize="10.5" Foreground="#DC2626" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="Warning24" Foreground="#B91C1C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 4: Herramientas Prestadas -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="10" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#D8B4FE" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para gestionar préstamos y devoluciones de herramientas"
                                        MouseLeftButtonUp="KpiCardHerramientas_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="EN RESGUARDO (HER)" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiHerramientasPrestadas" Text="0" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,2" />
                                            <TextBlock Text="Ver Préstamos →" FontSize="10.5" Foreground="#7C3AED" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#F3E8FF" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="Wrench24" Foreground="#6D28D9" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 5: Compras Totales -->
                                <Border Margin="4,0,0,0" Padding="14,12" CornerRadius="10" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#86EFAC" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para abrir Analítica e Historial de Compras"
                                        MouseLeftButtonUp="KpiCardAnalisis_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="COMPRAS ACUMULADAS" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiGastoTotal" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,4" />
                                            <TextBlock Text="Ver Analítica →" FontSize="10.5" Foreground="#16A34A" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#DCFCE7" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="DataTrending24" Foreground="#15803D" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Calendario Mensual Interactivo -->
                                <Border Grid.Column="0" Margin="0,0,8,0" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="Ver Todo" FontSize="11" Padding="8,3" Margin="8,0,0,0" Click="BtnVerTodasFechasCalendario_Click" />
                                            <TextBlock Text="Calendario Operativo" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <Calendar x:Name="CalDashboard"
                                                  HorizontalAlignment="Center"
                                                  SelectedDatesChanged="CalDashboard_SelectedDatesChanged" />
                                        <TextBlock x:Name="TxtResumenCalendarioDashboard"
                                                   Text="Seleccione un día para filtrar o agregue un recordatorio a la derecha."
                                                   FontSize="11"
                                                   Opacity="0.78"
                                                   TextWrapping="Wrap"
                                                   Margin="2,6,2,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Agenda de Recordatorios, Entregas OC y Vencimientos -->
                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtFiltroFechaAgenda" DockPanel.Dock="Right" Margin="8,0,0,0" Text="Mostrando: Todos los eventos próximos" FontSize="11.5" Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="Recordatorios, Seguimiento de Compras y Entregas" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>

                                            <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <DatePicker x:Name="DpEventoFecha" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <ui:TextBox x:Name="TxtEventoTitulo" Grid.Column="1" Margin="0,0,6,0" PlaceholderText="Nuevo recordatorio o pendiente (ej. Pagar nota, Revisar llegada de material)..." />
                                                    <ComboBox x:Name="CboEventoCategoria" Grid.Column="2" Margin="0,0,6,0" SelectedIndex="0">
                                                        <ComboBoxItem Content="Recordatorio Manual" />
                                                        <ComboBoxItem Content="Entrega OC" />
                                                        <ComboBoxItem Content="Pago a Proveedor" />
                                                        <ComboBoxItem Content="Préstamo Herramienta" />
                                                        <ComboBoxItem Content="Inventario / Auditoría" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="CboEventoPrioridad" Grid.Column="3" Margin="0,0,6,0" SelectedIndex="1">
                                                        <ComboBoxItem Content="Alta" />
                                                        <ComboBoxItem Content="Media" />
                                                        <ComboBoxItem Content="Baja" />
                                                    </ComboBox>
                                                    <ui:Button Grid.Column="4" Appearance="Primary" Content="+ Agendar" Click="BtnAgregarEventoCalendario_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <DataGrid x:Name="DgDashboardAgenda" AutoGenerateColumns="False" IsReadOnly="True" Height="215" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="95" />
                                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="140" />
                                                <DataGridTextColumn Header="Evento / Recordatorio" Binding="{Binding Titulo}" Width="*" />
                                                <DataGridTextColumn Header="Detalle / Referencia" Binding="{Binding Descripcion}" Width="210" />
                                                <DataGridTemplateColumn Header="Prioridad" Width="85">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Prioridad}">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Estado" Width="115">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding EstatusTexto}">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Acciones" Width="135">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Button Content="Completar" Padding="6,2" Margin="0,0,4,0" ToolTip="Marcar como completado / pendiente" Click="BtnCompletarEventoCalendario_Click" />
                                                                <Button Content="Quitar" Padding="6,2" Background="#DC2626" Foreground="White" ToolTip="Eliminar recordatorio manual" Click="BtnEliminarEventoCalendario_Click" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Effect="{StaticResource CardElevationShadow}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Ver Órdenes" Margin="8,0,0,0" Click="BtnIrRecepciones_Click" />
                                            <TextBlock Text="Órdenes Pendientes" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgDashboardOcs" AutoGenerateColumns="False" IsReadOnly="True" Height="195" HeadersVisibility="Column">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📥 Ir a Recepción de Mercancía de esta OC" Click="CtxDashboardOcRecibir_Click" />
                                                    <MenuItem Header="🖨️ Imprimir / Ver Orden de Compra" Click="CtxDashboardOcImprimir_Click" />
                                                    <Separator />
                                                    <MenuItem Header="📋 Copiar Folio de OC" Click="CtxDashboardOcCopiarFolio_Click" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="110" />
                                                <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="130" />
                                                <DataGridTextColumn Header="Avance" Binding="{Binding AvanceRecepcionTexto}" Width="88" />
                                                <DataGridTemplateColumn Header="Estatus" Width="138">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Estatus}">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Effect="{StaticResource CardElevationShadow}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Ir a Almacén" Margin="8,0,0,0" Click="BtnIrAlmacenPos_Click" />
                                            <TextBlock Text="Alertas de Inventario (Stock Mínimo &gt; Actual)" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgDashboardAlertas" AutoGenerateColumns="False" IsReadOnly="True" Height="195" HeadersVisibility="Column">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="🛒 Agregar a Solicitud de Compra (Reabastecer)" Click="CtxAlertaStockAgregarSolicitud_Click" />
                                                    <MenuItem Header="🗺️ Ver / Cambiar Ubicación en Mapa 3×3 (A–F)" Click="CtxAlertaStockMapa_Click" />
                                                    <MenuItem Header="✏️ Abrir Ficha del Producto en Catálogo" Click="CtxAlertaStockEditar_Click" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Prioridad" Width="140">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding PrioridadAlertaStock}">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="82" />
                                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                                                <DataGridTextColumn Header="Actual" Binding="{Binding StockActual, StringFormat={}{0:0.##}}" Width="62" />
                                                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat={}{0:0.##}}" Width="62" />
                                                <DataGridTextColumn Header="Faltante" Binding="{Binding FaltanteStock, StringFormat={}{0:0.##}}" Width="68" />
                                                <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadAlmacen}" Width="68" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== TAB 1: CATÁLOGO ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ColEditorCatalogo" Width="360" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: Catálogo Visual -->
                        <DockPanel x:Name="DockCatalogoIzquierda" Grid.Column="0" Margin="0,0,12,0">
                            <Border DockPanel.Dock="Top" Padding="12" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtBuscarCatalogo"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    PlaceholderText="Buscar producto, familia, ubicación o escanear código (PRD, ENT, SAL, OC)..."
                                                    VerticalContentAlignment="Center"
                                                    KeyDown="TxtBuscarCatalogo_KeyDown"
                                                    TextChanged="TxtBuscarCatalogo_TextChanged" />
                                        <TextBlock x:Name="TxtContadorCatalogo"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Opacity="0.7"
                                                   Margin="0,0,8,0"
                                                   Text="0 productos" />
                                        <ComboBox x:Name="CboFiltroCategoria"
                                                  Grid.Column="2"
                                                  Margin="0,0,6,0"
                                                  ToolTip="Filtrar por Categoría"
                                                  SelectionChanged="CboFiltroCategoria_SelectionChanged" />
                                        <ComboBox x:Name="CboFiltroFamilia"
                                                  Grid.Column="3"
                                                  Margin="0,0,6,0"
                                                  ToolTip="Filtrar por Familia / Agrupador Genérico"
                                                  SelectionChanged="CboFiltroFamilia_SelectionChanged" />
                                        <ComboBox x:Name="CboFiltroUbicacion"
                                                  Grid.Column="4"
                                                  ToolTip="Filtrar por Ubicación en Almacén (Zona, Anaquel o Nivel)"
                                                  SelectionChanged="CboFiltroUbicacion_SelectionChanged" />
                                    </Grid>

                                    <Border Padding="8,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Agregando a Solicitud:"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <ComboBox x:Name="CboCarritoSolicitudDestino"
                                                      Grid.Column="1"
                                                      Margin="0,0,8,0"
                                                      ToolTip="Seleccione a qué Solicitud de Compra se agregarán directamente los artículos que elija en el catálogo"
                                                      SelectionChanged="CboCarritoSolicitudDestino_SelectionChanged" />
                                            <ui:Button x:Name="BtnIrSolicitudDesdeCatalogo"
                                                       Grid.Column="2"
                                                       Margin="0,0,6,0"
                                                       Content="📋 Ir a la Solicitud"
                                                       ToolTip="Abrir la Solicitud de Compra activa en el Módulo 2"
                                                       Appearance="Primary"
                                                       Click="BtnEnviarCarritoASolicitud_Click" />
                                            <ui:Button x:Name="BtnToggleEditorCatalogo"
                                                       Grid.Column="3"
                                                       Content="⟪ Ocultar Editor"
                                                       ToolTip="Ocultar o mostrar el panel lateral de edición para ver el catálogo a pantalla completa"
                                                       Click="BtnToggleEditorCatalogo_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="SvCatalogoVisual"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="SvCatalogoVisual_ScrollChanged">
                                <ItemsControl x:Name="IcCatalogoVisual">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="242"
                                                    Margin="0,0,10,10"
                                                    Padding="12"
                                                    CornerRadius="10"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    ToolTip="Clic izquierdo: Seleccionar / Editar | Clic derecho: Menú de opciones rápidas"
                                                    MouseLeftButtonUp="CardProductoCatalogo_MouseLeftButtonUp">
                                                <Border.ContextMenu>
                                                    <ContextMenu Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="📋 Agregar a la Solicitud (+1)" Tag="{Binding}" Click="CtxCardAgregarCarrito_Click" FontWeight="Bold" />
                                                        <MenuItem Header="📤 Enviar directo a Salida de Almacén" Tag="{Binding}" Click="CtxCardEnviarSalida_Click" />
                                                        <Separator />
                                                        <MenuItem Header="✏️ Editar Ficha del Producto" Tag="{Binding}" Click="CtxCardEditarProducto_Click" />
                                                        <MenuItem Header="🗺️ Ver / Cambiar Ubicación en Mapa 3×3 (A–F)" Tag="{Binding}" Click="CtxCardAbrirMapaUbicacion_Click" />
                                                        <MenuItem Header="🔧 Abrir Ficha Individual de Herramienta (HER-xxxx)" Tag="{Binding}" Click="CtxCardAbrirFichaHerramienta_Click" />
                                                        <MenuItem Header="📈 Ver Historial de Precios y Gráficas en Análisis" Tag="{Binding}" Click="CtxCardVerAnalisisPrecio_Click" />
                                                        <Separator />
                                                        <MenuItem Header="📋 Copiar Código Interno (PRD-xxxx)" Tag="{Binding}" Click="CtxCardCopiarCodigo_Click" />
                                                        <MenuItem Header="🗑️ Eliminar Producto del Catálogo" Tag="{Binding}" Click="CtxCardEliminarProducto_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EDF5FF" />
                                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                                                <Setter Property="TextElement.Foreground" Value="#002B5C" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                                                <Setter Property="Background" Value="#CBE4FF" />
                                                                <Setter Property="BorderBrush" Value="#0078D4" />
                                                                <Setter Property="BorderThickness" Value="2.5" />
                                                                <Setter Property="TextElement.Foreground" Value="#002B5C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Height="135"
                                                            CornerRadius="8"
                                                            Background="White"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Box24" FontSize="38" Foreground="#0078D4" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding CategoriaNombre}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Image Source="{Binding ImagenMiniatura, Mode=OneWay}"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"
                                                                   Stretch="Uniform"
                                                                   Margin="4" />
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#E0F2FE">
                                                                <TextBlock Text="{Binding CategoriaNombre}" Foreground="#0369A1" FontSize="9.5" FontWeight="SemiBold" MaxWidth="115" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#0F172A">
                                                                <TextBlock Text="{Binding CodigoInterno}" Foreground="White" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="6"
                                                                    Padding="6,2"
                                                                    CornerRadius="4"
                                                                    Background="#DCFCE7"
                                                                    BorderBrush="#86EFAC"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Clic para abrir el Mapa de Anaqueles en esta coordenada"
                                                                    MouseLeftButtonDown="BadgeUbicacionCard_MouseLeftButtonDown">
                                                                <TextBlock Text="{Binding UbicacionBadgeTexto, Mode=OneWay}" Foreground="#166534" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}" />
                                                    <TextBlock Text="{Binding FichaTecnicaResumen}" FontSize="10.5" Foreground="#0284C7" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FichaTecnicaResumen}" Margin="0,1,0,1" />
                                                    <TextBlock Text="{Binding ConversionTexto}" FontSize="11" Opacity="0.72" Margin="0,0,0,4" />

                                                    <Grid Margin="0,2,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Existencia" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0078D4">
                                                                <Run Text="{Binding StockActual, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                                                <Run Text="{Binding UnidadAlmacen, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="Costo" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock Text="{Binding UltimoCostoCompra, StringFormat={}{0:C2}}" FontSize="13" FontWeight="Bold" Foreground="#107C10" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ui:Button HorizontalAlignment="Stretch"
                                                               Appearance="Primary"
                                                               Content="➕ Agregar a Solicitud"
                                                               Tag="{Binding}"
                                                               Click="BtnAgregarProductoCarrito_Click" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Derecha: Detalle del Producto -->
                        <ScrollViewer x:Name="SvEditorProducto" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Border x:Name="BdrContenedorEditorProducto" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1.5">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:Button x:Name="BtnNuevoProductoCatalogo"
                                                   DockPanel.Dock="Right"
                                                   Margin="8,0,0,0"
                                                   Content="+ Nuevo Producto"
                                                   Appearance="Primary"
                                                   ToolTip="Limpiar formulario y preparar alta de un nuevo artículo en el catálogo"
                                                   Click="BtnNuevoProducto_Click" />
                                        <TextBlock Text="Ficha de Producto" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Banner visual claro de Modo Alta vs Modo Edición -->
                                    <Border x:Name="BdrModoEditorProducto"
                                            Padding="10,7"
                                            CornerRadius="6"
                                            Background="#DBEAFE"
                                            BorderBrush="#2563EB"
                                            BorderThickness="1"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtModoEditorProductoTitulo"
                                                       Text="MODO: ALTA DE NUEVO PRODUCTO"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="#1E40AF" />
                                            <TextBlock x:Name="TxtModoEditorProductoSubtitulo"
                                                       Text="Escriba el nombre del nuevo artículo y presione '➕ Crear Nuevo Producto' abajo."
                                                       FontSize="10.5"
                                                       Foreground="#1E3A8A"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Height="115" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Sin imagen (Ctrl+V para pegar)" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="ImgPreviewProducto" Stretch="Uniform" Margin="4" />
                                        </Grid>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <ui:Button Content="Pegar Imagen" Margin="0,0,4,0" Click="BtnPegarImagenPortapapeles_Click" />
                                        <ui:Button Content="Subir Archivo" Margin="4,0,0,0" Click="BtnSubirImagenArchivo_Click" />
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Código Interno" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoInterno" FontFamily="Consolas" PlaceholderText="Ej. PRD-0011" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Código de Barras" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoBarras" FontFamily="Consolas" PlaceholderText="Ej. 750100010001" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Nombre del Producto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtProdNombre" Margin="0,0,0,6" PlaceholderText="Ej. Compresor Scroll 5 Toneladas / Paño Microfibra" />

                                    <TextBlock Text="Categoría (Define los campos técnicos abajo)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CboProdCategoria" Margin="0,0,0,6" SelectionChanged="CboProdCategoria_SelectionChanged" />

                                    <DockPanel Margin="0,0,0,2">
                                        <ui:Button DockPanel.Dock="Right"
                                                   Margin="6,0,0,0"
                                                   Content="Gestionar Familias"
                                                   FontSize="10"
                                                   Padding="6,1"
                                                   ToolTip="Crear, renombrar o unificar familias de productos manualmente"
                                                   Click="BtnGestionarFamilias_Click" />
                                        <TextBlock Text="Familia / Agrupador Genérico" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ComboBox x:Name="CboProdFamilia"
                                              IsEditable="True"
                                              Margin="0,0,0,6"
                                              ToolTip="Seleccione una familia existente o escriba una nueva manualmente para agrupar artículos equivalentes en Comparativa" />

                                    <!-- Ficha Técnica Inteligente (Universal + Dinámica por Categoría) -->
                                    <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <ui:Button DockPanel.Dock="Right"
                                                           Margin="6,0,0,0"
                                                           Content="Autocompletar"
                                                           FontSize="10.5"
                                                           Padding="6,2"
                                                           ToolTip="Detectar categoría, marca, modelo, medidas y especificaciones desde el nombre"
                                                           Click="BtnAutocompletarFichaProducto_Click" />
                                                <TextBlock Text="Ficha Técnica y Especificaciones" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <!-- Nivel 1: Campos Universales (Marca, Modelo, Medidas) -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Marca" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdMarca" PlaceholderText="Ej. LG, Trane, Pretul, 3M" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Modelo / N° Parte" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdModelo" PlaceholderText="Ej. EBR80820305, MVPP600" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Medidas / Dimensiones" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdMedidas" Margin="0,0,0,6" PlaceholderText="Ej. 40x40 cm, 3/4 x 2 pulg, 18 m x 19 mm" />

                                            <!-- Nivel 2: Campos Dinámicos según la Categoría seleccionada -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock x:Name="LblProdCampo1" Text="Capacidad Eléctrica / Voltaje" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBox x:Name="TxtProdCapacidadElectrica" PlaceholderText="Ej. 220V / 5 Ton / Microfibra" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock x:Name="LblProdCampo2" Text="Corriente / Potencia / Material" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBox x:Name="TxtProdEspecificacion1" PlaceholderText="Ej. 40A, 160W, Cédula 40, 4 L" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock x:Name="LblProdCampo3" Text="Gas / Polos / Color / Especificación" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                            <ui:TextBox x:Name="TxtProdEspecificacion2" Margin="0,0,0,6" PlaceholderText="Ej. R-410A, Trifásico, IP65, Color Azul" />

                                            <TextBlock Text="Notas Técnicas / Descripción Adicional" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdDescripcion" PlaceholderText="Observaciones adicionales, compatibilidad o referencia SAT..." />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Unidades y Conversión (Mayoreo a Menudeo)" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="85" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Unidad Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="TxtProdUnidadCompra" IsEditable="True" SelectionChanged="UnidadOFactorProducto_Changed" LostFocus="UnidadOFactorProducto_Changed" ToolTip="Unidad en que lo factura el proveedor (Caja, Paquete, Rollo, Pieza, etc.)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Unidad Entrega" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="TxtProdUnidadAlmacen" IsEditable="True" SelectionChanged="UnidadOFactorProducto_Changed" LostFocus="UnidadOFactorProducto_Changed" ToolTip="Unidad en que se guarda y entrega en almacén (Pieza, Rollo, Metro, Litro, Par, etc.)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Piezas x Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdFactor" PlaceholderText="Ej. 1" TextChanged="TxtProdFactorOCosto_TextChanged" ToolTip="Cuántas Unidades de Entrega contiene 1 Unidad de Compra (Ej. 1 Caja = 12 Rollos)" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="TxtResumenConversionProducto"
                                                       Text="Existencia expresada en Unidad de Entrega | Costo expresado por Unidad de Compra"
                                                       FontSize="10.5"
                                                       Foreground="#0369A1"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock x:Name="LblProdExistenciaUnidad" Text="Existencia (Entrega)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="La existencia actual del almacén se expresa siempre en Unidades de Entrega" />
                                            <ui:TextBox x:Name="TxtProdStock" PlaceholderText="Ej. 0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock x:Name="LblProdStockMinUnidad" Text="Stock Mín. (Entrega)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="Nivel mínimo de alerta expresado en Unidades de Entrega" />
                                            <ui:TextBox x:Name="TxtProdStockMin" PlaceholderText="Ej. 5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock x:Name="LblProdCostoUnidad" Text="Costo Compra ($ c/IVA)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" ToolTip="Costo con IVA por cada Unidad de Compra" />
                                            <ui:TextBox x:Name="TxtProdCosto" PlaceholderText="Ej. 0.00" TextChanged="TxtProdFactorOCosto_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Ubicación en Almacén (Anaquel A–F, Detrás de A, Gabinete o Piso)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="TxtProdUbicacion"
                                                      Grid.Column="0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ToolTip="Seleccione de la lista desplegable o escriba la ubicación (Ej. A-01, DETRAS-A-01, GABINETE-01, PISO-01)"
                                                      SelectionChanged="CboUbicacionAlmacen_SelectionChanged" />
                                            <ui:Button Grid.Column="1"
                                                       Content="🗺️ Mapa"
                                                       FontSize="11.5"
                                                       Padding="10,5"
                                                       Margin="6,0,0,0"
                                                       ToolTip="Abrir selector gráfico 3x3 de anaqueles (A–F, Detrás de A, Gabinete y Piso)"
                                                       Click="BtnSelectorUbicacionProducto_Click" />
                                        </Grid>
                                        <Border Padding="8,5" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <ui:Button x:Name="BtnConfigurarHerramientaCatalogo"
                                                           DockPanel.Dock="Right"
                                                           Content="🔧 Configurar Ficha HER"
                                                           FontSize="11"
                                                           Padding="10,4"
                                                           ToolTip="Abrir modal de información de la herramienta (Número de serie, código individual HER-xxxx, ubicación y estado)"
                                                           Click="BtnConfigurarHerramientaCatalogo_Click" />
                                                <CheckBox x:Name="ChkProdEsHerramienta"
                                                          Content="Es Herramienta de Resguardo"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Marcar si es una herramienta de resguardo en almacén (abre el registro de ficha individual HER-xxxx)"
                                                          Click="ChkProdEsHerramienta_Click" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>

                                    <Image x:Name="ImgBarcodeProductoEditor" Height="44" Stretch="Fill" Margin="0,2,0,8" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnGuardarProductoCatalogo"
                                                   Grid.Column="0"
                                                   Content="Guardar Producto"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Click="BtnGuardarProducto_Click" />
                                        <ui:Button Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   Content="Eliminar"
                                                   Click="BtnEliminarProducto_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 2: SOLICITUDES ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.18*" />
                            <ColumnDefinition Width="0.82*" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: Editor de Solicitud de Compra -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <ui:Button x:Name="BtnNuevaSolicitudVacia" Content="+ Nueva Solicitud" FontSize="11.5" Margin="0,0,6,0" Click="BtnNuevaSolicitudVacia_Click" />
                                            <ui:Button x:Name="BtnCrearCarritoEIrCatalogo" Content="➕ Escoger del Catálogo Visual" Appearance="Primary" FontSize="11.5" Click="BtnCrearCarritoEIrCatalogo_Click" />
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTituloEditorSolicitud" Text="Nueva Solicitud de Compra" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" />
                                            <Border x:Name="BdrEstadoEditorSolicitud" Padding="8,2" CornerRadius="4" Background="#1D4ED8" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtEstadoEditorSolicitud" Text="EN CAPTURA" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.05*" />
                                            <ColumnDefinition Width="0.95*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Gerencia / Departamento *" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolDepartamento" SelectionChanged="CboSolDepartamento_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,5,0">
                                            <TextBlock Text="Responsable del Área *" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolEncargado" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,5,0">
                                            <TextBlock Text="Proyecto / Destino (Opcional)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolProyecto" ToolTip="Opcional: si se deja vacío o en Consumo Interno, se asigna al departamento solicitante" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                            <TextBlock Text="Modalidad de Solicitud" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolTipoSolicitud" SelectedIndex="0">
                                                <ComboBoxItem Content="Requerimiento de Compra" />
                                                <ComboBoxItem Content="Solo Cotización / Presupuesto" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Captura Rápida Compacta (Plantilla Excel / Web y WhatsApp Colapsable) -->
                                    <Border Padding="8,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <ui:Button Content="📄 Formato Excel" FontSize="11" Padding="8,3" Margin="0,0,6,0" ToolTip="Descargar formato estándar de Solicitud en Excel (.csv)" Click="BtnExportarPlantillaSolicitud_Click" />
                                                    <ui:Button Content="📥 Importar Solicitud" FontSize="11" Padding="8,3" Margin="0,0,6,0" ToolTip="Cargar una Solicitud desde archivo Excel/CSV" Click="BtnImportarPlantillaSolicitud_Click" />
                                                    <ui:Button x:Name="BtnToggleWhatsappSolicitud" Content="💬 Pegar Texto WhatsApp ▾" FontSize="11" Padding="8,3" Click="BtnToggleWhatsappSolicitud_Click" />
                                                </StackPanel>
                                                <TextBlock Text="Carga por Plantilla o Lista Rápida" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <Grid x:Name="PnlWhatsappCaptura" Visibility="Collapsed" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox x:Name="TxtWhatsappInput"
                                                            Grid.Column="0"
                                                            Height="44"
                                                            TextWrapping="Wrap"
                                                            AcceptsReturn="True"
                                                            PlaceholderText="Pegue aquí el texto de WhatsApp (ej. 5 Tornillo 1/4, 2 Cable calibre 12)..." />
                                                <ui:Button Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           Appearance="Primary"
                                                           Content="Interpretar"
                                                           Click="BtnInterpretarWhatsapp_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Barra de Búsqueda + Agregar Partida -->
                                    <Border Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="TxtContadorFiltroProductoSol" DockPanel.Dock="Right" Margin="8,0,0,0" Text="" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                                <TextBlock Text="Buscar y Agregar Artículo a la Solicitud" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ui:TextBox x:Name="TxtBuscarProductoSolicitud"
                                                        Margin="0,0,0,6"
                                                        PlaceholderText="Escriba nombre, código, marca, modelo, medida o escanee código de barras (Enter agrega directo)..."
                                                        VerticalContentAlignment="Center"
                                                        TextChanged="TxtBuscarProductoSolicitud_TextChanged"
                                                        KeyDown="TxtBuscarProductoSolicitud_KeyDown" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CboSolProductoAgregar" Grid.Column="0" Margin="0,0,6,0" />
                                                <ui:TextBox x:Name="TxtSolCantidadAgregar" Grid.Column="1" PlaceholderText="Cant. (1)" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                                                <ui:Button Grid.Column="2" Content="+ Del Catálogo" Appearance="Primary" Margin="0,0,6,0" Click="BtnAgregarPartidaSolicitud_Click" />
                                                <ui:Button Grid.Column="3"
                                                           Content="+ Concepto Abierto"
                                                           ToolTip="Agrega el texto escrito en el buscador como necesidad genérica sin crear un producto vacío en el catálogo todavía"
                                                           Click="BtnAgregarConceptoLibreSolicitud_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock Text="Notas o Justificación de la Solicitud" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtSolNotas" Margin="0,0,0,8" PlaceholderText="Ej. Material requerido para mantenimiento o cotización de propuesta..." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnLimpiarPartidasSolicitud" Grid.Column="0" Content="Vaciar Artículos" Margin="0,0,6,0" Click="BtnLimpiarPartidasSolicitud_Click" />
                                        <ui:Button Grid.Column="1" Content="Generar Salida de Stock" Margin="0,0,6,0" ToolTip="Envía los artículos que sí tienen existencia en Almacén directamente a Salida de Material" Click="BtnGenerarSalidaStockSolicitud_Click" />
                                        <ui:Button x:Name="BtnGuardarSolicitud" Grid.Column="2" HorizontalAlignment="Stretch" Content="Guardar Solicitud" Appearance="Primary" Click="BtnGuardarSolicitud_Click" />
                                    </Grid>
                                </StackPanel>

                                <DataGrid x:Name="DgPartidasNuevaSolicitud"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CellEditEnding="DgPartidasNuevaSolicitud_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Cotizar" Binding="{Binding IncluirEnCotizacion, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                        <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="80" />
                                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="85" />
                                        <DataGridTextColumn Header="Cant." Binding="{Binding CantidadSolicitada, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                        <DataGridTextColumn Header="Stock" Binding="{Binding StockActualAlmacen}" IsReadOnly="True" Width="65" />
                                        <DataGridTemplateColumn Header="Acciones" Width="135">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="-" Padding="6,2" Margin="0,0,3,0" ToolTip="Disminuir cantidad" Click="BtnDisminuirPartidaSolicitud_Click" />
                                                        <Button Content="+" Padding="6,2" Margin="0,0,5,0" ToolTip="Aumentar cantidad" Click="BtnAumentarPartidaSolicitud_Click" />
                                                        <Button Content="Quitar" Padding="7,2" Background="#DC2626" Foreground="White" ToolTip="Quitar artículo de la solicitud" Click="BtnQuitarPartidaSolicitud_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Derecha: Solicitudes Registradas (Carritos) -->
                        <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Solicitudes Registradas" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Seleccione cualquier solicitud para revisar existencias, editar partidas o enviarla a comparativa." FontSize="11.5" Opacity="0.72" Margin="0,2,0,0" />
                                </StackPanel>

                                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0"
                                               Appearance="Primary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,6,0"
                                               Content="⚖️ Abrir Solicitud en Comparativa"
                                               Click="BtnEnviarSolicitudAComparativa_Click" />
                                    <Menu Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <MenuItem Header="📄 Acciones ▾" Padding="10,6" FontWeight="SemiBold">
                                            <MenuItem Header="🛒 Ir al Catálogo con esta Solicitud" Click="BtnIrCatalogoConSolicitud_Click" />
                                            <MenuItem Header="🖨️ Vista Previa / Imprimir Solicitud" Click="BtnImprimirSolicitud_Click" />
                                            <MenuItem Header="📥 Descargar Solicitud (PDF / PNG / CSV)" Click="BtnDescargarSolicitudArchivo_Click" />
                                            <MenuItem Header="📊 Exportar Existencias de Almacén (CSV)" Click="BtnExportarExistenciasCatalogo_Click" />
                                            <Separator />
                                            <MenuItem Header="🗑️ Eliminar Solicitud" Click="BtnEliminarSolicitud_Click" />
                                        </MenuItem>
                                    </Menu>
                                </Grid>

                                <DataGrid x:Name="DgHistorialSolicitudes"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionChanged="DgHistorialSolicitudes_SelectionChanged">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="⚖️ Abrir Solicitud en Cuadro Comparativo" Click="BtnEnviarSolicitudAComparativa_Click" FontWeight="Bold" />
                                            <MenuItem Header="🛒 Ir al Catálogo Visual con esta Solicitud activa" Click="BtnIrCatalogoConSolicitud_Click" />
                                            <Separator />
                                            <MenuItem Header="🖨️ Vista Previa / Imprimir Solicitud" Click="BtnImprimirSolicitud_Click" />
                                            <MenuItem Header="📄 Descargar Solicitud (PDF / PNG / CSV)" Click="BtnDescargarSolicitudArchivo_Click" />
                                            <Separator />
                                            <MenuItem Header="🗑️ Eliminar Solicitud" Click="BtnEliminarSolicitud_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100" />
                                        <DataGridTextColumn Header="Modalidad" Binding="{Binding TipoSolicitud}" Width="135" />
                                        <DataGridTextColumn Header="Destino / Proyecto" Binding="{Binding ProyectoMostrar}" Width="*" />
                                        <DataGridTextColumn Header="Artículos" Binding="{Binding ResumenArticulos}" Width="100" />
                                        <DataGridTemplateColumn Header="Estatus" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Estatus}">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 3: COMPARATIVA POR PRODUCTO ==================== -->
                <TabItem>
                    <DockPanel>
                        <!-- Barra Superior: Solicitud a Cotizar y Acciones Globales -->
                        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Solicitud de Compra a Cotizar por Producto" FontWeight="Bold" FontSize="12" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CboCompSolicitud" SelectionChanged="CboCompSolicitud_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtCompInfoSolicitud" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtCompAvanceDecision" FontSize="11.5" Foreground="#059669" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <MenuItem Header="📤 Exportar / Imprimir ▾" Padding="10,6" FontWeight="SemiBold">
                                            <MenuItem Header="📋 Copiar Lista Limpia para Cotizar" Click="BtnCopiarListaParaCotizar_Click" />
                                            <MenuItem Header="🖨️ Vista Previa / Imprimir Comparativa" Click="BtnImprimirComparativa_Click" />
                                            <MenuItem Header="📄 Descargar Comparativa (PDF / PNG / CSV)" Click="BtnDescargarComparativaArchivo_Click" />
                                        </MenuItem>
                                    </Menu>
                                    <ui:Button Content="💾 Guardar Borrador"
                                               Appearance="Primary"
                                               Click="BtnGuardarBorradorComparativa_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cuerpo Principal: Izquierda (Lista de Productos + Resumen OCs) | Derecha (Comparativa 3 Opciones del Producto Seleccionado) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- IZQUIERDA: Tabla de Productos de la Solicitud + Pre-visualización de Órdenes de Compra -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="225" />
                                </Grid.RowDefinitions>

                                <!-- Tabla de Productos de la Solicitud -->
                                <Border Grid.Row="0" Padding="12" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock Text="1. Artículos de la Solicitud (Seleccione un producto para cotizarlo)" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <DataGrid x:Name="DgComparativa"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  SelectionChanged="DgComparativa_SelectionChanged"
                                                  CellEditEnding="DgComparativa_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="80" />
                                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="58" />
                                                <DataGridTextColumn Header="Stock" Binding="{Binding StockActualAlmacen}" IsReadOnly="True" Width="58" />
                                                <DataGridTextColumn Header="Decisión / Ganador" Binding="{Binding EstadoDecisionTexto}" IsReadOnly="True" Width="175" />
                                                <DataGridTextColumn Header="Total c/IVA" Binding="{Binding TotalGanadorConIva, StringFormat={}{0:C2}}" IsReadOnly="True" Width="95" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <!-- Pre-visualización de Órdenes de Compra por Proveedor Ganador -->
                                <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtResumenGeneralComparativa" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="3. Resumen de Órdenes de Compra a Emitir (Por Proveedor Ganador)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtNotaEmisionParcial"
                                                       Grid.Column="0"
                                                       FontSize="11"
                                                       Opacity="0.78"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="Puede emitir OCs solo de los productos ya decididos hoy o finalizar como cotización de presupuesto." />
                                            <ui:Button x:Name="BtnConvertirPresupuestoEnCompra"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Content="Finalizar Cotización / Convertir"
                                                       ToolTip="Si es Solo Cotización marca como entregada, o convierte el presupuesto aprobado en Requerimiento de Compra"
                                                       Click="BtnConvertirPresupuestoEnCompra_Click" />
                                            <ui:Button x:Name="BtnGenerarOrdenesDesdeComparativa"
                                                       Grid.Column="2"
                                                       Margin="8,0,0,0"
                                                       Appearance="Primary"
                                                       Content="Emitir Órdenes de Compra"
                                                       Click="BtnGenerarOrdenesDesdeComparativa_Click" />
                                        </Grid>

                                        <DataGrid x:Name="DgPrevisualizacionOcs"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Proveedor Ganador" Binding="{Binding ProveedorNombre}" Width="*" />
                                                <DataGridTextColumn Header="Partidas" Binding="{Binding CantidadPartidas}" Width="68" />
                                                <DataGridTextColumn Header="Entrega" Binding="{Binding DiasEntregaMax, StringFormat={}{0} días}" Width="72" />
                                                <DataGridTextColumn Header="Envío c/IVA" Binding="{Binding FleteConIva, StringFormat={}{0:C2}}" Width="90" />
                                                <DataGridTextColumn Header="Total OC c/IVA" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- DERECHA: Comparador Detallado por Producto (1 Opción por defecto + Botón Añadir Opción de Proveedor) -->
                            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <!-- Encabezado del Producto Seleccionado -->
                                    <Border DockPanel.Dock="Top" Padding="12" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <!-- Fila 1: Título y Subtítulo del Producto (Con ajuste de línea completo para no empujar ningún botón) -->
                                            <TextBlock x:Name="TxtCompProdTitulo"
                                                       Text="2. Seleccione un producto de la lista"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtCompProdSubtitulo"
                                                       Text="Empieza con 1 opción (mejor histórico o en blanco). Use '+ Añadir Proveedor Concursante' para comparar más proveedores."
                                                       FontSize="11.5"
                                                       Opacity="0.82"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />

                                            <!-- Fila 2: Barra de Controles y Botones de Proveedores Concursantes (Siempre visible) -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Cant.:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtCompProdCantidad" Width="64" Text="1" TextChanged="TxtCompProdCantidad_TextChanged" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Vigencia (días):" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtCompDiasVigencia" Width="54" Text="15" TextChanged="TxtCompExtras_TextChanged" />
                                                </StackPanel>

                                                <WrapPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ui:Button x:Name="BtnAgregarOpcionProveedorComp"
                                                               Content="+ Añadir Proveedor Concursante"
                                                               Appearance="Primary"
                                                               FontSize="11.5"
                                                               Margin="0,0,6,0"
                                                               ToolTip="Añade otra tarjeta u opción de proveedor concursante para comparar precios en este artículo"
                                                               Click="BtnAgregarOpcionProveedorComp_Click" />
                                                    <ui:Button Content="Mejor Precio"
                                                               FontSize="11.5"
                                                               Margin="0,0,6,0"
                                                               ToolTip="Selecciona automáticamente al proveedor con menor costo total en este artículo"
                                                               Click="BtnMejorPrecioProductoActual_Click" />
                                                    <ui:Button Content="Sin Decidir"
                                                               FontSize="11.5"
                                                               ToolTip="Limpia la decisión de proveedor ganador en este artículo"
                                                               Click="BtnLimpiarGanadorProductoActual_Click" />
                                                </WrapPanel>
                                            </Grid>

                                            <TextBlock x:Name="TxtCompProdHistorial"
                                                       Margin="0,6,0,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2563EB"
                                                       TextWrapping="Wrap" />

                                            <!-- Selector de Compras Históricas de Artículos Similares / Misma Familia -->
                                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Compras / Cotizaciones Similares:"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <ComboBox x:Name="CboCompReferenciasSimilares"
                                                              Grid.Column="1"
                                                              FontSize="11"
                                                              Margin="0,0,6,0"
                                                              DisplayMemberPath="EtiquetaCombo" />
                                                    <ui:Button Grid.Column="2"
                                                               Content="Usar en Op. 1"
                                                               FontSize="10.5"
                                                               Padding="8,3"
                                                               Margin="0,0,4,0"
                                                               ToolTip="Carga el proveedor y precio de esta referencia histórica en la Opción 1"
                                                               Click="BtnAplicarReferenciaSimilarOp1_Click" />
                                                    <ui:Button Grid.Column="3"
                                                               Content="+ En Nueva Opción"
                                                               FontSize="10.5"
                                                               Padding="8,3"
                                                               ToolTip="Abre otra tarjeta de proveedor (Opción 2 o 3) con esta referencia histórica para comparar"
                                                               Click="BtnAplicarReferenciaSimilarNuevaOp_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjetas de Cotización Exclusivas del Producto Seleccionado (1 por defecto, hasta N proveedores concursantes) -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <UniformGrid x:Name="UgTarjetasComparativa" Columns="1">
                                                <!-- OPCIÓN 1 -->
                                                <Border x:Name="BdrCompCard1" Margin="0,0,5,0" Padding="10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="#0078D4" BorderThickness="1.5">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Border x:Name="BdrBadgeGanador1" DockPanel.Dock="Right" Padding="6,2" CornerRadius="4" Background="#059669" Margin="6,0,0,0" Visibility="Collapsed">
                                                                <TextBlock Text="SELECCIONADO" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                            <TextBlock Text="Opción 1 (Principal / Histórico)" FontWeight="Bold" FontSize="13" Foreground="#0078D4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Text="Proveedor que cotiza este artículo" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="CboCompProv1" Margin="0,0,0,8" SelectionChanged="CboCompProveedores_SelectionChanged" />

                                                        <TextBlock Text="Precio Unitario SIN IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioSinIva1" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioSinIva1_TextChanged" />

                                                        <TextBlock Text="Precio Unitario CON IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioConIva1" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioConIva1_TextChanged" />

                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompFlete1" Text="0.00" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0">
                                                                <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompDias1" Text="2" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Text="Notas / Marca ofertada" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompNotas1" Margin="0,0,0,8" PlaceholderText="Ej. Entrega inmediata..." TextChanged="TxtCompExtras_TextChanged" />

                                                        <Border Padding="8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,0,8">
                                                            <TextBlock x:Name="TxtResumenProv1" Text="Subtotal: $0.00&#x0a;Total c/IVA: $0.00" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" />
                                                        </Border>

                                                        <ui:Button x:Name="BtnElegirGanador1"
                                                                   HorizontalAlignment="Stretch"
                                                                   Content="Elegir Opción 1"
                                                                   Click="BtnElegirGanador1_Click" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- OPCIÓN 2 -->
                                                <Border x:Name="BdrCompCard2" Visibility="Collapsed" Margin="3,0,3,0" Padding="10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="#498205" BorderThickness="1.5">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                <Border x:Name="BdrBadgeGanador2" Padding="6,2" CornerRadius="4" Background="#059669" Margin="0,0,4,0" Visibility="Collapsed">
                                                                    <TextBlock Text="SELECCIONADO" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                                <Button Content="X" Padding="5,1" FontSize="10" ToolTip="Ocultar y limpiar Opción 2" Click="BtnQuitarOpcion2Comp_Click" />
                                                            </StackPanel>
                                                            <TextBlock Text="Opción 2" FontWeight="Bold" FontSize="13" Foreground="#498205" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Text="Proveedor que cotiza este artículo" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="CboCompProv2" Margin="0,0,0,8" SelectionChanged="CboCompProveedores_SelectionChanged" />

                                                        <TextBlock Text="Precio Unitario SIN IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioSinIva2" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioSinIva2_TextChanged" />

                                                        <TextBlock Text="Precio Unitario CON IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioConIva2" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioConIva2_TextChanged" />

                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompFlete2" Text="0.00" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0">
                                                                <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompDias2" Text="3" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Text="Notas / Marca ofertada" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompNotas2" Margin="0,0,0,8" PlaceholderText="Ej. Sobre pedido..." TextChanged="TxtCompExtras_TextChanged" />

                                                        <Border Padding="8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,0,8">
                                                            <TextBlock x:Name="TxtResumenProv2" Text="Subtotal: $0.00&#x0a;Total c/IVA: $0.00" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" />
                                                        </Border>

                                                        <ui:Button x:Name="BtnElegirGanador2"
                                                                   HorizontalAlignment="Stretch"
                                                                   Content="Elegir Opción 2"
                                                                   Click="BtnElegirGanador2_Click" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- OPCIÓN 3 -->
                                                <Border x:Name="BdrCompCard3" Visibility="Collapsed" Margin="5,0,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="#881798" BorderThickness="1.5">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                <Border x:Name="BdrBadgeGanador3" Padding="6,2" CornerRadius="4" Background="#059669" Margin="0,0,4,0" Visibility="Collapsed">
                                                                    <TextBlock Text="SELECCIONADO" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                                <Button Content="X" Padding="5,1" FontSize="10" ToolTip="Ocultar y limpiar Opción 3" Click="BtnQuitarOpcion3Comp_Click" />
                                                            </StackPanel>
                                                            <TextBlock Text="Opción 3" FontWeight="Bold" FontSize="13" Foreground="#881798" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Text="Proveedor que cotiza este artículo" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="CboCompProv3" Margin="0,0,0,8" SelectionChanged="CboCompProveedores_SelectionChanged" />

                                                        <TextBlock Text="Precio Unitario SIN IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioSinIva3" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioSinIva3_TextChanged" />

                                                        <TextBlock Text="Precio Unitario CON IVA ($)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompPrecioConIva3" Margin="0,0,0,6" PlaceholderText="0.00" TextChanged="TxtCompPrecioConIva3_TextChanged" />

                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,3,0">
                                                                <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompFlete3" Text="0.00" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0">
                                                                <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                                <ui:TextBox x:Name="TxtCompDias3" Text="1" TextChanged="TxtCompExtras_TextChanged" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Text="Notas / Marca ofertada" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtCompNotas3" Margin="0,0,0,8" PlaceholderText="Ej. Marca original..." TextChanged="TxtCompExtras_TextChanged" />

                                                        <Border Padding="8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,0,8">
                                                            <TextBlock x:Name="TxtResumenProv3" Text="Subtotal: $0.00&#x0a;Total c/IVA: $0.00" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" />
                                                        </Border>

                                                        <ui:Button x:Name="BtnElegirGanador3"
                                                                   HorizontalAlignment="Stretch"
                                                                   Content="Elegir Opción 3"
                                                                   Click="BtnElegirGanador3_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <!-- PROVEEDORES CONCURSANTES ADICIONALES (OPCIÓN 4, 5, N...) -->
                                            <Border x:Name="BdrProveedoresExtraComp"
                                                    Visibility="Collapsed"
                                                    Margin="0,10,0,0"
                                                    Padding="10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="#0284C7"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <ui:Button Content="Elegir Seleccionado como Ganador" FontSize="11" Appearance="Primary" Margin="0,0,6,0" Click="BtnElegirProveedorExtraGanador_Click" />
                                                            <ui:Button Content="Quitar Proveedor Extra" FontSize="11" Click="BtnEliminarProveedorExtra_Click" />
                                                        </StackPanel>
                                                        <TextBlock Text="Proveedores Concursantes Adicionales (Opción 4+)" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <DataGrid x:Name="DgProveedoresExtraComp" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="150">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Opción" Binding="{Binding NumeroOpcion}" Width="65" />
                                                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                            <DataGridTextColumn Header="P.U. s/IVA" Binding="{Binding PrecioSinIva, StringFormat={}{0:C2}}" Width="90" />
                                                            <DataGridTextColumn Header="P.U. c/IVA" Binding="{Binding PrecioConIva, StringFormat={}{0:C2}}" Width="90" />
                                                            <DataGridTextColumn Header="Entrega" Binding="{Binding DiasEntrega, StringFormat={}{0}d}" Width="68" />
                                                            <DataGridTextColumn Header="Envío" Binding="{Binding FleteConIva, StringFormat={}{0:C2}}" Width="80" />
                                                            <DataGridTextColumn Header="Notas" Binding="{Binding NotasCotizacion}" Width="120" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ==================== TAB 4: ÓRDENES DE COMPRA ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- Órdenes de Compra -->
                            <Border Grid.Column="0" Margin="0,0,10,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <MenuItem Header="⚙️ Acciones OC ▾" Padding="10,5" FontWeight="SemiBold" FontSize="11.5">
                                                        <MenuItem Header="📄 Descargar Orden de Compra (PDF / PNG / CSV)" Click="BtnDescargarOcSeleccionada_Click" />
                                                        <MenuItem Header="🧾 Liquidar sin Factura (Nota / Remisión)" Click="BtnLiquidarOcSinFactura_Click" />
                                                        <Separator />
                                                        <MenuItem Header="🔐 Forzar Estatus de OC (Administrador)" Click="BtnForzarEstatusOcAdmin_Click" />
                                                    </MenuItem>
                                                </Menu>
                                                <ui:Button Content="Imprimir OC" Icon="{ui:SymbolIcon Print24}" Click="BtnImprimirOcSeleccionada_Click" />
                                            </StackPanel>
                                            <TextBlock Text="Órdenes de Compra" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Barra de Flujo Operativo: Dirección -> Finanzas -> Almacén -->
                                        <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="Estatus Operativo (Flujo)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboOcEstatusOperativo" FontSize="11.5">
                                                        <ComboBoxItem Content="Pendiente Vo.Bo. Dirección" />
                                                        <ComboBoxItem Content="Autorizada / Pendiente Pago Finanzas" />
                                                        <ComboBoxItem Content="Pagada / Lista para Almacén" />
                                                        <ComboBoxItem Content="Emitida" />
                                                        <ComboBoxItem Content="Recibida Parcialmente" />
                                                        <ComboBoxItem Content="Recibida Completa" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,5,0">
                                                    <TextBlock Text="Condición de Pago" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboOcCondicionPago" FontSize="11.5">
                                                        <ComboBoxItem Content="Contado (Transferencia previa)" />
                                                        <ComboBoxItem Content="Crédito 15 días" />
                                                        <ComboBoxItem Content="Crédito 30 días" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="3,0,5,0">
                                                    <TextBlock Text="Fecha Prog. / Vo.Bo." FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <DatePicker x:Name="DpOcFechaProgramadaPago" FontSize="11.5" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="3"
                                                           VerticalAlignment="Bottom"
                                                           Appearance="Primary"
                                                           Content="Guardar Flujo"
                                                           ToolTip="Actualiza el estatus operativo, condición de pago y recordatorio en el Calendario Operativo"
                                                           Click="BtnActualizarFlujoOc_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <DataGrid x:Name="DgOrdenesCompra"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionChanged="DgOrdenesCompra_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="📥 Recibir Todo lo Pendiente de esta OC" Click="BtnRecibirTodoPendienteOc_Click" FontWeight="Bold" />
                                                <MenuItem Header="🖨️ Imprimir Orden de Compra" Click="BtnImprimirOcSeleccionada_Click" />
                                                <MenuItem Header="📄 Descargar Orden de Compra (PDF / PNG / CSV)" Click="BtnDescargarOcSeleccionada_Click" />
                                                <Separator />
                                                <MenuItem Header="🧾 Liquidar OC sin Factura (Nota / Remisión)" Click="BtnLiquidarOcSinFactura_Click" />
                                                <MenuItem Header="🔐 Forzar Estatus de OC (Administrador)" Click="BtnForzarEstatusOcAdmin_Click" />
                                                <Separator />
                                                <MenuItem Header="📋 Copiar Folio de OC" Click="CtxOrdenCompraCopiarFolio_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="105" />
                                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                            <DataGridTextColumn Header="Destino" Binding="{Binding ProyectoNombre}" Width="120" />
                                            <DataGridTextColumn Header="Condición" Binding="{Binding CondicionPago}" Width="105" />
                                            <DataGridTextColumn Header="Avance" Binding="{Binding AvanceRecepcionTexto}" Width="82" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="88" />
                                            <DataGridTemplateColumn Header="Estatus" Width="145">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Estatus}">
                                                            <TextBlock Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Recepción de Mercancía (Parcial o Completa) -->
                            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                                <ui:Button Content="Recibir Todo lo Pendiente"
                                                           FontSize="11"
                                                           Margin="0,0,6,0"
                                                           Click="BtnRecibirTodoPendienteOc_Click" />
                                                <ui:Button Content="Limpiar a 0"
                                                           FontSize="11"
                                                           Click="BtnLimpiarCantidadesRecepcionOc_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtTituloRecepcionOc" Text="Recepción de Mercancía (Parcial / Completa)" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Folio Remisión / Nota:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBox x:Name="TxtFolioRemisionRecepcionOc" Grid.Column="1" Margin="0,0,10,0" PlaceholderText="Ej. REM-4502 / Entrega Parcial 1 (Opcional)..." />
                                            <CheckBox x:Name="ChkReservarStockProyectoRecepcion" Grid.Column="2" Content="Reservar p/ Proyecto" IsChecked="True" VerticalAlignment="Center" ToolTip="Si la OC pertenece a un Proyecto, aparta este stock o permite generar su salida inmediata" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <TextBlock Text="Observaciones de esta Entrega Parcial o Total" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtNotasRecepcionOc" Margin="0,0,0,8" PlaceholderText="Ej. Se recibieron 4 piezas hoy sin daños, quedan pendientes para la próxima semana..." />
                                        <ui:Button Content="Registrar Entrada a Almacén (Parcial o Completa)"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Click="BtnRegistrarRecepcionOc_Click" />
                                    </StackPanel>

                                    <DataGrid x:Name="DgPartidasRecepcionOc" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="78" />
                                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="U. Compra" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="78" />
                                            <DataGridTextColumn Header="Factor" Binding="{Binding FactorConversion}" Width="58" />
                                            <DataGridTextColumn Header="Pedida" Binding="{Binding CantidadPedida}" IsReadOnly="True" Width="58" />
                                            <DataGridTextColumn Header="Recibida" Binding="{Binding CantidadRecibida}" IsReadOnly="True" Width="65" />
                                            <DataGridTextColumn Header="Pendiente" Binding="{Binding CantidadPendiente}" IsReadOnly="True" Width="68" />
                                            <DataGridTextColumn Header="Recibir Hoy" Binding="{Binding CantidadRecibirAhora}" Width="82" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Historial de Entradas -->
                        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <ui:Button Content="Descargar Entrada"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Descargar Vale de Entrada como archivo PDF, Imagen PNG o Excel CSV"
                                                   Click="BtnDescargarEntradaSeleccionada_Click" />
                                        <ui:Button Content="Imprimir Entrada" Icon="{ui:SymbolIcon Print24}" Click="BtnImprimirEntradaSeleccionada_Click" />
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Historial de Entradas y Recepciones Parciales" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <CheckBox x:Name="ChkFiltrarEntradasPorOc"
                                                  Content="Mostrar solo entregas de la OC seleccionada"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Checked="ChkFiltrarEntradasPorOc_Changed"
                                                  Unchecked="ChkFiltrarEntradasPorOc_Changed" />
                                    </WrapPanel>
                                </DockPanel>
                                <DataGrid x:Name="DgEntradasHistorial" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                        <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="120" />
                                        <DataGridTextColumn Header="Remisión / Factura" Binding="{Binding FacturaReferencia}" Width="130" />
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="180" />
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="190" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEntrada}" Width="145" />
                                        <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 5: ALMACÉN ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>

                        <!-- Barra de Búsqueda y Escaneo de Almacén -->
                        <Border Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="BarcodeScanner24"
                                               FontSize="20"
                                               Margin="4,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="#0078D4" />

                                <ui:TextBox x:Name="TxtBuscarAlmacen"
                                            Grid.Column="1"
                                            PlaceholderText="Buscar en Almacén o escanear código de barras (Producto, Entrada ENT-..., Salida SAL-..., Herramienta HER-... o Préstamo PRE-...)..."
                                            VerticalContentAlignment="Center"
                                            FontSize="13"
                                            PreviewKeyDown="TxtBuscarAlmacen_KeyDown"
                                            TextChanged="TxtBuscarAlmacen_TextChanged" />

                                <ui:Button Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Search24}"
                                           Content="Buscar / Agregar"
                                           Click="BtnBuscarAlmacen_Click" />

                                <ui:Button Grid.Column="3"
                                           Margin="6,0,0,0"
                                           Content="Limpiar Filtro"
                                           Click="BtnLimpiarBusquedaAlmacen_Click" />
                            </Grid>
                        </Border>

                        <!-- Cuerpo Central: Salida de Material y Préstamo de Herramienta -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Izquierda: Salida de Material -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel Margin="0,0,0,8">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Content="📥 Cargar de OC Recibida"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       ToolTip="Cargar automáticamente los artículos recibidos de una Orden de Compra para darles salida"
                                                       Click="BtnCargarMaterialOcRecibidaEnSalida_Click" />
                                            <TextBlock Text="Salida de Material" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Gerencia que Autoriza *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalDepartamento" SelectionChanged="CboSalDepartamento_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="Técnico / Empleado que Recibe *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalEncargado" IsEditable="True" PreviewKeyDown="CboSalEncargado_PreviewKeyDown" ToolTip="Seleccione del directorio o escriba libremente el nombre de quien recibe" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Proyecto / Destino (Opcional)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboSalProyecto" SelectionChanged="CboSalProyecto_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock x:Name="TxtContadorFiltroProductoSal" DockPanel.Dock="Right" Margin="8,0,0,0" Text="" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                                    <TextBlock Text="Buscar Artículo o Escanear con Pistola" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ui:TextBox x:Name="TxtSalBuscarProductoPos"
                                                            Margin="0,0,0,6"
                                                            PlaceholderText="Escriba nombre, código, marca o escanee código de barras (Enter agrega directo)..."
                                                            VerticalContentAlignment="Center"
                                                            TextChanged="TxtSalBuscarProductoPos_TextChanged"
                                                            PreviewKeyDown="TxtSalBuscarProductoPos_KeyDown" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="85" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="CboSalProductoPos"
                                                              Grid.Column="0"
                                                              Margin="0,0,6,0"
                                                              PreviewKeyDown="CboSalProductoPos_PreviewKeyDown" />
                                                    <ui:TextBox x:Name="TxtSalCantidadPos"
                                                                Grid.Column="1"
                                                                PlaceholderText="Cant. (1)"
                                                                Margin="0,0,6,0"
                                                                VerticalContentAlignment="Center"
                                                                PreviewKeyDown="TxtSalCantidadPos_KeyDown" />
                                                    <ui:Button Grid.Column="2" Appearance="Primary" Content="+ Agregar" Click="BtnAgregarPartidaSalidaPos_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <TextBlock Text="Observaciones de Salida" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtSalNotas" Margin="0,0,0,8" PlaceholderText="Ej. Entrega para instalación eléctrica en planta..." />
                                        <UniformGrid Columns="2">
                                            <ui:Button Content="Limpiar" Margin="0,0,6,0" Click="BtnLimpiarSalidaPos_Click" />
                                            <ui:Button Content="Registrar Salida" Appearance="Primary" Click="BtnRegistrarSalidaAlmacen_Click" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <DataGrid x:Name="DgPartidasSalidaPos" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="85" />
                                            <DataGridTextColumn Header="Material" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadEntregada}" Width="80" />
                                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadAlmacen}" IsReadOnly="True" Width="70" />
                                            <DataGridTemplateColumn Header="Acciones" Width="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="-" Padding="6,1" Margin="0,0,3,0" Click="BtnDisminuirPartidaSalidaPos_Click" ToolTip="Disminuir 1" />
                                                            <Button Content="+" Padding="6,1" Margin="0,0,3,0" Click="BtnAumentarPartidaSalidaPos_Click" ToolTip="Aumentar 1" />
                                                            <Button Content="✕" Padding="6,1" Foreground="#DC2626" Click="BtnQuitarPartidaSalidaPos_Click" ToolTip="Quitar de la salida" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Derecha: Préstamo de Herramienta -->
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel Margin="0,0,0,8">
                                            <ui:Button DockPanel.Dock="Right" Content="Nueva Herramienta" Margin="8,0,0,0" Click="BtnNuevaHerramientaIndividual_Click" />
                                            <TextBlock Text="Préstamo de Herramienta" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="125" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Depto. que Aprueba *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPreDepartamento" SelectionChanged="CboPreDepartamento_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="Persona que Recibe (Abierto) *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPrePersonaRecibe" IsEditable="True" ToolTip="Seleccione del directorio o escriba el nombre abierto de quien recibe la herramienta" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                <TextBlock Text="Proyecto Destino" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboPreProyecto" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                <TextBlock Text="Fecha Compromiso" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <DatePicker x:Name="DpPreFechaCompromiso" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CboHerramientaDisponible"
                                                      Grid.Column="0"
                                                      Margin="0,0,6,0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      PreviewKeyDown="CboHerramientaDisponible_PreviewKeyDown"
                                                      ToolTip="Seleccione una herramienta disponible y presione '+ Agregar a Lista' para incluir varias en un mismo vale PRE-xxxx" />
                                            <ui:Button Grid.Column="1"
                                                       Content="+ Agregar a Lista"
                                                       Margin="0,0,6,0"
                                                       ToolTip="Agregar esta herramienta a la lista actual para prestar varias en un solo Vale PRE-xxxx"
                                                       Click="BtnAgregarHerramientaAPrestamo_Click" />
                                            <ui:Button x:Name="BtnRegistrarPrestamoHer"
                                                       Grid.Column="2"
                                                       Appearance="Primary"
                                                       Content="Registrar Préstamo"
                                                       ToolTip="Emitir un único Vale de Préstamo (PRE-xxxx) con todas las herramientas de la lista"
                                                       Click="BtnPrestarHerramienta_Click" />
                                        </Grid>

                                        <!-- Lista de herramientas acumuladas para un mismo préstamo PRE-xxxx -->
                                        <Border x:Name="BdrListaHerramientasPorPrestar"
                                                Visibility="Collapsed"
                                                Padding="8,6"
                                                CornerRadius="6"
                                                Background="#EFF6FF"
                                                BorderBrush="#93C5FD"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Vaciar lista"
                                                            FontSize="10.5"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            Click="BtnLimpiarListaPrestamo_Click" />
                                                    <TextBlock x:Name="TxtResumenListaPrestamoHer"
                                                               Text="Lista para prestar en un solo vale (0 herramientas):"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#1E40AF"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ItemsControl x:Name="IcHerramientasPorPrestar">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White"
                                                                    BorderBrush="#60A5FA"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="7,3"
                                                                    Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CodigoIndividual}"
                                                                               FontFamily="Consolas"
                                                                               FontWeight="Bold"
                                                                               FontSize="11"
                                                                               Foreground="#1D4ED8"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding ProductoNombre}"
                                                                               FontSize="11"
                                                                               MaxWidth="185"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding ProductoNombre}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0" />
                                                                    <Button Content="✕"
                                                                            FontSize="10"
                                                                            Padding="4,0"
                                                                            Foreground="#DC2626"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip="Quitar de la lista"
                                                                            Tag="{Binding}"
                                                                            Click="BtnQuitarHerramientaDePrestamo_Click" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Devolución -->
                                    <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="6" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Devolución de Herramienta (Completa, Parcial o con Incidencia)" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CboEstadoRetornoHerramienta" Grid.Column="0" SelectedIndex="0" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="Bueno (Completo)" />
                                                    <ComboBoxItem Content="Incompleto / Falta Pieza" />
                                                    <ComboBoxItem Content="Dañado" />
                                                    <ComboBoxItem Content="Extraviado" />
                                                </ComboBox>
                                                <ui:TextBox x:Name="TxtObsRetornoHerramienta" Grid.Column="1" Margin="0,0,6,0" PlaceholderText="Observaciones al devolver (ej. faltó accesorio, se devuelve 1 de 2)..." />
                                                <ui:Button Grid.Column="2" Content="Registrar Devolución" Appearance="Primary" Margin="0,0,6,0" Click="BtnRegistrarDevolucionHerramienta_Click" />
                                                <ui:Button Grid.Column="3" Content="Imprimir Vale" Click="BtnReimprimirValePrestamo_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid x:Name="DgPrestamosHerramientas"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              MouseDoubleClick="DgPrestamosHerramientas_MouseDoubleClick">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <StackPanel Margin="0,0,0,4">
                                                                        <Border Background="#EFF6FF"
                                                                                BorderBrush="#93C5FD"
                                                                                BorderThickness="1"
                                                                                CornerRadius="5"
                                                                                Padding="8,5"
                                                                                Margin="0,2,0,1"
                                                                                Cursor="Hand"
                                                                                Tag="{Binding Name}"
                                                                                ToolTip="Clic para abrir devolución agrupada de este vale (seleccione qué sí y qué no llegó)"
                                                                                MouseLeftButtonUp="HeaderGrupoPrestamo_MouseLeftButtonUp">
                                                                            <DockPanel>
                                                                                <Button DockPanel.Dock="Right"
                                                                                        Content="🔄 Devolver / Revisar Vale"
                                                                                        FontSize="10.5"
                                                                                        FontWeight="Bold"
                                                                                        Padding="8,2"
                                                                                        Margin="8,0,0,0"
                                                                                        Background="#2563EB"
                                                                                        Foreground="White"
                                                                                        BorderThickness="0"
                                                                                        Cursor="Hand"
                                                                                        Tag="{Binding Name}"
                                                                                        Click="BtnAbrirDevolucionGrupoPrestamo_Click" />
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="11.5"
                                                                                           Foreground="#1E3A8A"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <ItemsPresenter />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="✔ Abrir Devolución Agrupada del Vale (PRE-xxxx)" Click="BtnRegistrarDevolucionHerramienta_Click" FontWeight="Bold" />
                                                <MenuItem Header="🖨️ Imprimir Hoja de Resguardo (PRE-xxxx)" Click="BtnReimprimirValePrestamo_Click" />
                                                <MenuItem Header="📄 Descargar Hoja de Resguardo (PDF / PNG / CSV)" Click="BtnDescargarValePrestamo_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Folio" Binding="{Binding FolioVale}" Width="90" />
                                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoIndividual}" Width="78" />
                                            <DataGridTextColumn Header="Herramienta" Binding="{Binding HerramientaDescripcion}" Width="*" />
                                            <DataGridTextColumn Header="Depto. Aprueba" Binding="{Binding DepartamentoNombre}" Width="105" />
                                            <DataGridTextColumn Header="Quien Recibe" Binding="{Binding EncargadoNombre}" Width="115" />
                                            <DataGridTextColumn Header="Fecha Promesa" Binding="{Binding FechaPromesa}" Width="95" />
                                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDevolucion}" Width="88" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Historial de Vales de Entrada y Salida en Almacén -->
                        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <ui:Button Content="🔄 Devolver Material Sobrante"
                                                   Appearance="Primary"
                                                   Margin="0,0,6,0"
                                                   ToolTip="Abrir ventana de devolución agrupada de material para indicar qué regresó y cuánto"
                                                   Click="BtnDevolverMaterialSalida_Click" />
                                        <Menu Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <MenuItem Header="📄 Opciones del Vale ▾" Padding="10,5" FontWeight="SemiBold">
                                                <MenuItem Header="📥 Descargar Vale (PDF / PNG / CSV)" Click="BtnDescargarMovimientoAlmacen_Click" />
                                                <MenuItem Header="🔄 Devolver Material Sobrante de Salida" Click="BtnDevolverMaterialSalida_Click" />
                                                <MenuItem Header="🦺 Generar Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                                            </MenuItem>
                                        </Menu>
                                        <ui:Button Content="Ver / Imprimir Vale" Icon="{ui:SymbolIcon Print24}" Click="BtnImprimirMovimientoAlmacen_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Historial de Entradas, Salidas y Devoluciones de Almacén" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataGrid x:Name="DgMovimientosAlmacen"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MouseDoubleClick="DgMovimientosAlmacen_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🖨️ Ver / Imprimir Vale" Click="BtnImprimirMovimientoAlmacen_Click" FontWeight="Bold" />
                                            <MenuItem Header="📥 Descargar Vale (PDF / PNG / CSV)" Click="BtnDescargarMovimientoAlmacen_Click" />
                                            <Separator />
                                            <MenuItem Header="🔄 Registrar Devolución de Material Sobrante" Click="BtnDevolverMaterialSalida_Click" />
                                            <MenuItem Header="🦺 Generar Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="125" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="95" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="125" />
                                        <DataGridTextColumn Header="Responsable / Proveedor" Binding="{Binding ResponsableOProveedor}" Width="210" />
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="220" />
                                        <DataGridTextColumn Header="Detalle / Notas" Binding="{Binding DetalleResumen}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 6: FACTURAS Y COMPRAS SIN FACTURA ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="215" />
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0" Margin="0,0,0,10" Padding="0,6,0,0">
                            <!-- SUB-TAB 1: FACTURA XML CFDI 4.0 -->
                            <TabItem Header="Cargar Factura XML (CFDI 4.0)">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Barra Superior XML -->
                                    <Border Grid.Row="0" Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <ui:Button Margin="0,0,8,0" Content="📂 Subir XML" Click="BtnSubirArchivoXml_Click" />
                                                    <ui:Button Appearance="Primary" Content="💾 Guardar Factura" Click="BtnGuardarFacturaXml_Click" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Facturas XML CFDI" FontSize="15.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtXmlResumenActual" Text="Seleccione un archivo XML para cargar sus conceptos." FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Proyecto Destino" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboXmlProyecto" SelectionChanged="CboXmlProyecto_SelectionChanged" ToolTip="Proyecto al que se asigna la compra (por defecto Stock General)" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                    <TextBlock Text="Orden de Compra (Emitida o Recibida)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboXmlOrdenCompra" SelectionChanged="CboXmlOrdenCompra_SelectionChanged" ToolTip="Asociar a una OC existente del proveedor (incluso si ya fue recibida con remisión) o crear una nueva automáticamente" />
                                                </StackPanel>

                                                <CheckBox x:Name="ChkXmlIngresarAlmacenAuto"
                                                          Grid.Column="2"
                                                          Content="Ingresar a Almacén al Guardar"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,4"
                                                          ToolTip="Si se marca y la mercancía aún no se ha recibido, registra automáticamente su entrada a Almacén al guardar el XML" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Conceptos XML -->
                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                    <ComboBox x:Name="CboXmlVincularProducto" Width="250" Margin="0,0,6,0" ToolTip="Seleccione un producto existente del catálogo para vincularlo" />
                                                    <ui:Button Content="Vincular a Existente" Margin="0,0,6,0" Click="BtnVincularConceptoXmlConProducto_Click" />
                                                    <ui:Button Content="Marcar como Nuevo" Margin="0,0,6,0" ToolTip="Desvincular para que se cree como un producto nuevo en el catálogo" Click="BtnMarcarConceptoComoNuevo_Click" />
                                                    <ui:Button Content="Crear Nuevos en Catálogo" Appearance="Primary" ToolTip="Crear en el catálogo los productos que aún no están registrados" Click="BtnCrearProductoDesdeConceptoXml_Click" />
                                                </WrapPanel>
                                                <TextBlock Text="Conceptos del XML" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <DataGrid x:Name="DgXmlConceptosActual" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Clave SAT" Binding="{Binding ClaveProdServ}" Width="90" />
                                                    <DataGridTextColumn Header="Identificación" Binding="{Binding NoIdentificacion}" Width="120" />
                                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                                                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="65" />
                                                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="110" />
                                                    <DataGridTextColumn Header="P. Unitario" Binding="{Binding ValorUnitario, StringFormat={}{0:C2}}" Width="105" />
                                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="105" />
                                                    <DataGridTextColumn Header="Estatus / Producto en Catálogo" Binding="{Binding ProductoVinculadoNombre}" Width="280" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 2: COMPRA SIN FACTURA (NOTA DE REMISIÓN / TICKET / EFECTIVO) -->
                            <TabItem Header="Registrar Compra sin Factura (Nota / Ticket)">
                                <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <CheckBox x:Name="ChkSinFacMasIva" Content="Agregar +16% IVA" IsChecked="False" Margin="0,0,14,0" Checked="ChkSinFacMasIva_Changed" Unchecked="ChkSinFacMasIva_Changed" />
                                                    <CheckBox x:Name="ChkSinFacIngresarAlmacen" Content="Ingresar mercancía automáticamente al Stock de Almacén" IsChecked="True" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Registro de Compra sin Factura XML (Nota de Remisión / Ticket)" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="Genera trazabilidad completa: Orden de Compra interna, actualización de costos, historial de compras y entrada opcional a Almacén." FontSize="11.5" Opacity="0.78" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Proveedor (Seleccione o escriba nombre abierto) *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboSinFacProveedor" IsEditable="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,6,0">
                                                    <TextBlock Text="Proyecto Destino *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboSinFacProyecto" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                                    <TextBlock Text="Folio Nota / Ticket *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtSinFacFolioNota" PlaceholderText="Ej. NOTA-402" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                    <TextBlock Text="Observaciones / Quién compró" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtSinFacNotas" PlaceholderText="Ej. Compra urgente en mostrador..." />
                                                </StackPanel>
                                            </Grid>

                                            <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="85" />
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtBuscarProdSinFac"
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                PlaceholderText="Filtrar producto o código..."
                                                                TextChanged="TxtBuscarProdSinFac_TextChanged" />
                                                    <ComboBox x:Name="CboSinFacProducto"
                                                              Grid.Column="1"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="CboSinFacProducto_SelectionChanged" />
                                                    <ui:TextBox x:Name="TxtSinFacCantidad"
                                                                Grid.Column="2"
                                                                PlaceholderText="Cant. (1)"
                                                                Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtSinFacPrecioUnitario"
                                                                Grid.Column="3"
                                                                PlaceholderText="Costo Unit. ($)"
                                                                Margin="0,0,6,0" />
                                                    <ui:Button Grid.Column="4"
                                                               Content="+ Agregar a la Nota"
                                                               Appearance="Primary"
                                                               Click="BtnAgregarPartidaSinFactura_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <ui:Button Content="Limpiar Nota" Margin="0,0,8,0" Click="BtnLimpiarCompraSinFactura_Click" />
                                                <ui:Button Content="Registrar Compra sin Factura (Admin)"
                                                           Appearance="Primary"
                                                           Click="BtnRegistrarCompraSinFactura_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSinFacResumenTotal"
                                                       Text="Partidas: 0 | Total Compra: $0.00"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="#107C10"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <DataGrid x:Name="DgPartidasCompraSinFactura" AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="95" />
                                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" IsReadOnly="True" Width="105" />
                                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90" />
                                                <DataGridTextColumn Header="Costo Unitario ($)" Binding="{Binding PrecioUnitarioSinIva, StringFormat={}{0:C2}}" Width="130" />
                                                <DataGridTextColumn Header="Importe ($)" Binding="{Binding ImporteSinIva, StringFormat={}{0:C2}}" IsReadOnly="True" Width="125" />
                                                <DataGridTemplateColumn Header="Quitar" Width="85">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Quitar" Padding="6,2" Background="#DC2626" Foreground="White" Click="BtnQuitarPartidaSinFactura_Click" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                        </TabControl>

                        <!-- Facturas y Notas Registradas -->
                        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right"
                                               Content="Eliminar Comprobante (Admin)"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Margin="8,0,0,0"
                                               ToolTip="Eliminar la factura o nota seleccionada del sistema (Requiere PIN Administrador)"
                                               Click="BtnEliminarFacturaXml_Click" />
                                    <TextBlock Text="Comprobantes Registrados (Facturas XML y Notas sin Factura)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataGrid x:Name="DgFacturasRegistradas" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgFacturasRegistradas_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoComprobante}" Width="120" />
                                        <DataGridTextColumn Header="UUID / Referencia" Binding="{Binding Uuid}" Width="185" />
                                        <DataGridTextColumn Header="Folio" Binding="{Binding SerieFolio}" Width="95" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTimbrado}" Width="125" />
                                        <DataGridTextColumn Header="RFC" Binding="{Binding EmisorRfc}" Width="110" />
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding EmisorNombre}" Width="*" />
                                        <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="110" />
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="145" />
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="90" />
                                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva, StringFormat={}{0:C2}}" Width="80" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 7: ANÁLISIS ==================== -->
                <TabItem>
                    <TabControl Padding="0,6,0,0">
                        <!-- SUB-TAB 1: RANKING GENERAL DE MATERIALES CONCURRENTES Y ESTIMACIÓN DE COMPRAS -->
                        <TabItem Header="Ranking de Materiales y Proyección de Compras">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <ui:Button Content="Mandar Artículo Seleccionado a Solicitud / Cotización"
                                                       Appearance="Primary"
                                                       Click="BtnEnviarRankingASolicitud_Click" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ranking General de Materiales Concurrentes y Estimación de Abastecimiento" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="Identifica los artículos más solicitados y consumidos en almacén, vigencia de su última cotización y cantidad sugerida de compra futura." FontSize="11.5" Opacity="0.78" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DataGrid x:Name="DgRankingMaterialesAnalisis"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionChanged="DgRankingMaterialesAnalisis_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🛒 Mandar Artículo a Solicitud / Cotización" Click="BtnEnviarRankingASolicitud_Click" FontWeight="Bold" />
                                                <MenuItem Header="🗺️ Ver / Cambiar Ubicación en Mapa 3×3 (A–F)" Click="CtxRankingAbrirMapa_Click" />
                                                <MenuItem Header="✏️ Abrir Ficha del Producto en Catálogo" Click="CtxRankingEditarProducto_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" Width="88" />
                                            <DataGridTextColumn Header="Artículo / Material" Binding="{Binding ProductoNombre}" Width="*" />
                                            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaNombre}" Width="140" />
                                            <DataGridTextColumn Header="Solicitudes" Binding="{Binding FrecuenciaSolicitudes}" Width="78" />
                                            <DataGridTextColumn Header="Salidas Alm." Binding="{Binding FrecuenciaSalidas}" Width="82" />
                                            <DataGridTextColumn Header="Consumo Neto" Binding="{Binding CantidadTotalConsumida, StringFormat={}{0:0.##}}" Width="92" />
                                            <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual, StringFormat={}{0:0.##}}" Width="82" />
                                            <DataGridTextColumn Header="Sugerido Comprar" Binding="{Binding SugerenciaCompra, StringFormat={}{0:0.##}}" Width="105" />
                                            <DataGridTextColumn Header="Último Precio c/IVA" Binding="{Binding UltimoPrecioConIva, StringFormat={}{0:C2}}" Width="110" />
                                            <DataGridTextColumn Header="Vigencia Cotización" Binding="{Binding VigenciaPrecioTexto}" Width="125" />
                                            <DataGridTextColumn Header="Último Proveedor" Binding="{Binding UltimoProveedorNombre}" Width="135" />
                                            <DataGridTextColumn Header="Prioridad" Binding="{Binding PrioridadAbasto}" Width="145" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- SUB-TAB 2: PROVEEDORES, PROYECTOS Y GRÁFICAS DE PRECIOS -->
                        <TabItem Header="Proveedores, Proyectos e Historial de Precios">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.92*" />
                                    <RowDefinition Height="1.08*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Compras por Proveedor" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgAnalisisProveedores" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="RFC" Binding="{Binding Rfc}" Width="115" />
                                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
                                                    <DataGridTextColumn Header="Órdenes" Binding="{Binding NumOrdenes}" Width="85" />
                                                    <DataGridTextColumn Header="Entrega" Binding="{Binding DiasPromedio}" Width="90" />
                                                    <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal, StringFormat={}{0:C2}}" Width="125" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="Seleccione un producto para graficar abajo" FontSize="11.5" Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="Frecuencia de Compra por Producto" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgAnalisisProductos"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgAnalisisProductos_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" />
                                                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                                                    <DataGridTextColumn Header="Frecuencia" Binding="{Binding Frecuencia}" Width="95" />
                                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadTotal}" Width="115" />
                                                    <DataGridTextColumn Header="Importe" Binding="{Binding ImporteTotal, StringFormat={}{0:C2}}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.78*" />
                                        <ColumnDefinition Width="1.22*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Gasto por Proyecto y Departamento" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgAnalisisProyectos" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="*" />
                                                    <DataGridTextColumn Header="Departamento / Área" Binding="{Binding Departamento}" Width="155" />
                                                    <DataGridTextColumn Header="Compras (OCs)" Binding="{Binding TotalCompras, StringFormat={}{0:C2}}" Width="110" />
                                                    <DataGridTextColumn Header="Salidas Almacén" Binding="{Binding TotalSalidas, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <!-- Gráficas de Dispersión y Barras al seleccionar un Producto -->
                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="210" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtBuscarProductoAnalisis"
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                PlaceholderText="Buscar producto..."
                                                                TextChanged="TxtBuscarProductoAnalisis_TextChanged" />
                                                    <ComboBox x:Name="CboProductoAnalisis"
                                                              Grid.Column="1"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="CboProductoAnalisis_SelectionChanged" />
                                                    <ComboBox x:Name="CboMetricaBarrasAnalisis"
                                                              Grid.Column="2"
                                                              SelectedIndex="0"
                                                              SelectionChanged="CboMetricaBarrasAnalisis_SelectionChanged">
                                                        <ComboBoxItem Content="Barras: Gasto ($) por Proveedor" />
                                                        <ComboBoxItem Content="Barras: Cantidad por Proveedor" />
                                                        <ComboBoxItem Content="Barras: Gasto Mensual ($)" />
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock x:Name="TxtResumenGraficaProducto"
                                                           Text="Seleccione un producto arriba para visualizar su dispersión histórica de precios unitarios y comparativa en barras."
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E40AF" />
                                            </StackPanel>

                                            <UniformGrid Columns="2">
                                                <!-- Gráfica de Dispersión: Precio Unitario vs Fecha -->
                                                <Border Margin="0,0,5,0" Padding="8" CornerRadius="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Top" Text="Dispersión: Precio Unitario (s/IVA) vs Fecha" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4" />
                                                        <Canvas x:Name="CanvasDispersionProducto"
                                                                ClipToBounds="True"
                                                                SizeChanged="CanvasGraficasProducto_SizeChanged" />
                                                    </DockPanel>
                                                </Border>

                                                <!-- Gráfica de Barras Comparativa -->
                                                <Border Margin="5,0,0,0" Padding="8" CornerRadius="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtTituloGraficaBarras" DockPanel.Dock="Top" Text="Barras: Comparativa por Proveedor" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4" />
                                                        <Canvas x:Name="CanvasBarrasProducto"
                                                                ClipToBounds="True"
                                                                SizeChanged="CanvasGraficasProducto_SizeChanged" />
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ==================== TAB 8: DIRECTORIOS (VER, DESGLOSAR, MODIFICAR Y ELIMINAR) ==================== -->
                <TabItem>
                    <TabControl Padding="0,8,0,0">
                        <!-- SUB-TAB 1: PROVEEDORES -->
                        <TabItem Header="Proveedores">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Proveedores Registrados" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirProveedores"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirProveedores_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="RFC" Binding="{Binding Rfc}" Width="115" />
                                                    <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}" Width="155" />
                                                    <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocial}" Width="*" />
                                                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="125" />
                                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="105" />
                                                    <DataGridTextColumn Header="Condiciones" Binding="{Binding CondicionesPago}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesgloseProveedorTitulo" DockPanel.Dock="Top" Text="Desglose del Proveedor" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <DataGrid x:Name="DgDesgloseProveedor" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                                                    <DataGridTextColumn Header="Folio / UUID" Binding="{Binding Folio}" Width="150" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Detalle / Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="135" />
                                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoProveedor_Click" />
                                            <TextBlock Text="Datos del Proveedor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="RFC" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvRfc" PlaceholderText="Ej. FIE920315AB1" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Nombre Comercial" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvComercial" PlaceholderText="Ej. FerreIndustrial" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Razón Social" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvRazon" Margin="0,0,0,6" PlaceholderText="Ej. Ferretería Industrial S.A. de C.V." />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Persona de Contacto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvContacto" PlaceholderText="Ej. Ing. Pedro Gómez" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Teléfono" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvTelefono" PlaceholderText="Ej. 55-1234-5678" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Correo Electrónico" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvCorreo" Margin="0,0,0,6" PlaceholderText="Ej. ventas@proveedor.com" />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Condiciones de Pago" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvCondiciones" PlaceholderText="Ej. Contado / Crédito 30 días" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Entrega (Días)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvDias" PlaceholderText="Ej. 3 días" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Notas / Datos Bancarios" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvNotas" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" PlaceholderText="Ej. Envío gratis en pedidos mayores a $2,500, cuenta CLABE..." />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proveedor" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProveedor_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProveedor_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 2: PROYECTOS Y CLIENTES / ÁREAS -->
                        <TabItem Header="Proyectos y Clientes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Proyectos y Clientes / Áreas" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirProyectos"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirProyectos_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                                                    <DataGridTextColumn Header="Proyecto" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn Header="Cliente / Área" Binding="{Binding ClienteArea}" Width="180" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesgloseProyectoTitulo" DockPanel.Dock="Top" Text="Desglose del Proyecto" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <DataGrid x:Name="DgDesgloseProyecto" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Movimiento" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="125" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Responsable / Proveedor" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="130" />
                                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoProyecto_Click" />
                                            <TextBlock Text="Datos del Proyecto" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="Código del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyCodigo" Margin="0,0,0,6" PlaceholderText="Ej. PRY-2026-04" />

                                        <TextBlock Text="Nombre del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyNombre" Margin="0,0,0,6" PlaceholderText="Ej. Celda de Ensamble Línea 3" />

                                        <TextBlock Text="Cliente o Área Asignada" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyArea" Margin="0,0,0,6" PlaceholderText="Ej. Planta Norte / Cliente Automotriz" />

                                        <TextBlock Text="Estatus" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CboProyEstatus" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Activo" />
                                            <ComboBoxItem Content="Pausado" />
                                            <ComboBoxItem Content="Cerrado" />
                                        </ComboBox>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proyecto" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProyecto_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProyecto_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 3: PERSONAL (GERENTES / SOLICITANTES) Y DEPARTAMENTOS -->
                        <TabItem Header="Personal y Departamentos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Personal / Gerentes / Solicitantes" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirPersonal"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirPersonal_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn Header="Departamento" Binding="{Binding DepartamentoNombre}" Width="190" />
                                                    <DataGridTextColumn Header="Puesto" Binding="{Binding Puesto}" Width="180" />
                                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesglosePersonalTitulo" DockPanel.Dock="Top" Text="Desglose de Solicitudes, Salidas y Préstamos" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <DataGrid x:Name="DgDesglosePersonal" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="125" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoEncargado_Click" />
                                                    <TextBlock Text="Datos del Personal" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Departamento Asignado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboAltaEncargadoDepto" Margin="0,0,0,6" />

                                                <TextBlock Text="Nombre Completo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtAltaEncargadoNombre" Margin="0,0,0,6" PlaceholderText="Ej. Ing. Carlos Mendoza" />

                                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Puesto / Cargo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoPuesto" PlaceholderText="Ej. Gerente Mecánico" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Teléfono / Ext." FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoTelefono" PlaceholderText="Ej. 55-1020-3040" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Personal" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarEncargado_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarEncargado_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoDepartamento_Click" />
                                                    <TextBlock Text="Departamentos" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <DataGrid x:Name="DgDirDepartamentos"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          Height="145"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="DgDirDepartamentos_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" />
                                                        <DataGridTextColumn Header="Departamento" Binding="{Binding Nombre}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoCodigo" PlaceholderText="Ej. ING-MEC" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Nombre del Departamento" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoNombre" PlaceholderText="Ej. Ingeniería Mecánica" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Departamento" HorizontalAlignment="Stretch" Click="BtnGuardarDepartamento_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarDepartamento_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 4: HERRAMIENTAS Y CATEGORÍAS -->
                        <TabItem Header="Herramientas y Categorías">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.25*" />
                                        <RowDefinition Height="0.75*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <ui:Button DockPanel.Dock="Right"
                                                           Content="🗺️ Mapa e Inventario por Cuadrante"
                                                           FontSize="11.5"
                                                           Padding="10,4"
                                                           ToolTip="Ver mapa gráfico 3x3 de anaqueles A–F y consultar qué herramientas y materiales hay en cada cuadrante"
                                                           Click="BtnAbrirMapaAnaqueles_Click" />
                                                <TextBlock Text="Inventario Individual de Herramientas" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgDirHerramientas"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirHerramientas_SelectionChanged">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="🤝 Prestar esta Herramienta (Ir a Vale de Préstamo)" Click="CtxDirHerPrestar_Click" FontWeight="Bold" />
                                                        <MenuItem Header="🗺️ Reubicar en Mapa Gráfico 3×3 (A–F)" Click="CtxDirHerReubicarMapa_Click" />
                                                        <Separator />
                                                        <MenuItem Header="✅ Marcar como Disponible" Click="CtxDirHerMarcarDisponible_Click" />
                                                        <MenuItem Header="🛠️ Marcar como Dañada / Mantenimiento" Click="CtxDirHerMarcarDanada_Click" />
                                                        <Separator />
                                                        <MenuItem Header="📋 Copiar Código HER-xxxx y Serie" Click="CtxDirHerCopiarCodigo_Click" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding CodigoIndividual}" Width="95" />
                                                    <DataGridTextColumn Header="Herramienta" Binding="{Binding ProductoNombre}" Width="*" />
                                                    <DataGridTextColumn Header="Marca / Modelo" Binding="{Binding MarcaModelo}" Width="140" />
                                                    <DataGridTextColumn Header="Núm. Serie" Binding="{Binding NumeroSerie}" Width="115" />
                                                    <DataGridTemplateColumn Header="Estado" Width="125">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource StatusPillBorderStyle}" DataContext="{Binding Estado}">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="105" />
                                                    <DataGridTextColumn Header="En Resguardo De" Binding="{Binding EncargadoActual}" Width="135" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Categorías del Catálogo Visual" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirCategorias"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirCategorias_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                                                    <DataGridTextColumn Header="Nombre de la Categoría" Binding="{Binding Nombre}" Width="240" />
                                                    <DataGridTextColumn Header="Campos Técnicos de esta Categoría" Binding="{Binding CamposResumen}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nueva" Margin="8,0,0,0" Click="BtnNuevaHerramientaDir_Click" />
                                                    <TextBlock Text="Datos de la Herramienta" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Producto Base" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboDirHerProducto" Margin="0,0,0,6" />

                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código Individual" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerCodigo" FontFamily="Consolas" PlaceholderText="Ej. HER-0007" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Número de Serie" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerSerie" PlaceholderText="Ej. BOS-882910 o S/N" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="Marca / Modelo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerMarca" Margin="0,0,0,6" PlaceholderText="Ej. Bosch GSB 16 RE" />

                                                <TextBlock Text="Estado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboDirHerEstado" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="Disponible" />
                                                    <ComboBoxItem Content="En Préstamo" />
                                                    <ComboBoxItem Content="Dañada" />
                                                    <ComboBoxItem Content="Extraviada / Baja" />
                                                </ComboBox>

                                                <TextBlock Text="Ubicación en Almacén (Anaquel A–F, Detrás de A, Gabinete o Piso)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="TxtDirHerUbicacion"
                                                              Grid.Column="0"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="True"
                                                              ToolTip="Seleccione de la lista desplegable o escriba la ubicación (Ej. A-04, DETRAS-A-01, GABINETE-01)"
                                                              SelectionChanged="CboUbicacionAlmacen_SelectionChanged" />
                                                    <ui:Button Grid.Column="1"
                                                               Content="🗺️ Mapa"
                                                               FontSize="11.5"
                                                               Padding="10,5"
                                                               Margin="6,0,0,0"
                                                               ToolTip="Abrir selector gráfico 3x3 de anaquel y cuadrante"
                                                               Click="BtnSelectorUbicacionDirHer_Click" />
                                                </Grid>

                                                <TextBlock Text="Notas / Accesorios Incluidos" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerNotas" Margin="0,0,0,10" PlaceholderText="Ej. En maletín con llave de mandril..." />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Herramienta" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarHerramientaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarHerramientaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Nueva" Margin="8,0,0,0" Click="BtnNuevaCategoriaDir_Click" />
                                                    <TextBlock Text="Categoría y Plantilla Técnica" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="Nombre de la Categoría" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatNombre" Margin="0,0,0,6" PlaceholderText="Ej. Refrigeración y Aire Acondicionado" />

                                                <TextBlock Text="Etiqueta Campo Técnico 1" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo1" Margin="0,0,0,6" PlaceholderText="Ej. Capacidad Eléctrica / Voltaje" />

                                                <TextBlock Text="Etiqueta Campo Técnico 2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo2" Margin="0,0,0,6" PlaceholderText="Ej. Corriente / Potencia / Material" />

                                                <TextBlock Text="Etiqueta Campo Técnico 3" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatCampo3" Margin="0,0,0,8" PlaceholderText="Ej. Gas / Polos / Color / Norma" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Categoría" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarCategoriaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarCategoriaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Indicador global de carga / procesamiento -->
        <Grid x:Name="OverlayCargando"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="999"
              Background="#75000000"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,22"
                    CornerRadius="12"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="44"
                                     Height="44"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,12" />
                    <TextBlock x:Name="TxtMensajeCargando"
                               Text="Procesando..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Por favor espera un momento"
                               FontSize="11.5"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
