                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Familia Genérica" Binding="{Binding Familia}" Width="150" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" Width="88" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Insumo" Binding="{Binding ProductoNombre}" Width="*" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Prom. Histórico" Binding="{Binding PrecioPromedioHistorico, StringFormat={}{0:C2}}" Width="118" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Último Pagado" Binding="{Binding UltimoPrecioPagado, StringFormat={}{0:C2}}" Width="115" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Variación %" Binding="{Binding VariacionPctTexto}" Width="115" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant. Reciente" Binding="{Binding CantidadCompradaReciente, StringFormat={}{0:0.##}}" Width="105" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Impacto PPV ($)" Binding="{Binding PpvResultadoTexto}" Width="155" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Último Proveedor" Binding="{Binding UltimoProveedor}" Width="140" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Diagnóstico" Binding="{Binding DiagnosticoInflacion}" Width="210" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="3 · Auditoría de Consumo, Sobrantes y Resguardo por Cuadrilla">
                                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <ui:Button DockPanel.Dock="Right" Content="Actualizar Auditoría" FontSize="11.5" Padding="8,4" Click="BtnRefrescarEconomiaIndustrial_Click" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Control de Agencia por Responsable / Cuadrilla (Salidas, Sobrantes, Kits e Incidencias)" FontSize="14.5" FontWeight="Bold" />
                                                        <TextBlock Text="Monitorea el retiro de consumibles, reingreso de sobrantes de obra, herramientas en resguardo activo e incidencias o mermas reportadas." FontSize="11.2" Opacity="0.75" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="DgAuditoriaCuadrillas" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Responsable / Cuadrilla" Binding="{Binding ResponsableOCuadrilla}" Width="*" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto Frecuente" Binding="{Binding ProyectoReciente}" Width="175" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Vales Salida" Binding="{Binding ValesSalidaCount}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unid. Retiradas" Binding="{Binding UnidadesRetiradas, StringFormat={}{0:0.##}}" Width="115" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Sobrantes Devueltos" Binding="{Binding UnidadesSobranteReingresadas, StringFormat={}{0:0.##}}" Width="130" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Kits Usados" Binding="{Binding KitsDespachados}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Herram. en Resguardo" Binding="{Binding HerramientasEnResguardoActivo}" Width="140" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Incidencias / Mermas" Binding="{Binding IncidenciasOMermasRegistradas}" Width="135" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Costo Estimado" Binding="{Binding CostoEstimadoRetirado, StringFormat={}{0:C2}}" Width="125" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Diagnóstico de Control" Binding="{Binding EstadoControlAgencia}" Width="185" FontWeight="SemiBold" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ==================== TAB 8: DIRECTORIOS (VER, DESGLOSAR, MODIFICAR Y ELIMINAR) ==================== -->
                <TabItem>
                    <TabControl Padding="0,8,0,0">
                        <!-- SUB-TAB 1: PROVEEDORES -->
                        <TabItem Header="Proveedores">
