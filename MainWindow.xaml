                                                Margin="0,0,0,10"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <ui:Button x:Name="BtnToggleTablaAnalisisPaso3"
                                                                   Content="Ver/Ocultar Desglose por Partida"
                                                                   FontSize="11"
                                                                   Padding="8,4"
                                                                   Click="BtnToggleTablaAnalisisPaso3_Click" />
                                                    </StackPanel>
                                                    <TextBlock Text="Inteligencia de Compras · Análisis Comparativo de Escenarios y Ahorros (Exclusivo Compras)"
                                                               FontWeight="Bold"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>

                                                <!-- 4 Tarjetas de Escenarios y Ahorro -->
                                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                                    <!-- Tarjeta 1: Selección Adjudicada Actual -->
                                                    <Border Padding="10,8" Margin="0,0,6,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="1. SELECCIÓN ADJUDICADA" FontSize="10.5" FontWeight="Bold" Opacity="0.72" />
                                                            <TextBlock x:Name="TxtKpiCompActualTotal" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,2" />
                                                            <TextBlock x:Name="TxtKpiCompActualSub" Text="0 de 0 partidas decididas" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Tarjeta 2: Mix Óptimo (Mejor Precio por Partida) -->
                                                    <Border Padding="10,8" Margin="3,0,3,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="2. ESCENARIO MIX ÓPTIMO" FontSize="10.5" FontWeight="Bold" Opacity="0.72" />
                                                            <TextBlock x:Name="TxtKpiCompOptimoTotal" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#107C41" Margin="0,2,0,2" />
                                                            <TextBlock x:Name="TxtKpiCompOptimoSub" Text="Combinando mejor precio por ítem" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Tarjeta 3: Comparativa 1 Solo Proveedor (Consolidado) -->
                                                    <Border Padding="10,8" Margin="3,0,3,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="3. TODO CON 1 SOLO PROVEEDOR" FontSize="10.5" FontWeight="Bold" Opacity="0.72" />
                                                            <TextBlock x:Name="TxtKpiCompUnicoProvResumen" Text="Sin cotizaciones" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Tarjeta 4: Ahorro Obtenido ($ y %) -->
                                                    <Border Padding="10,8" Margin="6,0,0,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="4. AHORRO OBTENIDO ($ Y %)" FontSize="10.5" FontWeight="Bold" Opacity="0.72" />
                                                            <TextBlock x:Name="TxtKpiCompAhorroTotal" Text="$0.00 (0.0%)" FontSize="15.5" FontWeight="Bold" Foreground="#107C41" Margin="0,2,0,2" />
                                                            <TextBlock x:Name="TxtKpiCompAhorroSub" Text="vs. opción más alta y promedio" FontSize="11" Opacity="0.82" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <!-- Desglose por partida de diferencias de precios -->
                                                <DataGrid x:Name="DgAnalisisDiferenciasComp"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          MaxHeight="155"
                                                          Margin="0,2,0,0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="78" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículo" Binding="{Binding Producto}" Width="*" MinWidth="150" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cant." Binding="{Binding Cantidad}" Width="48" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Mín. c/IVA" Binding="{Binding MejorPrecioTotalConIva, StringFormat={}{0:C2}}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Prom. c/IVA" Binding="{Binding PromedioTotalConIva, StringFormat={}{0:C2}}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Máx. c/IVA" Binding="{Binding PeorPrecioTotalConIva, StringFormat={}{0:C2}}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Adjudicado a" Binding="{Binding ProveedorElegido}" Width="120" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Elegido c/IVA" Binding="{Binding ElegidoTotalConIva, StringFormat={}{0:C2}}" Width="100" FontWeight="Bold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Ahorro vs. Máx." Binding="{Binding AhorroVsMaximoTexto}" Width="115" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Diagnóstico Compras" Binding="{Binding DiagnosticoDiferencia}" Width="155" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid x:Name="DgPrevisualizacionOcs"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor Adjudicado" Binding="{Binding ProveedorNombre}" Width="185" FontWeight="SemiBold" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículos / Códigos" Binding="{Binding ProductosResumen}" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Subtotal s/IVA" Binding="{Binding SubtotalSinIva, StringFormat={}{0:C2}}" Width="105" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="IVA (16%)" Binding="{Binding IvaTotal, StringFormat={}{0:C2}}" Width="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Partidas" Binding="{Binding CantidadPartidas}" Width="90" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entrega" Binding="{Binding DiasEntregaMax, StringFormat={}{0} días}" Width="80" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Envío c/IVA" Binding="{Binding FleteConIva, StringFormat={}{0:C2}}" Width="110" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total OC c/IVA" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="125" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
