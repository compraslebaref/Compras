                                                       Grid.Column="2"
                                                       Margin="8,0,0,0"
                                                       Content="Finalizar Cotización / Convertir"
                                                       ToolTip="Si es Solo Cotización marca como entregada, o convierte el presupuesto aprobado en Requerimiento de Compra"
                                                       Click="BtnConvertirPresupuestoEnCompra_Click" />
                                            <ui:Button x:Name="BtnGenerarOrdenesDesdeComparativa"
                                                       Grid.Column="3"
                                                       Margin="8,0,0,0"
