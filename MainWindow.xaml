                                                </StackPanel>
                                            </DockPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Proveedor (Seleccione o escriba nombre abierto) *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboSinFacProveedor" IsEditable="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,6,0">
                                                    <TextBlock Text="Proyecto Destino *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="CboSinFacProyecto" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                                    <TextBlock Text="Folio Nota / Ticket *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtSinFacFolioNota" PlaceholderText="Ej. NOTA-402" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                    <TextBlock Text="Observaciones / Quién compró" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtSinFacNotas" PlaceholderText="Ej. Compra urgente en mostrador..." />
                                                </StackPanel>
                                            </Grid>

                                            <Border Padding="8" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="85" />
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtBuscarProdSinFac"
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                PlaceholderText="Filtrar producto o código..."
                                                                TextChanged="TxtBuscarProdSinFac_TextChanged" />
                                                    <ComboBox x:Name="CboSinFacProducto"
                                                              Grid.Column="1"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="CboSinFacProducto_SelectionChanged" />
                                                    <ui:TextBox x:Name="TxtSinFacCantidad"
                                                                Grid.Column="2"
                                                                PlaceholderText="Cant. (1)"
                                                                Margin="0,0,6,0" />
                                                    <ui:TextBox x:Name="TxtSinFacPrecioUnitario"
                                                                Grid.Column="3"
                                                                PlaceholderText="Costo Unit. ($)"
                                                                Margin="0,0,6,0" />
                                                    <ui:Button Grid.Column="4"
                                                               Content="+ Agregar a la Nota"
                                                               Appearance="Primary"
                                                               Click="BtnAgregarPartidaSinFactura_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <ui:Button Content="Limpiar Nota" Margin="0,0,8,0" Click="BtnLimpiarCompraSinFactura_Click" />
                                                <ui:Button Content="Registrar Compra sin Factura (Admin)"
                                                           Appearance="Primary"
                                                           Click="BtnRegistrarCompraSinFactura_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSinFacResumenTotal"
                                                       Text="Partidas: 0 | Total Compra: $0.00"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="#107C10"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <DataGrid x:Name="DgPartidasCompraSinFactura" AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="95" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Unidad" Binding="{Binding Unidad}" IsReadOnly="True" Width="105" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cantidad" Binding="{Binding Cantidad}" Width="90" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Costo Unitario ($)" Binding="{Binding PrecioUnitarioSinIva, StringFormat={}{0:C2}}" Width="155" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Importe ($)" Binding="{Binding ImporteSinIva, StringFormat={}{0:C2}}" IsReadOnly="True" Width="125" />
                                                <DataGridTemplateColumn Header="Quitar" Width="85">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Quitar" Padding="6,2" Background="#DC2626" Foreground="White" Click="BtnQuitarPartidaSinFactura_Click" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                                    <!-- ==================== TAB 7: ANÁLISIS ==================== -->
                <TabItem>
                    <TabControl x:Name="TcSubAnalisis" Padding="0,6,0,0">
                        <!-- SUB-TAB 1: RANKING GENERAL DE MATERIALES CONCURRENTES Y ESTIMACIÓN DE COMPRAS -->
                        <TabItem Header="Ranking de Materiales y Proyección de Compras">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <ui:Button Content="Mandar Artículo Seleccionado a Solicitud / Cotización"
                                                       Appearance="Primary"
                                                       Click="BtnEnviarRankingASolicitud_Click" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ranking General de Materiales Concurrentes y Estimación de Abastecimiento" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="Identifica los artículos más solicitados y consumidos en almacén, vigencia de su última cotización y cantidad sugerida de compra futura." FontSize="11.5" Opacity="0.78" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DataGrid x:Name="DgRankingMaterialesAnalisis"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionChanged="DgRankingMaterialesAnalisis_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Mandar Artículo a Solicitud / Cotización" Click="BtnEnviarRankingASolicitud_Click" FontWeight="Bold" />
                                                <MenuItem Header="Ver / Cambiar Ubicación en Mapa 3×3 (A–F)" Click="CtxRankingAbrirMapa_Click" />
                                                <MenuItem Header="Abrir Ficha del Producto en Catálogo" Click="CtxRankingEditarProducto_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding ProductoCodigo}" Width="88" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Artículo / Material" Binding="{Binding ProductoNombre}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Categoría" Binding="{Binding CategoriaNombre}" Width="140" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Solicitudes" Binding="{Binding FrecuenciaSolicitudes}" Width="110" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Salidas Alm." Binding="{Binding FrecuenciaSalidas}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Consumo Neto" Binding="{Binding CantidadTotalConsumida, StringFormat={}{0:0.##}}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Stock Actual" Binding="{Binding StockActual, StringFormat={}{0:0.##}}" Width="115" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Sugerido Comprar" Binding="{Binding SugerenciaCompra, StringFormat={}{0:0.##}}" Width="140" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Último Precio c/IVA" Binding="{Binding UltimoPrecioConIva, StringFormat={}{0:C2}}" Width="160" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Vigencia Cotización" Binding="{Binding VigenciaPrecioTexto}" Width="160" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Último Proveedor" Binding="{Binding UltimoProveedorNombre}" Width="140" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Prioridad" Binding="{Binding PrioridadAbasto}" Width="145" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- SUB-TAB 2: PROVEEDORES, PROYECTOS Y GRÁFICAS DE PRECIOS -->
                        <TabItem Header="Proveedores">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Compras por Proveedor" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgAnalisisProveedores" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="RFC" Binding="{Binding Rfc}" Width="115" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Órdenes" Binding="{Binding NumOrdenes}" Width="85" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Entrega" Binding="{Binding DiasPromedio}" Width="90" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Total" Binding="{Binding MontoTotal, StringFormat={}{0:C2}}" Width="125" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                        </TabItem>
                        <TabItem Header="Proyectos y departamentos">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Gasto por Proyecto y Departamento" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgAnalisisProyectos" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding Proyecto}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Departamento / Área" Binding="{Binding Departamento}" Width="160" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Compras (OCs)" Binding="{Binding TotalCompras, StringFormat={}{0:C2}}" Width="120" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Salidas Almacén" Binding="{Binding TotalSalidas, StringFormat={}{0:C2}}" Width="135" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                        </TabItem>
                        <TabItem Header="Productos y precios">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="Seleccione un producto para graficarlo" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="Frecuencia de Compra por Producto" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgAnalisisProductos"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgAnalisisProductos_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="90" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto" Binding="{Binding Producto}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Frecuencia" Binding="{Binding Frecuencia}" Width="100" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cantidad" Binding="{Binding CantidadTotal}" Width="115" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Importe" Binding="{Binding ImporteTotal, StringFormat={}{0:C2}}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="210" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtBuscarProductoAnalisis"
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                PlaceholderText="Buscar producto..."
                                                                TextChanged="TxtBuscarProductoAnalisis_TextChanged" />
                                                    <ComboBox x:Name="CboProductoAnalisis"
                                                              Grid.Column="1"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="CboProductoAnalisis_SelectionChanged" />
                                                    <ComboBox x:Name="CboMetricaBarrasAnalisis"
                                                              Grid.Column="2"
                                                              SelectedIndex="0"
                                                              SelectionChanged="CboMetricaBarrasAnalisis_SelectionChanged">
                                                        <ComboBoxItem Content="Barras: Gasto ($) por Proveedor" />
                                                        <ComboBoxItem Content="Barras: Cantidad por Proveedor" />
                                                        <ComboBoxItem Content="Barras: Gasto Mensual ($)" />
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock x:Name="TxtResumenGraficaProducto"
                                                           Text="Seleccione un producto arriba para visualizar su dispersión histórica de precios unitarios y comparativa en barras."
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>

                                            <UniformGrid Columns="1">
                                                <!-- Gráfica de Dispersión: Precio Unitario vs Fecha -->
                                                <Border Margin="0,0,5,0" Padding="8" CornerRadius="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Top" Text="Dispersión: Precio Unitario (s/IVA) vs Fecha" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4" />
                                                        <Canvas x:Name="CanvasDispersionProducto"
                                                                ClipToBounds="True"
                                                                SizeChanged="CanvasGraficasProducto_SizeChanged" />
                                                    </DockPanel>
                                                </Border>

                                                <!-- Gráfica de Barras Comparativa -->
                                                <Border Margin="5,0,0,0" Padding="8" CornerRadius="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtTituloGraficaBarras" DockPanel.Dock="Top" Text="Barras: Comparativa por Proveedor" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4" />
                                                        <Canvas x:Name="CanvasBarrasProducto"
                                                                ClipToBounds="True"
                                                                SizeChanged="CanvasGraficasProducto_SizeChanged" />
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>
                                        </DockPanel>
                                    </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 5 (FASE 4): ECONOMÍA INDUSTRIAL (KRALJIC, PPV E INFLACIÓN) Y AUDITORÍA DE CUADRILLAS -->
                        <TabItem Header="Economía Industrial (Kraljic, PPV y Cuadrillas)">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                                    <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="#2563EB" BorderThickness="1,1,1,3">
                                        <StackPanel>
                                            <TextBlock Text="INSUMOS ESTRATÉGICOS / CUELLO DE BOTELLA" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="TxtKpiEconKraljicRiesgo" Text="0 artículos" FontSize="18" FontWeight="Bold" Margin="0,3,0,1" />
                                            <TextBlock x:Name="TxtKpiEconKraljicSub" Text="0 rutinarios automatizables" FontSize="10.8" Opacity="0.72" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="#10B981" BorderThickness="1,1,1,3">
                                        <StackPanel>
                                            <TextBlock Text="VARIACIÓN NETA DE PRECIO (PPV)" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="TxtKpiEconPpvNeto" Text="$0.00" FontSize="18" FontWeight="Bold" Margin="0,3,0,1" />
                                            <TextBlock x:Name="TxtKpiEconPpvSub" Text="Comparado vs. promedio histórico" FontSize="10.8" Opacity="0.72" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="#F59E0B" BorderThickness="1,1,1,3">
                                        <StackPanel>
                                            <TextBlock Text="FAMILIAS CON ALZA INFLACIONARIA" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="TxtKpiEconInflacion" Text="0 familias" FontSize="18" FontWeight="Bold" Margin="0,3,0,1" />
                                            <TextBlock x:Name="TxtKpiEconInflacionSub" Text="Variaciones >= +10% en últimas compras" FontSize="10.8" Opacity="0.72" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="#7C3AED" BorderThickness="1,1,1,3">
                                        <StackPanel>
                                            <TextBlock Text="AUDITORÍA DE CUADRILLAS Y RESGUARDO" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="TxtKpiEconAgencia" Text="0 cuadrillas" FontSize="18" FontWeight="Bold" Margin="0,3,0,1" />
                                            <TextBlock x:Name="TxtKpiEconAgenciaSub" Text="0 herramientas activas | 0 incidencias" FontSize="10.8" Opacity="0.72" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TabControl x:Name="TcEconomiaIndustrial" Grid.Row="1" Padding="0,4,0,0">
                                    <TabItem Header="1 · Matriz Estratégica de Kraljic">
                                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="CboFiltroCuadranteKraljic" Width="230" Margin="0,0,8,0" SelectionChanged="CboFiltroCuadranteKraljic_SelectionChanged">
                                                            <ComboBoxItem Content="Todos los cuadrantes Kraljic" IsSelected="True" />
                                                            <ComboBoxItem Content="Estratégico (Crítico)" />
                                                            <ComboBoxItem Content="Apalancado (Volumen / Competencia)" />
                                                            <ComboBoxItem Content="Cuello de Botella (Riesgo Operativo)" />
                                                            <ComboBoxItem Content="Rutinario / No Crítico" />
                                                        </ComboBox>
                                                        <ui:Button Content="Actualizar Análisis" FontSize="11.5" Padding="8,4" Click="BtnRefrescarEconomiaIndustrial_Click" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Matriz de Kraljic — Clasificación Estratégica de Insumos" FontSize="14.5" FontWeight="Bold" />
                                                        <TextBlock Text="Cruza el impacto financiero de cada insumo contra el riesgo de suministro (número de proveedores conocidos y criticidad de stock)." FontSize="11.2" Opacity="0.75" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="DgAnalisisKraljic" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="88" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Producto / Insumo" Binding="{Binding ProductoNombre}" Width="*" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Familia Genérica" Binding="{Binding Familia}" Width="145" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cuadrante Kraljic" Binding="{Binding CuadranteKraljic}" Width="195" FontWeight="SemiBold" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Gasto Acum." Binding="{Binding GastoAcumulado, StringFormat={}{0:C2}}" Width="115" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Riesgo / Provs." Binding="{Binding NivelRiesgoSuministro}" Width="125" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Mejor Precio s/IVA" Binding="{Binding MejorPrecioHistoricoSinIva, StringFormat={}{0:C2}}" Width="125" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Mejor Proveedor" Binding="{Binding MejorProveedorNombre}" Width="140" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estrategia Recomendada" Binding="{Binding EstrategiaRecomendada}" Width="260" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="2 · Variación de Precio (PPV) e Inflación por Familia">
                                        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
