                                                            </StackPanel>
                                                            <StackPanel Margin="3,0,0,0" VerticalAlignment="Bottom">
                                                                <TextBlock Text="Estado de Vigencia" FontSize="10" Opacity="0.75" Margin="0,0,0,2" />
                                                                <TextBlock x:Name="TxtEstadoVigenciaCard3" Text="Sin cotizar" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,4" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <ui:TextBox x:Name="TxtCompNotas3" Margin="0,0,0,8" PlaceholderText="Ej. Marca original..." TextChanged="TxtCompExtras_TextChanged" />

                                                        <Border Padding="8" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,0,8">
                                                            <TextBlock x:Name="TxtResumenProv3" Text="Subtotal: $0.00&#x0a;Total c/IVA: $0.00" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap" />
