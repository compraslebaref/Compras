                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Nombre Comercial" Binding="{Binding NombreMostrar}" Width="180" FontWeight="SemiBold" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Razón Social" Binding="{Binding RazonSocial}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Contacto" Binding="{Binding Contacto}" Width="125" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Teléfono" Binding="{Binding Telefono}" Width="105" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Condiciones" Binding="{Binding CondicionesPago}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                    <TabItem Header="Historial del proveedor">
                                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <ui:Button x:Name="BtnAsociarLineaAbiertaDirProv" DockPanel.Dock="Right" Content="Asociar Línea Abierta a SKU" FontSize="10.8" Padding="8,3" Margin="8,0,0,0" ToolTip="Selecciona una cotización de Línea Abierta de la tabla para asociarla o convertirla en un SKU del Catálogo" Click="BtnAsociarLineaAbiertaDirProv_Click" />
                                                <TextBlock x:Name="TxtDesgloseProveedorTitulo" Text="Desglose y Cotizaciones del Proveedor" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <DataGrid x:Name="DgDesgloseProveedor" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio / UUID" Binding="{Binding Folio}" Width="150" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Detalle / Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus" Binding="{Binding Estatus}" Width="135" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoProveedor_Click" />
                                            <TextBlock Text="Datos del Proveedor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="RFC" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvRfc" PlaceholderText="Ej. FIE920315AB1" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Nombre Comercial * (En Comparativa)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvComercial" PlaceholderText="Ej. FerreIndustrial" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Razón Social" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvRazon" Margin="0,0,0,6" PlaceholderText="Ej. Ferretería Industrial S.A. de C.V." />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Persona de Contacto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvContacto" PlaceholderText="Ej. Ing. Pedro Gómez" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Teléfono" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvTelefono" PlaceholderText="Ej. 55-1234-5678" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Correo Electrónico" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvCorreo" Margin="0,0,0,6" PlaceholderText="Ej. ventas@proveedor.com" />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Condiciones de Pago" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvCondiciones" PlaceholderText="Ej. Contado / Crédito 30 días" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Entrega (Días)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvDias" PlaceholderText="Ej. 3 días" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Notas / Datos Bancarios" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvNotas" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" PlaceholderText="Ej. Envío gratis en pedidos mayores a $2,500, cuenta CLABE..." />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proveedor" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProveedor_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProveedor_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 2: PROYECTOS Y CLIENTES / ÁREAS -->
                        <TabItem Header="Proyectos y Clientes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <TabControl Grid.Column="0" Margin="0,0,10,0" Padding="0,4,0,0">
                                    <TabItem Header="Proyectos">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Proyectos y Clientes / Áreas" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirProyectos"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirProyectos_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Código" Binding="{Binding Codigo}" Width="120" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proyecto" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Cliente / Área" Binding="{Binding ClienteArea}" Width="180" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus" Binding="{Binding Estatus}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                    <TabItem Header="Desglose del proyecto">
                                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesgloseProyectoTitulo" DockPanel.Dock="Top" Text="Desglose del Proyecto" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <DataGrid x:Name="DgDesgloseProyecto" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Movimiento" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Folio" Binding="{Binding Folio}" Width="125" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Responsable / Proveedor" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Estatus" Binding="{Binding Estatus}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right" Content="Nuevo" Margin="8,0,0,0" Click="BtnNuevoProyecto_Click" />
                                            <TextBlock Text="Datos del Proyecto" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="Código del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyCodigo" Margin="0,0,0,6" PlaceholderText="Ej. PRY-2026-04" />

                                        <TextBlock Text="Nombre del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyNombre" Margin="0,0,0,6" PlaceholderText="Ej. Celda de Ensamble Línea 3" />

                                        <TextBlock Text="Cliente o Área Asignada" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyArea" Margin="0,0,0,6" PlaceholderText="Ej. Planta Norte / Cliente Automotriz" />

                                        <TextBlock Text="Estatus" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CboProyEstatus" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Activo" />
                                            <ComboBoxItem Content="Pausado" />
                                            <ComboBoxItem Content="Cerrado" />
                                        </ComboBox>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proyecto" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProyecto_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProyecto_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 3: PERSONAL (GERENTES / SOLICITANTES) Y DEPARTAMENTOS -->
                        <TabItem Header="Personal y Departamentos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <TabControl Grid.Column="0" Margin="0,0,10,0" Padding="0,4,0,0">
                                    <TabItem Header="Personal y departamentos">
                                    <Border Margin="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <ui:Button DockPanel.Dock="Right" Content="Configurar Gmail y Ver Bitácora de Correos" FontSize="11" Padding="10,4" Click="BtnAbrirConfigNotificacionesCorreo_Click" />
