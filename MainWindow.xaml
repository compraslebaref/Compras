<ui:FluentWindow x:Class="SistemaComprasAlmacen.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Lebaref | Departamento de Compras"
                 Width="1440"
                 Height="900"
                 MinWidth="1180"
                 MinHeight="740"
                 WindowStartupLocation="CenterScreen"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título limpia -->
        <ui:TitleBar Grid.Row="0"
                     Title="Lebaref | Departamento de Compras"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- Barra Superior Compacta del Escáner -->
        <Border Grid.Row="1"
                Margin="14,2,14,8"
                Padding="12,8"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="BarcodeScanner24"
                               FontSize="20"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="#0078D4" />

                <ui:TextBox x:Name="TxtOmniScanner"
                            Grid.Column="1"
                            PlaceholderText="Escanear código o folio (F2)..."
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            FontFamily="Consolas"
                            KeyDown="TxtOmniScanner_KeyDown" />

                <ui:Button Grid.Column="2"
                           Margin="8,0,0,0"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}"
                           Content="Buscar"
                           Click="BtnProcesarOmniScanner_Click" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <ui:Button Content="Códigos"
                               Icon="{ui:SymbolIcon Print24}"
                               ToolTip="Imprimir catálogo de códigos de barras en hoja Carta"
                               Margin="0,0,8,0"
                               Click="BtnImprimirCatalogoCodigos_Click" />
                    <ui:Button Content="Tema"
                               Icon="{ui:SymbolIcon WeatherMoon24}"
                               ToolTip="Alternar tema claro u oscuro"
                               Click="BtnCambiarTema_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú Lateral Limpio -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="8,10"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <ui:Button x:Name="NavDashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Appearance="Primary" Icon="{ui:SymbolIcon Home24}" Content="Inicio" Click="NavButton_Click" Tag="0" />
                        <ui:Button x:Name="NavCatalogo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon Grid24}" Content="Catálogo" Click="NavButton_Click" Tag="1" />
                        <ui:Button x:Name="NavSolicitudes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon ClipboardTaskListLtr24}" Content="Solicitudes" Click="NavButton_Click" Tag="2" />
                        <ui:Button x:Name="NavComparativa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon Scales24}" Content="Comparativa" Click="NavButton_Click" Tag="3" />
                        <ui:Button x:Name="NavOrdenes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon DocumentText24}" Content="Órdenes de Compra" Click="NavButton_Click" Tag="4" />
                        <ui:Button x:Name="NavAlmacenPos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon Box24}" Content="Almacén" Click="NavButton_Click" Tag="5" />
                        <ui:Button x:Name="NavFacturasXml" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon ReceiptMoney24}" Content="Facturas" Click="NavButton_Click" Tag="6" />
                        <ui:Button x:Name="NavAnalisis" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon DataTrending24}" Content="Análisis" Click="NavButton_Click" Tag="7" />
                        <ui:Button x:Name="NavDirectorios" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="12,10" Icon="{ui:SymbolIcon Settings24}" Content="Directorios" Click="NavButton_Click" Tag="8" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom"
                            CornerRadius="6"
                            Padding="10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatusCarrito"
                                       Text="Carrito: 0 artículos"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock x:Name="TxtUltimoEscaneo"
                                       Text="Escáner listo"
                                       FontSize="11"
                                       Opacity="0.7"
                                       Margin="0,2,0,8"
                                       TextWrapping="Wrap" />
                            <ui:Button Content="Respaldar Datos"
                                       Icon="{ui:SymbolIcon Database24}"
                                       HorizontalAlignment="Stretch"
                                       FontSize="11.5"
                                       Click="BtnRespaldarDb_Click" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Contenedor de Vistas -->
            <TabControl x:Name="MainTabControl"
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ==================== TAB 0: INICIO ==================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Resumen General" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                            <UniformGrid Columns="5" Margin="0,0,0,16">
                                <Border Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Solicitudes Pendientes" FontSize="12" Opacity="0.75" />
                                        <TextBlock x:Name="KpiSolicitudes" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0078D4" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="4,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Órdenes Abiertas" FontSize="12" Opacity="0.75" />
                                        <TextBlock x:Name="KpiOcsAbiertas" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D83B01" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="4,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Stock Mínimo" FontSize="12" Opacity="0.75" />
                                        <TextBlock x:Name="KpiStockBajo" Text="0" FontSize="26" FontWeight="Bold" Foreground="#C50F1F" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="4,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Herramientas Prestadas" FontSize="12" Opacity="0.75" />
                                        <TextBlock x:Name="KpiHerramientasPrestadas" Text="0" FontSize="26" FontWeight="Bold" Foreground="#5C2D91" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="4,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Compras Totales" FontSize="12" Opacity="0.75" />
                                        <TextBlock x:Name="KpiGastoTotal" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#107C10" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Órdenes Pendientes" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            <ui:Button Content="Ver Órdenes" HorizontalAlignment="Right" Click="BtnIrRecepciones_Click" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgDashboardOcs" AutoGenerateColumns="False" IsReadOnly="True" Height="250" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="115" />
                                                <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                                <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="150" />
                                                <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="135" />
                                                <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="95" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Alertas de Inventario" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            <ui:Button Content="Ir a Almacén" HorizontalAlignment="Right" Click="BtnIrAlmacenPos_Click" />
                                        </DockPanel>
                                        <DataGrid x:Name="DgDashboardAlertas" AutoGenerateColumns="False" IsReadOnly="True" Height="250" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="95" />
                                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                                                <DataGridTextColumn Header="Actual" Binding="{Binding StockActual}" Width="80" />
                                                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="75" />
                                                <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadAlmacen}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== TAB 1: CATÁLOGO ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: Catálogo Visual -->
                        <DockPanel Grid.Column="0" Margin="0,0,12,0">
                            <Border DockPanel.Dock="Top" Padding="12" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtBuscarCatalogo"
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                PlaceholderText="Buscar producto o código..."
                                                VerticalContentAlignment="Center"
                                                TextChanged="TxtBuscarCatalogo_TextChanged" />
                                    <ComboBox x:Name="CboFiltroCategoria"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              SelectionChanged="CboFiltroCategoria_SelectionChanged" />
                                    <ui:Button Grid.Column="2"
                                               Margin="0,0,6,0"
                                               Content="A Solicitud"
                                               Appearance="Primary"
                                               Click="BtnEnviarCarritoASolicitud_Click" />
                                    <ui:Button Grid.Column="3"
                                               Content="A Salida"
                                               Click="BtnEnviarCarritoASalida_Click" />
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IcCatalogoVisual">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="242"
                                                    Margin="0,0,10,10"
                                                    Padding="12"
                                                    CornerRadius="10"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="CardProductoCatalogo_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EDF5FF" />
                                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                                                <Setter Property="TextElement.Foreground" Value="#002B5C" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                                                <Setter Property="Background" Value="#CBE4FF" />
                                                                <Setter Property="BorderBrush" Value="#0078D4" />
                                                                <Setter Property="BorderThickness" Value="2.5" />
                                                                <Setter Property="TextElement.Foreground" Value="#002B5C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Height="135"
                                                            CornerRadius="8"
                                                            Background="White"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Box24" FontSize="38" Foreground="#0078D4" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding CategoriaNombre}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Image Source="{Binding ImagenRuta}" Stretch="Uniform" Margin="4" />
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#0F172A">
                                                                <TextBlock Text="{Binding CodigoInterno}" Foreground="White" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}" />
                                                    <TextBlock Text="{Binding ConversionTexto}" FontSize="11" Opacity="0.72" Margin="0,2,0,4" />

                                                    <Grid Margin="0,2,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Existencia" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0078D4">
                                                                <Run Text="{Binding StockActual, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                                                <Run Text="{Binding UnidadAlmacen, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="Costo" FontSize="10.5" Opacity="0.7" />
                                                            <TextBlock Text="{Binding UltimoCostoCompra, StringFormat={}{0:C2}}" FontSize="13" FontWeight="Bold" Foreground="#107C10" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:Button Grid.Column="0"
                                                                   HorizontalAlignment="Stretch"
                                                                   Appearance="Primary"
                                                                   Content="Agregar"
                                                                   Tag="{Binding}"
                                                                   Click="BtnAgregarProductoCarrito_Click" />
                                                        <ui:Button Grid.Column="1"
                                                                   Margin="6,0,0,0"
                                                                   Icon="{ui:SymbolIcon Edit24}"
                                                                   ToolTip="Editar producto"
                                                                   Tag="{Binding}"
                                                                   Click="BtnEditarProductoCatalogo_Click" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Derecha: Detalle del Producto -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Detalle del Producto" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                        <ui:Button Content="Nuevo" HorizontalAlignment="Right" Click="BtnNuevoProducto_Click" />
                                    </DockPanel>

                                    <Border Height="115" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Sin imagen (Ctrl+V para pegar)" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="ImgPreviewProducto" Stretch="Uniform" Margin="4" />
                                        </Grid>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <ui:Button Content="Pegar Imagen" Margin="0,0,4,0" Click="BtnPegarImagenPortapapeles_Click" />
                                        <ui:Button Content="Subir Archivo" Margin="4,0,0,0" Click="BtnSubirImagenArchivo_Click" />
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Código Interno" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoInterno" FontFamily="Consolas" PlaceholderText="Ej. PRD-0011" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Código de Barras" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCodigoBarras" FontFamily="Consolas" PlaceholderText="Ej. 750100010001" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Nombre del Producto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtProdNombre" Margin="0,0,0,6" PlaceholderText="Ej. Tornillo Hexagonal Inox 1/4 x 1 pulg" />

                                    <TextBlock Text="Categoría" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CboProdCategoria" Margin="0,0,0,6" />

                                    <Border Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Unidades y Conversión (Mayoreo a Menudeo)" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="85" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Unidad Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdUnidadCompra" Text="Caja (100 pzas)" PlaceholderText="Ej. Caja, Rollo" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Unidad Entrega" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdUnidadAlmacen" Text="Pieza" PlaceholderText="Ej. Pieza, Metro" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Piezas x Compra" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtProdFactor" Text="100" PlaceholderText="Ej. 100" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Existencia Actual" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdStock" Text="0" PlaceholderText="Ej. 0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock Text="Stock Mínimo" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdStockMin" Text="5" PlaceholderText="Ej. 5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Costo ($ c/IVA)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdCosto" Text="0.00" PlaceholderText="Ej. 290.00" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Ubicación en Almacén" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ui:TextBox x:Name="TxtProdUbicacion" Text="A-01" PlaceholderText="Ej. Estante A-01" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkProdEsHerramienta" Grid.Column="1" Content="Herramienta" VerticalAlignment="Bottom" Margin="10,0,0,4" />
                                    </Grid>

                                    <Image x:Name="ImgBarcodeProductoEditor" Height="44" Stretch="Fill" Margin="0,2,0,8" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   Content="Guardar Producto"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Click="BtnGuardarProducto_Click" />
                                        <ui:Button Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   Content="Eliminar"
                                                   Click="BtnEliminarProducto_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 2: SOLICITUDES ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: Nueva Solicitud -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Nueva Solicitud" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Departamento que Solicita" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolDepartamento" SelectionChanged="CboSolDepartamento_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,6,0">
                                            <TextBlock Text="Solicitante / Encargado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolEncargado" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Text="Proyecto Destino" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSolProyecto" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Captura Rápida -->
                                    <Border Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Captura Rápida (WhatsApp / Plantilla)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Content="Exportar Plantilla" FontSize="11" Margin="0,0,6,0" Click="BtnExportarPlantillaSolicitud_Click" />
                                                    <ui:Button Content="Importar" FontSize="11" Click="BtnImportarPlantillaSolicitud_Click" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox x:Name="TxtWhatsappInput"
                                                            Grid.Column="0"
                                                            Height="48"
                                                            TextWrapping="Wrap"
                                                            AcceptsReturn="True"
                                                            PlaceholderText="Pegue aquí el texto de WhatsApp (ej. 5 Tornillo 1/4, 2 Cable calibre 12)..." />
                                                <ui:Button Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           Content="Interpretar"
                                                           Click="BtnInterpretarWhatsapp_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Agregar partida manual -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CboSolProductoAgregar" Grid.Column="0" Margin="0,0,6,0" />
                                        <ui:TextBox x:Name="TxtSolCantidadAgregar" Grid.Column="1" Text="1" PlaceholderText="Cantidad" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="Agregar Partida" Click="BtnAgregarPartidaSolicitud_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock Text="Notas o Justificación de la Solicitud" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtSolNotas" Margin="0,0,0,8" PlaceholderText="Ej. Material requerido para armado de gabinete eléctrico..." />
                                    <UniformGrid Columns="2">
                                        <ui:Button Content="Limpiar" Margin="0,0,6,0" Click="BtnLimpiarPartidasSolicitud_Click" />
                                        <ui:Button Content="Guardar Solicitud" Appearance="Primary" Click="BtnGuardarSolicitud_Click" />
                                    </UniformGrid>
                                </StackPanel>

                                <DataGrid x:Name="DgPartidasNuevaSolicitud" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="115" />
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadSolicitada}" Width="90" />
                                        <DataGridTextColumn Header="Existencia" Binding="{Binding StockActualAlmacen}" IsReadOnly="True" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Derecha: Solicitudes Registradas -->
                        <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Solicitudes Registradas" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                                <ui:Button DockPanel.Dock="Bottom"
                                           Margin="0,8,0,0"
                                           Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           Content="Abrir en Comparativa"
                                           Click="BtnEnviarSolicitudAComparativa_Click" />

                                <DataGrid x:Name="DgHistorialSolicitudes" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="115" />
                                        <DataGridTextColumn Header="Departamento" Binding="{Binding DepartamentoNombre}" Width="125" />
                                        <DataGridTextColumn Header="Solicitante" Binding="{Binding EncargadoNombre}" Width="130" />
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="*" />
                                        <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="80" />
                                        <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="105" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 3: COMPARATIVA ==================== -->
                <TabItem>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Solicitud a Cotizar" FontWeight="Bold" FontSize="12" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CboCompSolicitud" SelectionChanged="CboCompSolicitud_SelectionChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCompInfoSolicitud" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="2"
                                               Content="Seleccionar Mejor Precio"
                                               Click="BtnSeleccionarMejorPrecioPorPartida_Click" />
                                </Grid>

                                <UniformGrid Columns="3">
                                    <Border Margin="0,0,6,0" Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Proveedor 1" FontWeight="Bold" FontSize="12" Foreground="#0078D4" />
                                            <ComboBox x:Name="CboCompProv1" Margin="0,4,0,6" SelectionChanged="CboCompProveedores_SelectionChanged" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompFlete1" Text="0.00" PlaceholderText="0.00" TextChanged="TxtCompTotales_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompDias1" Text="2" PlaceholderText="Días" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="TxtResumenProv1" Text="Subtotal: $0.00 | Total: $0.00" FontWeight="Bold" FontSize="11.5" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="3,0,3,0" Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Proveedor 2" FontWeight="Bold" FontSize="12" Foreground="#498205" />
                                            <ComboBox x:Name="CboCompProv2" Margin="0,4,0,6" SelectionChanged="CboCompProveedores_SelectionChanged" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompFlete2" Text="150.00" PlaceholderText="0.00" TextChanged="TxtCompTotales_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompDias2" Text="4" PlaceholderText="Días" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="TxtResumenProv2" Text="Subtotal: $0.00 | Total: $0.00" FontWeight="Bold" FontSize="11.5" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="6,0,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Proveedor 3" FontWeight="Bold" FontSize="12" Foreground="#881798" />
                                            <ComboBox x:Name="CboCompProv3" Margin="0,4,0,6" SelectionChanged="CboCompProveedores_SelectionChanged" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Envío ($ c/IVA)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompFlete3" Text="0.00" PlaceholderText="0.00" TextChanged="TxtCompTotales_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Entrega (Días)" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                    <ui:TextBox x:Name="TxtCompDias3" Text="1" PlaceholderText="Días" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="TxtResumenProv3" Text="Subtotal: $0.00 | Total: $0.00" FontWeight="Bold" FontSize="11.5" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Padding="12" CornerRadius="8" Margin="0,10,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Recalcular" Margin="0,0,8,0" Click="BtnRecalcularComparativa_Click" />
                                <ui:Button Content="Generar Órdenes de Compra" Appearance="Primary" Click="BtnGenerarOrdenesDesdeComparativa_Click" />
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="DgComparativa"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CellEditEnding="DgComparativa_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="85" />
                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="105" />
                                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="65" />

                                <DataGridTextColumn Header="P1 Subtotal" Binding="{Binding PrecioSinIva1, StringFormat={}{0:F2}}" Width="105" />
                                <DataGridTextColumn Header="P1 Total c/IVA" Binding="{Binding TotalConIva1, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105" />

                                <DataGridTextColumn Header="P2 Subtotal" Binding="{Binding PrecioSinIva2, StringFormat={}{0:F2}}" Width="105" />
                                <DataGridTextColumn Header="P2 Total c/IVA" Binding="{Binding TotalConIva2, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105" />

                                <DataGridTextColumn Header="P3 Subtotal" Binding="{Binding PrecioSinIva3, StringFormat={}{0:F2}}" Width="105" />
                                <DataGridTextColumn Header="P3 Total c/IVA" Binding="{Binding TotalConIva3, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105" />

                                <DataGridTextColumn Header="Ganador (1-3)" Binding="{Binding ProveedorGanadorIndice}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ==================== TAB 4: ÓRDENES DE COMPRA ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- Órdenes de Compra -->
                            <Border Grid.Column="0" Margin="0,0,10,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Órdenes de Compra" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ui:Button Content="Imprimir OC" Icon="{ui:SymbolIcon Print24}" HorizontalAlignment="Right" Click="BtnImprimirOcSeleccionada_Click" />
                                    </DockPanel>

                                    <DataGrid x:Name="DgOrdenesCompra"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionChanged="DgOrdenesCompra_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="115" />
                                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                                            <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="135" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="95" />
                                            <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="135" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Recepción de Mercancía -->
                            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock x:Name="TxtTituloRecepcionOc" DockPanel.Dock="Top" Text="Recepción de Mercancía" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <TextBlock Text="Observaciones de Recepción" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtNotasRecepcionOc" Margin="0,0,0,8" PlaceholderText="Ej. Entrega parcial recibida sin daños, pendiente resto de cajas..." />
                                        <ui:Button Content="Registrar Recepción"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Click="BtnRegistrarRecepcionOc_Click" />
                                    </StackPanel>

                                    <DataGrid x:Name="DgPartidasRecepcionOc" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="80" />
                                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadCompra}" IsReadOnly="True" Width="105" />
                                            <DataGridTextColumn Header="Pedida" Binding="{Binding CantidadPedida}" IsReadOnly="True" Width="62" />
                                            <DataGridTextColumn Header="Recibida" Binding="{Binding CantidadRecibida}" IsReadOnly="True" Width="75" />
                                            <DataGridTextColumn Header="Pendiente" Binding="{Binding CantidadPendiente}" IsReadOnly="True" Width="75" />
                                            <DataGridTextColumn Header="Recibir Hoy" Binding="{Binding CantidadRecibirAhora}" Width="85" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Historial de Entradas -->
                        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="Historial de Entradas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    <ui:Button Content="Imprimir Entrada" Icon="{ui:SymbolIcon Print24}" HorizontalAlignment="Right" Click="BtnImprimirEntradaSeleccionada_Click" />
                                </DockPanel>
                                <DataGrid x:Name="DgEntradasHistorial" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                        <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="120" />
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="190" />
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding ProyectoNombre}" Width="210" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEntrada}" Width="155" />
                                        <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 5: ALMACÉN ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: Salida de Material -->
                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Salida de Material" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Departamento" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSalDepartamento" SelectionChanged="CboSalDepartamento_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock Text="Persona que Recibe" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSalEncargado" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Proyecto Destino" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboSalProyecto" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CboSalProductoPos" Grid.Column="0" Margin="0,0,6,0" />
                                        <ui:TextBox x:Name="TxtSalCantidadPos" Grid.Column="1" Text="1" PlaceholderText="Cant." Margin="0,0,6,0" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="Agregar" Click="BtnAgregarPartidaSalidaPos_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock Text="Observaciones de Salida" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="TxtSalNotas" Margin="0,0,0,8" PlaceholderText="Ej. Entrega para instalación eléctrica en planta..." />
                                    <UniformGrid Columns="2">
                                        <ui:Button Content="Limpiar" Margin="0,0,6,0" Click="BtnLimpiarSalidaPos_Click" />
                                        <ui:Button Content="Registrar Salida" Appearance="Primary" Click="BtnRegistrarSalidaAlmacen_Click" />
                                    </UniformGrid>
                                </StackPanel>

                                <DataGrid x:Name="DgPartidasSalidaPos" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" IsReadOnly="True" Width="85" />
                                        <DataGridTextColumn Header="Material" Binding="{Binding ProductoNombre}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadEntregada}" Width="95" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadAlmacen}" IsReadOnly="True" Width="75" />
                                        <DataGridTextColumn Header="Importe" Binding="{Binding ImporteCosto, StringFormat={}{0:C2}}" IsReadOnly="True" Width="85" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Derecha: Préstamo de Herramienta -->
                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Préstamo de Herramienta" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ui:Button Content="Nueva Herramienta" HorizontalAlignment="Right" Click="BtnNuevaHerramientaIndividual_Click" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CboHerramientaDisponible" Grid.Column="0" Margin="0,0,6,0" />
                                        <ui:Button Grid.Column="1" Appearance="Primary" Content="Registrar Préstamo" Click="BtnPrestarHerramienta_Click" />
                                    </Grid>
                                </StackPanel>

                                <!-- Devolución -->
                                <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="6" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Devolución de Herramienta" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CboEstadoRetornoHerramienta" Grid.Column="0" SelectedIndex="0" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Bueno" />
                                                <ComboBoxItem Content="Dañado" />
                                                <ComboBoxItem Content="Extraviado" />
                                            </ComboBox>
                                            <ui:TextBox x:Name="TxtObsRetornoHerramienta" Grid.Column="1" Margin="0,0,6,0" PlaceholderText="Observaciones al devolver..." />
                                            <ui:Button Grid.Column="2" Content="Registrar Devolución" Appearance="Primary" Margin="0,0,6,0" Click="BtnRegistrarDevolucionHerramienta_Click" />
                                            <ui:Button Grid.Column="3" Content="Imprimir" Click="BtnReimprimirValePrestamo_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="DgPrestamosHerramientas" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folio" Binding="{Binding FolioVale}" Width="105" />
                                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoIndividual}" Width="85" />
                                        <DataGridTextColumn Header="Herramienta" Binding="{Binding HerramientaDescripcion}" Width="*" />
                                        <DataGridTextColumn Header="Responsable" Binding="{Binding EncargadoNombre}" Width="125" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDevolucion}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 6: FACTURAS ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <!-- Barra Superior -->
                        <Border Grid.Row="0" Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Facturas" FontSize="16" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtXmlResumenActual" Text="Seleccione un archivo XML para cargar sus conceptos." FontSize="12" Opacity="0.78" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="Orden de Compra" FontSize="11" />
                                    <ComboBox x:Name="CboXmlOrdenCompra" />
                                </StackPanel>

                                <ui:Button Grid.Column="2" Margin="0,0,8,0" Content="Subir XML" Click="BtnSubirArchivoXml_Click" />
                                <ui:Button Grid.Column="3" Margin="0,0,8,0" Content="XML Demo" Click="BtnCargarXmlDemo_Click" />
                                <ui:Button Grid.Column="4" Appearance="Primary" Content="Guardar Factura" Click="BtnGuardarFacturaXml_Click" />
                            </Grid>
                        </Border>

                        <!-- Conceptos -->
                        <Border Grid.Row="1" Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Conceptos" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox x:Name="CboXmlVincularProducto" Width="260" Margin="0,0,6,0" ToolTip="Seleccione un producto existente del catálogo para vincularlo" />
                                        <ui:Button Content="Vincular a Existente" Margin="0,0,6,0" Click="BtnVincularConceptoXmlConProducto_Click" />
                                        <ui:Button Content="Marcar como Nuevo" Margin="0,0,6,0" ToolTip="Desvincular para que se cree como un producto nuevo en el catálogo" Click="BtnMarcarConceptoComoNuevo_Click" />
                                        <ui:Button Content="Crear Nuevos en Catálogo" Appearance="Primary" ToolTip="Crear en el catálogo los productos que aún no están registrados" Click="BtnCrearProductoDesdeConceptoXml_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid x:Name="DgXmlConceptosActual" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Clave SAT" Binding="{Binding ClaveProdServ}" Width="90" />
                                        <DataGridTextColumn Header="Identificación" Binding="{Binding NoIdentificacion}" Width="120" />
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="65" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="110" />
                                        <DataGridTextColumn Header="P. Unitario" Binding="{Binding ValorUnitario, StringFormat={}{0:C2}}" Width="105" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalConIva, StringFormat={}{0:C2}}" Width="105" />
                                        <DataGridTextColumn Header="Estatus / Producto en Catálogo" Binding="{Binding ProductoVinculadoNombre}" Width="280" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Facturas Registradas -->
                        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Facturas Registradas" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <DataGrid x:Name="DgFacturasRegistradas" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgFacturasRegistradas_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="240" />
                                        <DataGridTextColumn Header="Folio" Binding="{Binding SerieFolio}" Width="95" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTimbrado}" Width="135" />
                                        <DataGridTextColumn Header="RFC" Binding="{Binding EmisorRfc}" Width="115" />
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding EmisorNombre}" Width="*" />
                                        <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompraFolio}" Width="120" />
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="95" />
                                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva, StringFormat={}{0:C2}}" Width="85" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 7: ANÁLISIS ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Compras por Proveedor" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                    <DataGrid x:Name="DgAnalisisProveedores" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="RFC" Binding="{Binding Rfc}" Width="115" />
                                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
                                            <DataGridTextColumn Header="Órdenes" Binding="{Binding NumOrdenes}" Width="85" />
                                            <DataGridTextColumn Header="Entrega" Binding="{Binding DiasPromedio}" Width="90" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal, StringFormat={}{0:C2}}" Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Frecuencia por Producto" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                    <DataGrid x:Name="DgAnalisisProductos" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" />
                                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                                            <DataGridTextColumn Header="Frecuencia" Binding="{Binding Frecuencia}" Width="95" />
                                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadTotal}" Width="115" />
                                            <DataGridTextColumn Header="Importe" Binding="{Binding ImporteTotal, StringFormat={}{0:C2}}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Gasto por Proyecto y Departamento" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <DataGrid x:Name="DgAnalisisProyectos" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="*" />
                                        <DataGridTextColumn Header="Departamento / Área" Binding="{Binding Departamento}" Width="220" />
                                        <DataGridTextColumn Header="Compras (OCs)" Binding="{Binding TotalCompras, StringFormat={}{0:C2}}" Width="140" />
                                        <DataGridTextColumn Header="Salidas de Almacén" Binding="{Binding TotalSalidas, StringFormat={}{0:C2}}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 8: DIRECTORIOS (VER, DESGLOSAR, MODIFICAR Y ELIMINAR) ==================== -->
                <TabItem>
                    <TabControl Padding="0,8,0,0">
                        <!-- SUB-TAB 1: PROVEEDORES -->
                        <TabItem Header="Proveedores">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Proveedores Registrados" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirProveedores"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirProveedores_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="RFC" Binding="{Binding Rfc}" Width="115" />
                                                    <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}" Width="155" />
                                                    <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocial}" Width="*" />
                                                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="125" />
                                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="105" />
                                                    <DataGridTextColumn Header="Condiciones" Binding="{Binding CondicionesPago}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesgloseProveedorTitulo" DockPanel.Dock="Top" Text="Desglose del Proveedor" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDesgloseProveedor" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                                                    <DataGridTextColumn Header="Folio / UUID" Binding="{Binding Folio}" Width="150" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Detalle / Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="135" />
                                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Datos del Proveedor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            <ui:Button Content="Nuevo" HorizontalAlignment="Right" Click="BtnNuevoProveedor_Click" />
                                        </DockPanel>

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="RFC" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvRfc" PlaceholderText="Ej. FIE920315AB1" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Nombre Comercial" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvComercial" PlaceholderText="Ej. FerreIndustrial" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Razón Social" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvRazon" Margin="0,0,0,6" PlaceholderText="Ej. Ferretería Industrial S.A. de C.V." />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Persona de Contacto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvContacto" PlaceholderText="Ej. Ing. Pedro Gómez" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Teléfono" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvTelefono" PlaceholderText="Ej. 55-1234-5678" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Correo Electrónico" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvCorreo" Margin="0,0,0,6" PlaceholderText="Ej. ventas@proveedor.com" />

                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Condiciones de Pago" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvCondiciones" Text="Contado" PlaceholderText="Ej. Contado / Crédito 30 días" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Entrega (Días)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtProvDias" Text="3" PlaceholderText="Ej. 3" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Notas / Datos Bancarios" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProvNotas" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" PlaceholderText="Ej. Envío gratis en pedidos mayores a $2,500, cuenta CLABE..." />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proveedor" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProveedor_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProveedor_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 2: PROYECTOS Y CLIENTES / ÁREAS -->
                        <TabItem Header="Proyectos y Clientes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Proyectos y Clientes / Áreas" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirProyectos"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirProyectos_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                                                    <DataGridTextColumn Header="Proyecto" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn Header="Cliente / Área" Binding="{Binding ClienteArea}" Width="180" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesgloseProyectoTitulo" DockPanel.Dock="Top" Text="Desglose del Proyecto" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDesgloseProyecto" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Movimiento" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="125" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Responsable / Proveedor" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="130" />
                                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Datos del Proyecto" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                            <ui:Button Content="Nuevo" HorizontalAlignment="Right" Click="BtnNuevoProyecto_Click" />
                                        </DockPanel>

                                        <TextBlock Text="Código del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyCodigo" Margin="0,0,0,6" PlaceholderText="Ej. PRY-2026-04" />

                                        <TextBlock Text="Nombre del Proyecto" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyNombre" Margin="0,0,0,6" PlaceholderText="Ej. Celda de Ensamble Línea 3" />

                                        <TextBlock Text="Cliente o Área Asignada" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ui:TextBox x:Name="TxtProyArea" Margin="0,0,0,6" PlaceholderText="Ej. Planta Norte / Cliente Automotriz" />

                                        <TextBlock Text="Estatus" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CboProyEstatus" SelectedIndex="0" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Activo" />
                                            <ComboBoxItem Content="Pausado" />
                                            <ComboBoxItem Content="Cerrado" />
                                        </ComboBox>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Guardar Proyecto" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarProyecto_Click" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarProyecto_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 3: PERSONAL (GERENTES / SOLICITANTES) Y DEPARTAMENTOS -->
                        <TabItem Header="Personal y Departamentos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.1*" />
                                        <RowDefinition Height="0.9*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Personal / Gerentes / Solicitantes" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirPersonal"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirPersonal_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                                                    <DataGridTextColumn Header="Departamento" Binding="{Binding DepartamentoNombre}" Width="190" />
                                                    <DataGridTextColumn Header="Puesto" Binding="{Binding Puesto}" Width="180" />
                                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtDesglosePersonalTitulo" DockPanel.Dock="Top" Text="Desglose de Solicitudes, Salidas y Préstamos" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDesglosePersonal" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130" />
                                                    <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="120" />
                                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                                    <DataGridTextColumn Header="Proyecto" Binding="{Binding Detalle}" Width="*" />
                                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="125" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Datos del Personal" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    <ui:Button Content="Nuevo" HorizontalAlignment="Right" Click="BtnNuevoEncargado_Click" />
                                                </DockPanel>

                                                <TextBlock Text="Departamento Asignado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboAltaEncargadoDepto" Margin="0,0,0,6" />

                                                <TextBlock Text="Nombre Completo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtAltaEncargadoNombre" Margin="0,0,0,6" PlaceholderText="Ej. Ing. Carlos Mendoza" />

                                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Puesto / Cargo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoPuesto" PlaceholderText="Ej. Gerente Mecánico" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Teléfono / Ext." FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtAltaEncargadoTelefono" PlaceholderText="Ej. 55-1020-3040" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Personal" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarEncargado_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarEncargado_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Departamentos" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    <ui:Button Content="Nuevo" HorizontalAlignment="Right" Click="BtnNuevoDepartamento_Click" />
                                                </DockPanel>

                                                <DataGrid x:Name="DgDirDepartamentos"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          Height="145"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="DgDirDepartamentos_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" />
                                                        <DataGridTextColumn Header="Departamento" Binding="{Binding Nombre}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoCodigo" PlaceholderText="Ej. ING-MEC" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Nombre del Departamento" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDeptoNombre" PlaceholderText="Ej. Ingeniería Mecánica" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Departamento" HorizontalAlignment="Stretch" Click="BtnGuardarDepartamento_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarDepartamento_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- SUB-TAB 4: HERRAMIENTAS Y CATEGORÍAS -->
                        <TabItem Header="Herramientas y Categorías">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.25*" />
                                        <RowDefinition Height="0.75*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Inventario Individual de Herramientas" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirHerramientas"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirHerramientas_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código" Binding="{Binding CodigoIndividual}" Width="95" />
                                                    <DataGridTextColumn Header="Herramienta" Binding="{Binding ProductoNombre}" Width="*" />
                                                    <DataGridTextColumn Header="Marca / Modelo" Binding="{Binding MarcaModelo}" Width="140" />
                                                    <DataGridTextColumn Header="Núm. Serie" Binding="{Binding NumeroSerie}" Width="115" />
                                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110" />
                                                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="105" />
                                                    <DataGridTextColumn Header="En Resguardo De" Binding="{Binding EncargadoActual}" Width="135" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Categorías del Catálogo Visual" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                            <DataGrid x:Name="DgDirCategorias"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionChanged="DgDirCategorias_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                                                    <DataGridTextColumn Header="Nombre de la Categoría" Binding="{Binding Nombre}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Datos de la Herramienta" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    <ui:Button Content="Nueva" HorizontalAlignment="Right" Click="BtnNuevaHerramientaDir_Click" />
                                                </DockPanel>

                                                <TextBlock Text="Producto Base" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ComboBox x:Name="CboDirHerProducto" Margin="0,0,0,6" />

                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Código Individual" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerCodigo" FontFamily="Consolas" PlaceholderText="Ej. HER-0007" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Número de Serie" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerSerie" PlaceholderText="Ej. BOS-882910 o S/N" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="Marca / Modelo" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerMarca" Margin="0,0,0,6" PlaceholderText="Ej. Bosch GSB 16 RE" />

                                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="Estado" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="CboDirHerEstado" SelectedIndex="0">
                                                            <ComboBoxItem Content="Disponible" />
                                                            <ComboBoxItem Content="En Préstamo" />
                                                            <ComboBoxItem Content="Dañada" />
                                                            <ComboBoxItem Content="Extraviada / Baja" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Ubicación" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                        <ui:TextBox x:Name="TxtDirHerUbicacion" Text="Gabinete H-1" PlaceholderText="Ej. Gabinete H-1" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="Notas / Accesorios Incluidos" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirHerNotas" Margin="0,0,0,10" PlaceholderText="Ej. En maletín con llave de mandril..." />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Herramienta" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnGuardarHerramientaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarHerramientaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Categoría" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    <ui:Button Content="Nueva" HorizontalAlignment="Right" Click="BtnNuevaCategoriaDir_Click" />
                                                </DockPanel>

                                                <TextBlock Text="Nombre de la Categoría" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <ui:TextBox x:Name="TxtDirCatNombre" Margin="0,0,0,8" PlaceholderText="Ej. Neumática e Hidráulica" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="Guardar Categoría" HorizontalAlignment="Stretch" Click="BtnGuardarCategoriaDir_Click" />
                                                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Eliminar" Click="BtnEliminarCategoriaDir_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
