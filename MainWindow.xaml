                                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Opción" Binding="{Binding NumeroOpcion}" Width="65" IsReadOnly="True" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" IsReadOnly="True" FontWeight="SemiBold" />
                                                            <DataGridTextColumn Header="P.U. s/IVA" Binding="{Binding PrecioSinIva, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="95" FontWeight="Bold" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource CeldaRecortableStyle}" Header="P.U. c/IVA" Binding="{Binding PrecioConIva, StringFormat={}{0:C2}}" Width="95" IsReadOnly="True" />
