                                                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                  BorderThickness="1"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0">
                                                <MenuItem Header="Herramientas ▾" Padding="10,5" FontSize="11.5" FontWeight="SemiBold">
                                                    <MenuItem Header="Notificaciones por Correo a Gerentes (Gmail SMTP y Bitácora)" Click="BtnAbrirConfigNotificacionesCorreo_Click" FontWeight="SemiBold" />
                                                    <Separator />
                                                    <MenuItem Header="Auditoría de Variación de Precios (PPV) e Inflación" Click="BtnAbrirEconomiaPpv_Click" />
                                                    <MenuItem Header="Matriz Estratégica de Kraljic" Click="BtnAbrirEconomiaKraljic_Click" />
