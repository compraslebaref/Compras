                                </TabControl>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="3 &#183; Emitir &#243;rdenes">
                                <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
