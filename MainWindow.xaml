<ui:FluentWindow x:Class="SistemaComprasAlmacen.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Lebaref | Departamento de Compras"
                 Width="1440"
                 Height="900"
                 MinWidth="700"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título limpia -->
        <ui:TitleBar Grid.Row="0"
                     Title="Lebaref | Departamento de Compras"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- Barra Superior Unificada en 1 Sola Franja: Menús + Escáner Omnisciente + Mapa y Perfil -->
        <Border Grid.Row="1"
                Margin="14,2,14,8"
                Padding="10,6"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: 5 Menús Desplegables Globales -->
                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0">
                    <MenuItem Header="Almacén" Padding="7,4">
                        <MenuItem Header="Mapa Gráfico de Anaqueles (A–F y PISO)" InputGestureText="F4" Click="BtnAbrirMapaAnaqueles_Click" />
                        <MenuItem Header="Ir al Catálogo Visual de Productos" InputGestureText="F3" Click="MenuIrCatalogo_Click" />
                        <MenuItem Header="Dar de Alta Nuevo Producto en Catálogo" Click="MenuNuevoProductoCatalogo_Click" />
                        <Separator />
                        <MenuItem Header="Registrar Entrada a Almacén (Recepción OC)" Click="BtnIrRecepciones_Click" />
                        <MenuItem Header="Registrar Salida de Material (Vale de Salida)" Click="BtnIrAlmacenPos_Click" />
                        <MenuItem Header="Devolver Material Sobrante de Vale de Salida" Click="BtnDevolverMaterialSalida_Click" />
                        <MenuItem Header="Reingresar Sobrante de Obra a Stock (Sin Vale Previo)" Click="BtnReingresoSobranteObra_Click" />
                        <MenuItem Header="Ajuste Físico de Inventario / Merma (AJU)" Click="BtnAjusteInventarioMerma_Click" />
                        <Separator />
                        <MenuItem Header="Exportar Existencias Actuales de Almacén (.csv)" Click="BtnExportarExistenciasCatalogo_Click" />
                        <MenuItem Header="Imprimir Catálogo de Códigos de Barras" Click="BtnImprimirCatalogoCodigos_Click" />
                    </MenuItem>

                    <MenuItem x:Name="MenuComprasTop" Header="Compras" Padding="7,4">
                        <MenuItem Header="Nueva Solicitud de Compra" Click="MenuNuevaSolicitud_Click" />
                        <MenuItem Header="Importar Solicitud desde Plantilla Excel / Web (.csv)" Click="BtnImportarPlantillaSolicitud_Click" />
                        <MenuItem Header="Descargar Formato Estándar de Solicitud (.csv)" Click="BtnExportarPlantillaSolicitud_Click" />
                        <MenuItem Header="Exportar Existencias Actuales de Almacén (.csv)" Click="BtnExportarExistenciasCatalogo_Click" />
                        <Separator />
                        <MenuItem Header="Ir a Cuadro Comparativo de Cotizaciones" Click="MenuIrComparativa_Click" />
                        <MenuItem Header="Consultar y Emitir Órdenes de Compra" Click="BtnIrRecepciones_Click" />
                        <MenuItem Header="Importar y Consultar Facturas CFDI (XML)" Click="MenuIrFacturasXml_Click" />
                    </MenuItem>

                    <MenuItem Header="Herramientas" Padding="7,4">
                        <MenuItem Header="Maletines / Kits Operativos (KIT-xxxx) — Salida y Check-list en 1 Clic" Click="BtnAbrirGestorKitsHerramientas_Click" />
                        <MenuItem Header="Check-list Rápido de Regreso de Maletín (KIT)" Click="BtnChecklistRegresoKitRapido_Click" />
                        <Separator />
                        <MenuItem Header="Flotilla de Camionetas (VEH-xxxx) y Costo por Km (CPK)" Click="BtnAbrirFlotillaYGarantias_Click" />
                        <MenuItem Header="Garantías Vigentes y TCO de Herramientas / Equipos" Click="BtnAbrirGarantiasEquipos_Click" />
                        <Separator />
                        <MenuItem Header="Vale de Préstamo / Devolución de Herramientas" Click="BtnIrAlmacenPos_Click" />
                        <MenuItem Header="Directorio Individual de Herramientas (HER-xxxx)" Click="MenuIrDirectorioHerramientas_Click" />
                        <MenuItem Header="Consultar Herramientas por Cuadrante (Mapa A–F)" Click="BtnAbrirMapaAnaqueles_Click" />
                        <Separator />
                        <MenuItem Header="Generar e Imprimir Carta Responsiva de EPP" Click="BtnImprimirCartaResponsivaEpp_Click" />
                    </MenuItem>

                    <MenuItem x:Name="MenuReportesTop" Header="Reportes" Padding="7,4">
                        <MenuItem Header="Ranking de Materiales y Proyección de Compras" Click="MenuIrAnalisisRanking_Click" />
                        <MenuItem Header="Gráficas e Historial de Precios por Producto" Click="MenuIrAnalisisGraficas_Click" />
                        <MenuItem Header="Flotilla de Camionetas (VEH-xxxx) — Costo por Kilómetro (CPK)" Click="BtnAbrirFlotillaYGarantias_Click" />
                        <MenuItem Header="Garantías y TCO de Herramientas / Equipos (HER-xxxx)" Click="BtnAbrirGarantiasEquipos_Click" />
                        <MenuItem Header="Exportar Inventario por Cuadrante / Anaquel (CSV)" Click="BtnAbrirMapaAnaqueles_Click" />
                        <Separator />
                        <MenuItem Header="Actualizar / Refrescar Todo el Sistema" InputGestureText="F5" Click="MenuRefrescarSistema_Click" />
                    </MenuItem>

                    <MenuItem Header="Sistema" Padding="7,4">
                        <MenuItem Header="Usuarios, Sesión Activa y Bitácora Nominal" Click="BtnRolOperativo_Click" />
                        <MenuItem Header="Bandeja de Avisos y Mensajes entre Usuarios (@Usuario)" Click="BtnNotificacionesCheckpoints_Click" />
                        <Separator />
                        <MenuItem Header="Activar / Cerrar Sesión Perfil Administrador" Click="BtnPerfilAdmin_Click" />
                        <MenuItem Header="Cambiar PIN de Administrador" Click="BtnCambiarPinAdmin_Click" />
                        <MenuItem Header="Crear Respaldo Local de Base de Datos (SQLite)" Click="BtnRespaldarDb_Click" />
                        <Separator />
                        <MenuItem Header="Directorios Maestros (Proveedores, Proyectos, Personal)" Click="MenuIrDirectorios_Click" />
                    </MenuItem>
                </Menu>

                <!-- Centro: Escáner Omnisciente -->
                <Grid Grid.Column="1" Margin="4,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="BarcodeScanner24"
                                   FontSize="16"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <ui:TextBox x:Name="TxtOmniScanner"
                                Grid.Column="1"
                                PlaceholderText="Escanear folio o código (F2)"
                                VerticalContentAlignment="Center"
                                FontSize="11.5"
                                FontFamily="Consolas"
                                PreviewKeyDown="TxtOmniScanner_KeyDown"
                                TextChanged="TxtOmniScanner_TextChanged" />
                    <ui:Button Grid.Column="2"
                               Margin="5,0,0,0"
                               Padding="8,3"
                               FontSize="10.8"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Search24}"
                               Content="Buscar"
                               Click="BtnProcesarOmniScanner_Click" />
                </Grid>

                <!-- Derecha: Botones Ejecutivos (Mapa A–F, Tema Claro/Oscuro y Perfil) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnMapaTopbar" Content="Mapa A-F" 
                               FontSize="10.8"
                               Padding="7,3"
                               Margin="0,0,4,0"
                               ToolTip="Abrir Mapa Gráfico 3x3 e Inventario por Cuadrante (Atajo: F4)"
                               Click="BtnAbrirMapaAnaqueles_Click" />
                    <ui:Button x:Name="BtnNotificacionesCheckpoints" Content="Avisos (0)" FontSize="10.8" Padding="7,3" Margin="0,0,4,0" ToolTip="Ver bandeja de checkpoints, cambios de etapa y notificaciones por perfil" Click="BtnNotificacionesCheckpoints_Click" />
                    <ui:Button x:Name="BtnRolOperativo" Content="Rol: Compras" Appearance="Primary" FontSize="10.8" Padding="8,3" Margin="0,0,4,0" ToolTip="Cambiar vista operativa activa entre Compras y Almacén (en Almacén se ocultan precios e importes)" Click="BtnRolOperativo_Click" />
                </StackPanel>
                <ui:Button x:Name="BtnPerfilAdmin"
                           Grid.Column="3"
                           Content="Perfil: Estándar"
                           FontSize="10.8"
                           Padding="7,3"
                           ToolTip="Activar o cerrar sesión de Perfil Administrador (PIN por defecto: 1234)"
                           Click="BtnPerfilAdmin_Click" />
            </Grid>
        </Border>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebarNavegacion" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú Lateral Ejecutivo con Secciones, Badges en Vivo y Modo Colapsable -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="10,12"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource CardElevationShadow}">
                <DockPanel LastChildFill="False">
                    <!-- Cabecera de Identidad Corporativa + Botón Colapsar -->
                    <Border DockPanel.Dock="Top"
                            Padding="8,6"
                            Margin="0,0,0,10"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BoxMultiple24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="PnlMarcaSidebar" Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="LEBAREF" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Compras &amp; WMS" FontSize="10.5" Opacity="0.72" />
                            </StackPanel>
                            <ui:Button x:Name="BtnToggleSidebar"
                                       Grid.Column="2"
                                       Content="⟪"
                                       Padding="6,3"
                                       FontSize="11"
                                       ToolTip="Contraer o expandir menú lateral para ganar espacio en pantalla"
                                       Click="BtnToggleSidebar_Click" />
                        </Grid>
                    </Border>

                    <!-- Navegación Agrupada por Flujo de Trabajo con Contadores Dinámicos -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="LblSecGeneral" Text="OPERACIÓN GENERAL" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,2,0,4" />

                            <ui:Button x:Name="NavDashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Appearance="Primary" Icon="{ui:SymbolIcon Home24}" Content="Inicio" ToolTip="Inicio y Resumen Ejecutivo" Click="NavButton_Click" Tag="0" />

                            <Grid>
                                <ui:Button x:Name="NavCatalogo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon Grid24}" Content="Catálogo" ToolTip="Catálogo Visual, Alertas y Coordenadas 3x3 (Atajo: F3)" Click="NavButton_Click" Tag="1" />
                                <Border x:Name="BdgSidebarAlertas" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="4" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarAlertas" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#991B1B" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="LblSecCompras" Text="ABASTECIMIENTO Y COMPRAS" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,10,0,4" />

                            <Grid>
                                <ui:Button x:Name="NavSolicitudes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon ClipboardTaskListLtr24}" Content="Solicitudes" ToolTip="Solicitudes de Compra y Carritos" Click="NavButton_Click" Tag="2" />
                                <Border x:Name="BdgSidebarSolicitudes" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarSolicitudes" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavComparativa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon Scales24}" Content="Comparativa" ToolTip="Cuadro Comparativo Multiproveedor" Click="NavButton_Click" Tag="3" />

                            <Grid>
                                <ui:Button x:Name="NavOrdenes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon DocumentText24}" Content="Órdenes de Compra" ToolTip="Órdenes de Compra y Recepción de Mercancía" Click="NavButton_Click" Tag="4" />
                                <Border x:Name="BdgSidebarOcs" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="4" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarOcs" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavFacturasXml" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon ReceiptMoney24}" Content="Facturas" ToolTip="Facturas CFDI 4.0 y Notas de Compra" Click="NavButton_Click" Tag="6" />

                            <TextBlock x:Name="LblSecAlmacen" Text="BODEGA Y CONTROL" FontSize="10" FontWeight="Bold" Opacity="0.52" Margin="8,10,0,4" />

                            <Grid>
                                <ui:Button x:Name="NavAlmacenPos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon Box24}" Content="Almacén" ToolTip="Salidas de Almacén y Préstamos de Herramientas" Click="NavButton_Click" Tag="5" />
                                <Border x:Name="BdgSidebarPrestamos" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="4" Background="#F3E8FF" BorderBrush="#D8B4FE" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeSidebarPrestamos" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#6B21A8" />
                                </Border>
                            </Grid>

                            <ui:Button x:Name="NavAnalisis" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon DataTrending24}" Content="Análisis" ToolTip="Ranking de Consumo e Historial Gráfico de Precios" Click="NavButton_Click" Tag="7" />
                            <ui:Button x:Name="NavDirectorios" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon Settings24}" Content="Directorios" ToolTip="Proveedores, Proyectos, Personal y Herramientas" Click="NavButton_Click" Tag="8" />
                            <ui:Button x:Name="NavFlotilla" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Padding="9,6" FontSize="11.5" Icon="{ui:SymbolIcon VehicleTruckProfile24}" Content="Flotilla" ToolTip="Módulo de Flotilla Vehicular, Carga de Gasolina, Gastos, Check-list Semanal y Costo por Km (CPK)" Click="NavButton_Click" Tag="9" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="PnlFooterSidebar"
                            DockPanel.Dock="Bottom"
                            CornerRadius="8"
                            Padding="10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatusCarrito"
                                       Text="Solicitud: 0 artículos"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       FontSize="12" />
                            <TextBlock x:Name="TxtUltimoEscaneo"
                                       Text="Escáner listo"
                                       FontSize="11"
                                       Opacity="0.72"
                                       Margin="0,2,0,8"
                                       TextWrapping="Wrap" />
                            <ui:Button Content="Respaldar Datos"
                                       Icon="{ui:SymbolIcon Database24}"
                                       HorizontalAlignment="Stretch"
                                       FontSize="11.5"
                                       Click="BtnRespaldarDb_Click" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Contenedor de Vistas -->
            <ScrollViewer x:Name="SvContenidoPrincipal" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="SvContenidoPrincipal_SizeChanged">
            <TabControl x:Name="MainTabControl"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ==================== TAB 0: INICIO ==================== -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="Abrir Mapa de Bodega 3×3" Margin="0,0,8,0" Click="BtnAbrirMapaAnaqueles_Click" />
                                    <ui:Button Content="+ Nueva Solicitud" Appearance="Primary" Click="MenuNuevaSolicitud_Click" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Panel de Control Ejecutivo" FontSize="21" FontWeight="Bold" />
                                    <TextBlock Text="Haz clic en cualquier indicador KPI para navegar directamente al módulo correspondiente." FontSize="11.5" Opacity="0.7" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <UniformGrid x:Name="UgKpisInicio" Grid.Row="1" Columns="5" Margin="0,0,0,12">
                                <!-- KPI 1: Solicitudes Pendientes -->
                                <Border Margin="0,0,8,0" Padding="14,12" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para abrir Solicitudes de Compra pendientes"
                                        MouseLeftButtonUp="KpiCardSolicitudes_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SOLICITUDES PENDIENTES" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiSolicitudes" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,2" />
                                            <TextBlock Text="Ir a Solicitudes →" FontSize="10.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 2: Órdenes Abiertas -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#FDBA74" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para ir a Recepción de Órdenes de Compra abiertas"
                                        MouseLeftButtonUp="KpiCardOrdenes_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ÓRDENES ABIERTAS" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiOcsAbiertas" Text="0" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,2" />
                                            <TextBlock Text="Recibir Mercancía →" FontSize="10.5" Foreground="#EA580C" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="4" Background="#FFEDD5" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="DocumentText24" Foreground="#C2410C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 3: Alertas Stock Mínimo -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#FCA5A5" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para filtrar productos con Stock Mínimo mayor al Actual"
                                        MouseLeftButtonUp="KpiCardAlertas_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DÉFICIT DE STOCK" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiStockBajo" Text="0" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,2" />
                                            <TextBlock Text="Reabastecer Stock →" FontSize="10.5" Foreground="#DC2626" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="4" Background="#FEE2E2" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="Warning24" Foreground="#B91C1C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- KPI 4: Herramientas Prestadas -->
                                <Border Margin="4,0,8,0" Padding="14,12" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#D8B4FE" BorderThickness="1,1,1,3"
                                        Effect="{StaticResource CardElevationShadow}"
                                        ToolTip="Clic para gestionar préstamos y devoluciones de herramientas"
                                        MouseLeftButtonUp="KpiCardHerramientas_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="EN RESGUARDO (HER)" FontSize="10.2" FontWeight="Bold" Opacity="0.65" />
                                            <TextBlock x:Name="KpiHerramientasPrestadas" Text="0" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,2" />
                                            <TextBlock Text="Ver Préstamos →" FontSize="10.5" Foreground="#7C3AED" FontWeight="SemiBold" />
                                        </StackPanel>
